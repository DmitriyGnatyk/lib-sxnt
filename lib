        onTheme(function() btn.BackgroundColor3 = Theme.card; render() end)

        local wrap = new("CanvasGroup", {
            Name = "TabWrap", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false,
        }, contentArea)
        table.insert(W._tabWraps, wrap)
        local frame = new("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.accent, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
        }, wrap)
        new("UIPadding", {
            PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 10),
        }, frame)
        new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, frame)
        table.insert(W._tabFrames, frame)
        onTheme(function() frame.ScrollBarImageColor3 = Theme.accent end)

        btn.MouseButton1Click:Connect(function() switchTab(index, true) end)

        local tabObj = setmetatable({
            _window = W, _frame = frame, _wrap = wrap, _tabHolder = tabList, _contentArea = contentArea,
            _subTabs = {}, _activeSub = nil, _index = index,
            _C = Theme, _tw = tw, _corner = corner, _stroke = stroke, _LO = LO,
        }, Tab)
        table.insert(W._tabs, tabObj)

        if index == 1 then switchTab(1, false) end   -- перша вкладка відкривається автоматично
        return tabObj
    end

    -- ── глобальні слухачі: slider, клік поза dropdown, гаряча клавіша ──
    track(UserInputService.InputChanged:Connect(function(i)
        local s = W._sliderDragState
        if s and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            s.setValue(i.Position.X - s.track.AbsolutePosition.X, s.track.AbsoluteSize.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(i)
        local s = W._sliderDragState
        if s and isPress(i) then
            if s.scrollFrame then s.scrollFrame.ScrollingEnabled = true end
            if s.onEnd then s.onEnd() end
            W._sliderDragState = nil
        end
    end))
    track(UserInputService.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        local pop = W._popup
        if pop and not pointInGui(pop.card, inputScreenPos(input)) then pcall(pop.collapse) end
    end))

    if not IS_MOBILE then
        W._menuKey = opts.menuKey or Enum.KeyCode.F4
        track(UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == W._menuKey then
                W:Toggle()
            end
        end))
    end

    -- ── зовнішній інтерфейс (сумісність із v1) ──
    W._icon = icon
    W._hideIcon = function(v)
        if IS_MOBILE then return end
        hideIcon = v and true or false
        if not isOpen then
            if hideIcon then
                tw(iconScale, 0.2, { Scale = 0 }, ES.Back, ED.In)
                task.delay(0.2, function() if hideIcon and icon.Parent then icon.Visible = false end end)
            else
                icon.Visible = true; tw(iconScale, 0.4, { Scale = 1 }, ES.Back)
            end
        end
    end
    W._isMobile = IS_MOBILE
    W._tw = tw
    W._corner = corner
    W._stroke = stroke
    W._GetVolume = getSoundVolume
    W._SetVolume = function(v) soundVolume = v end
    W._menuKeyGetter = function() return W._menuKey end
    W._menuKeySetter = function(k) W._menuKey = k end
    W._createTab = createTab

    -- тема: живе перефарбування + (опційно) колбек для повної перебудови
    onTheme(function()
        tw(mainStroke, 0.35, { Color = Theme.border })
        tw(main, 0.35, { BackgroundColor3 = Theme.bg })
        setGrad(mainGrad, Theme.bg:Lerp(Theme.accent, 0.07), Theme.bg)
        setGrad(titleGrad, Theme.accent, Theme.accent2)
        setGrad(avatarRingGrad, Theme.accent, Theme.accent2)
        setGrad(tabIndGrad, Theme.accent, Theme.accent2)
        tw(topLine, 0.35, { BackgroundColor3 = Theme.border })
        tw(vertLine, 0.35, { BackgroundColor3 = Theme.border })
        tw(avatarInit, 0.35, { BackgroundColor3 = Theme.accent })
        tw(closeBtn, 0.2, { BackgroundColor3 = Theme.red })
        userLabel.TextColor3 = Theme.muted
        tabScroll.ScrollBarImageColor3 = Theme.accent
        for i, d in ipairs(dots) do tw(d, 0.4, { BackgroundColor3 = dotColor(i) }) end
    end)
    function W._applyTheme()
        W:_runTheme()
        if opts.onThemeRequested then pcall(opts.onThemeRequested, currentThemeName) end
    end
    function W._applyLanguage()
        local tbl = L[currentLang]
        for _, el in ipairs(W._textElements) do
            if el.type == "text" and tbl and tbl[el.key] then
                el.obj.Text = tbl[el.key]
            elseif el.type == "custom" and el.update then
                pcall(el.update)
            end
        end
        for _, data in ipairs(W._tabData) do
            data.btn.Text = data.icon .. "  " .. ((tbl and tbl[data.textKey]) or data.textKey)
        end
    end

    table.insert(Library._windows, W)
    return W
end

