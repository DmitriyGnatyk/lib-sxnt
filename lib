-- Прапори. Геттер компонента — джерело правди, тому GetFlag завжди актуальний.
function Library:GetFlag(name, default)
    local f = Flags[tostring(name)]
    if not f then return default end
    if f.get then
        local ok, v = pcall(f.get)
        if ok and v ~= nil then return v end
    end
    if f.value ~= nil then return f.value end
    return default
end
function Library:SetFlag(name, value)
    local n = tostring(name)
    local f = Flags[n]
    if not f then
        Flags[n] = { value = value }
        fireListeners(n)
        return
    end
    if f.set then pcall(f.set, value) end
    f.value = value
    fireListeners(n)
end
function Library:RegisterFlag(name, get, set, default)
    local n = tostring(name)
    Flags[n] = { get = get, set = set, default = default, value = default }
end
function Library:OnFlagChanged(name, fn)
    local n = tostring(name)
    flagListeners[n] = flagListeners[n] or {}
    table.insert(flagListeners[n], fn)
end
-- внутрішнє: користувач сам змінив значення в UI
function Library:_commit(flag, value)
    if not flag then return end
    local n = tostring(flag)
    local f = Flags[n]
    if not f then f = {}; Flags[n] = f end
    f.value = value
    fireListeners(n)
end

-- Теми
function Library:GetThemeName() return currentThemeName end
function Library:GetTheme() return Theme end
function Library:AddTheme(name, tbl)
    if type(name) ~= "string" or type(tbl) ~= "table" then return false end
    for k, v in pairs(THEMES.Ice) do if tbl[k] == nil then tbl[k] = v end end
    tbl.label = tbl.label or name
    if not THEMES[name] then table.insert(THEME_ORDER, name) end
    THEMES[name] = tbl
    return true
end
function Library:SetTheme(name, opts)
    if not THEMES[name] then return false end
    applyThemeToMirror(name)
    if opts and opts.onApplied then pcall(opts.onApplied, name) end
    for _, win in ipairs(Library._windows) do
        if win and win._applyTheme then pcall(win._applyTheme) end
    end
    return true
end

-- Мова
function Library:GetLanguage() return currentLang end
function Library:SetLanguage(code)
    if not VALID_LANGS[code] then return false end
    currentLang = code
    for _, win in ipairs(Library._windows) do
        if win and win._applyLanguage then pcall(win._applyLanguage) end
    end
    return true
end
function Library:RegisterTranslations(tbl)
    if type(tbl) ~= "table" then return end
    L = tbl
end
function Library:T(key) return T(key) end

function Library:ShowWelcome(opts) ShowWelcomeSplash(opts) end
function Library:Unload()
    for i = #Library._windows, 1, -1 do
        local w = Library._windows[i]
        if w then pcall(function() w:Destroy() end) end
    end
end

