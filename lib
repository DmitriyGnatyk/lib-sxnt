-- Компактний конструктор тем: назва, bg, card, accent, accent2, text, muted, border [, додаткові поля]
local function mkTheme(label, bg, card, accent, accent2, text, muted, border, extra)
    local function c(t) return Color3.fromRGB(t[1], t[2], t[3]) end
    local t = {
        label = label, bg = c(bg), card = c(card), accent = c(accent), accent2 = c(accent2),
        text = c(text), muted = c(muted), border = c(border),
        green = Color3.fromRGB(50, 210, 120), red = Color3.fromRGB(255, 65, 65), telegram = Color3.fromRGB(88, 101, 242),
    }
    if extra then for k, v in pairs(extra) do t[k] = v end end
    return t
end
