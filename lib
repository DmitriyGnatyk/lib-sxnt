local Library = {}
Library.Version = "4.0"
Library.Themes = THEMES
Library.ThemeOrder = THEME_ORDER
Library.Defaults = { avatar = DEFAULT_AVATAR }
Library._windows = {}
Library.BindRespectGameProcessed = false   -- true: ігнорувати клавіші, які вже «з'їла» гра (як було раніше)
Library._hud = {}   -- v4: стан HUD (позиції, видимість) — спільний для всіх вікон і конфігів

-- Прапори. Геттер компонента — джерело правди, тому GetFlag завжди актуальний.
function Library:GetFlag(name, default)
    local f = Flags[tostring(name)]
    if not f then return default end
    if f.get then
        local ok, v = pcall(f.get)
        if ok and v ~= nil then return v end
    end
    if f.value ~= nil then return f.value end
    return default
end
function Library:SetFlag(name, value)
    local n = tostring(name)
    local f = Flags[n]
    if not f then
        Flags[n] = { value = value }
        fireListeners(n)
        return
    end
    if f.set then pcall(f.set, value) end
    if f.get then   -- слухачі отримують нормалізоване значення (напр. Color3, а не "#hex")
        local ok, v = pcall(f.get)
        if ok and v ~= nil then value = v end
    end
    f.value = value
    fireListeners(n)
end
function Library:RegisterFlag(name, get, set, default)
    local n = tostring(name)
    Flags[n] = { get = get, set = set, default = default, value = default }
end
function Library:OnFlagChanged(name, fn)
    local n = tostring(name)
    flagListeners[n] = flagListeners[n] or {}
    table.insert(flagListeners[n], fn)
end
-- внутрішнє: користувач сам змінив значення в UI
function Library:_commit(flag, value)
    if not flag then return end
    local n = tostring(flag)
    local f = Flags[n]
    if not f then f = {}; Flags[n] = f end
    f.value = value
    fireListeners(n)
end

-- Теми
function Library:GetThemeName() return currentThemeName end
function Library:GetTheme() return Theme end
function Library:AddTheme(name, tbl)
    if type(name) ~= "string" or type(tbl) ~= "table" then return false end
    tbl = table.clone(tbl)
    -- cardHover / card2 / track обчислюються з card і bg, тому з Ice їх не копіюємо
    for k, v in pairs(THEMES.Ice) do
        if tbl[k] == nil and k ~= "cardHover" then tbl[k] = v end
    end
    tbl.label = tbl.label or name
    if not THEMES[name] then table.insert(THEME_ORDER, name) end
    THEMES[name] = tbl
    return true
end
function Library:SetTheme(name, opts)
    if not THEMES[name] then return false end
    applyThemeToMirror(name)
    if opts and opts.onApplied then safe(opts.onApplied, name) end
    for _, win in ipairs(table.clone(Library._windows)) do
        if win and win._applyTheme then pcall(win._applyTheme) end
    end
    return true
end

-- Шрифти
Library.Fonts = FONT_DEFS
Library.FontOrder = FONT_ORDER
function Library:GetFont() return currentFontName end
function Library:AddFont(name, regular, bold)
    if type(name) ~= "string" or typeof(regular) ~= "EnumItem" then return false end
    if not FONT_DEFS[name] then table.insert(FONT_ORDER, name) end
    FONT_DEFS[name] = { regular, (typeof(bold) == "EnumItem") and bold or regular }
    return true
end
function Library:SetFont(name)
    local def = FONT_DEFS[name]
    if not def then return false end
    currentFontName = name
    local wins = table.clone(Library._windows)
    local function swap()
        FONT, FONT_BOLD = def[1], def[2]
        for inst, role in pairs(fontRole) do
            if inst.Parent then inst.Font = (role == "b") and FONT_BOLD or FONT end
        end
        for _, w in ipairs(wins) do
            for _, h in ipairs(w._fontHooks or {}) do pcall(h, name) end
        end
    end
    -- короткий «провал» прозорості приховує перерахунок розкладки під час зміни шрифту
    local anyOpen = false
    for _, w in ipairs(wins) do
        if w.IsOpen and w:IsOpen() and w.Main and w.Main.Parent then
            anyOpen = true
            tw(w.Main, 0.14, { GroupTransparency = 0.55 })
        end
    end
    if anyOpen then
        task.delay(0.16, function()
            swap()
            for _, w in ipairs(wins) do
                if w.IsOpen and w:IsOpen() and w.Main and w.Main.Parent then tw(w.Main, 0.4, { GroupTransparency = 0 }) end
            end
        end)
    else
        swap()
    end
    return true
end

-- Мова
function Library:GetLanguage() return currentLang end
function Library:SetLanguage(code)
    if not VALID_LANGS[code] and not L[code] then return false end
    currentLang = code
    for _, win in ipairs(table.clone(Library._windows)) do
        if win and win._applyLanguage then pcall(win._applyLanguage) end
    end
    return true
end
-- v3: ДОДАЄ ключі до вбудованих (раніше повністю замінювало таблицю)
function Library:RegisterTranslations(tbl)
    if type(tbl) ~= "table" then return end
    for lang, map in pairs(tbl) do
        if type(map) == "table" then
            L[lang] = L[lang] or {}
            for k, v in pairs(map) do L[lang][k] = v end
        end
    end
end
function Library:T(key) return T(key) end

function Library:ShowWelcome(opts) ShowWelcomeSplash(opts) end
function Library:Unload()
    for i = #Library._windows, 1, -1 do
        local w = Library._windows[i]
        if w then pcall(function() w:Destroy() end) end
    end
end

