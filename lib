    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.78, 1) }, glow)

    local pHolder = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, card)
    makeParticles(pHolder, 16, function(i) return (i % 3 == 0) and Theme.accent2 or Theme.accent end)

