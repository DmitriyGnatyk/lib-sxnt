    -- зникнення
    tw(card, 0.35, { GroupTransparency = 1 }, ES.Quad, ED.In)
    tw(cardScale, 0.35, { Scale = fit * 1.08 }, ES.Quad, ED.In)
    task.delay(0.4, function()
        splashGui:Destroy()
        if opts.onComplete then pcall(opts.onComplete) end
    end)
end

