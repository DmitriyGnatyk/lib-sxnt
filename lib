local PRESET_COLORS = { "FF3B5C", "FF8A3B", "FFD23B", "4BE37B", "3BDDFF", "4B7BFF", "A35BFF", "FF5BC8", "FFFFFF", "101018" }

local function toHex(c)
    return string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function fromHex(s)
    s = tostring(s or ""):gsub("[^%x]", "")
    if #s == 3 then s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2) end
    if #s ~= 6 then return nil end
    return Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
end
-- приймає Color3, "#RRGGBB" / "RGB", або { r, g, b } (0-255)
local function parseColor(v)
    if typeof(v) == "Color3" then return v end
    if type(v) == "string" then return fromHex(v) end
    if type(v) == "table" and tonumber(v[1]) and tonumber(v[2]) and tonumber(v[3]) then
        return Color3.fromRGB(v[1], v[2], v[3])
    end
    return nil
end

-- не додаємо звук кліку до «зон перетягування»
local function hitButton(parent, props)
    local b = Instance.new("TextButton")
    b.Text = ""; b.AutoButtonColor = false; b.BackgroundTransparency = 1; b.BorderSizePixel = 0
    for k, v in pairs(props) do b[k] = v end
    b:SetAttribute("SXNT_ClickAttached", true)
    b.Parent = parent
    return b
end

-- ── модель кольору: HSV + альфа, слухачі, прапори, rainbow ──
local function newColorModel(win, opts)
    local m = { listeners = {}, a = 1, rainbow = false, live = opts.live ~= false, hasAlpha = opts.alpha == true }
    local c0 = parseColor(opts.default) or Color3.fromRGB(255, 70, 90)
    m.h, m.s, m.v = c0:ToHSV()
    if tonumber(opts.alphaDefault) then m.a = math.clamp(opts.alphaDefault, 0, 1) end
    function m.color() return Color3.fromHSV(m.h, m.s, m.v) end

    local function notify(final, src)
        for _, fn in ipairs(m.listeners) do fn(src) end
        if opts.flag then
            Library:_commit(opts.flag, m.color())
            if m.hasAlpha then Library:_commit(opts.flag .. "_alpha", m.a) end
        end
        if opts.callback and (m.live or final) then safe(opts.callback, m.color(), m.a) end
    end
    function m.setHSV(h, s, v, final, src)
        m.h, m.s, m.v = math.clamp(h, 0, 1), math.clamp(s, 0, 1), math.clamp(v, 0, 1)
        notify(final, src)
    end
    function m.setColor(c, final, src)
        local h, s, v = c:ToHSV()
        if s > 0.001 and v > 0.001 then m.h = h end     -- у сірого/чорного відтінок не визначений: лишаємо попередній
        m.s, m.v = s, v
        notify(final ~= false, src)
    end
    function m.setAlpha(a, final, src)
        m.a = math.clamp(a, 0, 1)
        notify(final, src)
    end
    function m.finish() notify(true, "finish") end   -- кінець перетягування: для live = false викликає callback

    local rbConn
    function m.setRainbow(on)
        on = on and true or false
        if on == m.rainbow then return end
        m.rainbow = on
        if rbConn then rbConn:Disconnect(); rbConn = nil end
        if on then
            m.s, m.v = math.max(m.s, 0.7), math.max(m.v, 0.85)
            local acc = 0
            rbConn = RunService.Heartbeat:Connect(function(dt)
                if win._destroyed then m.setRainbow(false); return end
                m.h = (m.h + dt * 0.12) % 1
                acc += dt
                if acc >= 0.04 then acc = 0; notify(true, "rainbow") end   -- ~25 оновлень/с достатньо
            end)
        end
        if opts.flag then Library:_commit(opts.flag .. "_rainbow", on) end
        notify(true, "rainbow")
    end
    return m
end

-- публічний API (спільний для картки й чипа)
local function colorApi(m, opts, extra)
    local api = {}
    function api.Get() return m.color() end
    function api.GetAlpha() return m.a end
    function api.GetHex() return "#" .. toHex(m.color()) end
    function api.GetHSV() return m.h, m.s, m.v end
    function api.Set(_, c, a)
        c = parseColor(c)
        if not c then return end
        if a ~= nil then m.a = math.clamp(a, 0, 1) end
        m.setColor(c, true, "api")
    end
    function api.SetAlpha(_, a) m.setAlpha(a, true, "api") end
    function api.SetRainbow(_, on) m.setRainbow(on) end
    function api.IsRainbow() return m.rainbow end
    if extra then for k, v in pairs(extra) do api[k] = v end end
    return api
end

local function registerColorFlags(m, opts)
    local flag = opts.flag
    if not flag then return end
    Library:RegisterFlag(flag, function() return m.color() end, function(v)
        local c = parseColor(v)
        if c then m.setColor(c, true, "flag") end
    end, m.color())
    if m.hasAlpha then
        Library:RegisterFlag(flag .. "_alpha", function() return m.a end, function(v)
            if tonumber(v) then m.setAlpha(tonumber(v), true, "flag") end
        end, m.a)
    end
    if opts.rainbow then
        Library:RegisterFlag(flag .. "_rainbow", function() return m.rainbow end, function(v) m.setRainbow(v == true) end, false)
    end
end

function ColorUI.panelHeight(m, o)
    local y = m.hasAlpha and 152 or 132
    return (o.presets == false) and (y + 26) or (y + 52)
end

-- панель вибору кольору (SV-квадрат, відтінок, прозорість, HEX, rainbow, пресети)
function ColorUI.buildPanel(win, parent, m, o)
    o = o or {}
    local mark = o.mark or function() end
    local H = ColorUI.panelHeight(m, o)
    local body = new("Frame", { Name = "ColorPanel", Size = UDim2.new(1, 0, 0, H), BackgroundTransparency = 1 }, parent)

    -- насиченість / яскравість
    local sv = new("Frame", { Size = UDim2.new(1, 0, 0, 104), BackgroundColor3 = Color3.fromHSV(m.h, 1, 1), BorderSizePixel = 0 }, body)
    corner(sv, 8)
    local white = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, sv)
    corner(white, 8)
    new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
    local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0 }, sv)
    corner(black, 8)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
    local svStroke = stroke(sv, Theme.border, 1)
    local svCursor = new("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(m.s, 0, 1 - m.v, 0),
        BackgroundColor3 = m.color(), BorderSizePixel = 0, ZIndex = 5,
    }, sv)
    corner(svCursor, 999); stroke(svCursor, WHITE, 2)
    local svHit = hitButton(sv, { Size = UDim2.fromScale(1, 1), ZIndex = 6 })

    -- відтінок
    local hue = new("Frame", { Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, body)
    corner(hue, 6)
    local stops = {}
    for i = 0, 6 do stops[#stops + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0 or i / 6, 1, 1)) end
    new("UIGradient", { Color = ColorSequence.new(stops) }, hue)
    local hueCursor = new("Frame", {
        Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(m.h, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromHSV(m.h, 1, 1), BorderSizePixel = 0, ZIndex = 5,
    }, hue)
    corner(hueCursor, 999); stroke(hueCursor, WHITE, 2)
    local hueHit = hitButton(hue, { Size = UDim2.fromScale(1, 1), ZIndex = 6 })

    -- прозорість (необов'язково)
    local alphaBar, alphaFill, alphaCursor, alphaHit
    local nextY = 132
    if m.hasAlpha then
        alphaBar = new("Frame", { Position = UDim2.fromOffset(0, 132), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = Theme.track, BorderSizePixel = 0 }, body)
        corner(alphaBar, 6)
        alphaFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = m.color(), BorderSizePixel = 0 }, alphaBar)
        corner(alphaFill, 6)
        new("UIGradient", { Transparency = NumberSequence.new(1, 0) }, alphaFill)
        alphaCursor = new("Frame", {
            Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(m.a, 0, 0.5, 0),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 5,
        }, alphaBar)
        corner(alphaCursor, 999); stroke(alphaCursor, WHITE, 2)
        alphaHit = hitButton(alphaBar, { Size = UDim2.fromScale(1, 1), ZIndex = 6 })
        nextY = 152
    end

    -- рядок: превʼю, HEX, rainbow
    local row = new("Frame", { Position = UDim2.fromOffset(0, nextY), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, body)
    local preview = new("Frame", { Size = UDim2.fromOffset(26, 26), BackgroundColor3 = m.color(), BorderSizePixel = 0 }, row)
    corner(preview, 7)
    local prevStroke = stroke(preview, Theme.border, 1)
    local hexWrap = new("Frame", { Position = UDim2.fromOffset(32, 0), Size = UDim2.fromOffset(86, 26), BackgroundColor3 = Theme.card2, BorderSizePixel = 0 }, row)
    corner(hexWrap, 7)
    local hexStroke = stroke(hexWrap, Theme.border, 1)
    local hex = new("TextBox", {
        Text = "", PlaceholderText = "#RRGGBB", _font = "b", TextSize = 12, TextColor3 = Theme.text,
        PlaceholderColor3 = Theme.muted, ClearTextOnFocus = false, BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = CENTER,
    }, hexWrap)

    local rainbowSw, rainbowLbl
    if o.rainbow then
        local rb = hitButton(row, { Size = UDim2.fromOffset(104, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), ZIndex = 3 })
        rainbowLbl = label(rb, T("rainbow"), 11, Theme.muted, { Size = UDim2.new(1, -44, 1, 0), TextXAlignment = RIGHT })
        rainbowSw = makeSwitch(rb, true, m.rainbow)
        rainbowSw.track.Position = UDim2.new(1, 0, 0.5, 0)
        rb.MouseButton1Click:Connect(function() mark(); m.setRainbow(not m.rainbow) end)
        win._onTheme(function() rainbowLbl.TextColor3 = Theme.muted end)
        table.insert(win._textElements, { type = "custom", update = function() rainbowLbl.Text = T("rainbow") end })
    end

    -- пресети
    local presetStrokes = {}
    if o.presets ~= false then
        local list = type(o.presets) == "table" and o.presets or PRESET_COLORS
        local prow = new("Frame", { Position = UDim2.fromOffset(0, nextY + 34), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1 }, body)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
        }, prow)
        for i, v in ipairs(list) do
            local c = parseColor(v)
            if c then
                local b = hitButton(prow, { Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 0, BackgroundColor3 = c, LayoutOrder = i })
                corner(b, 999)
                presetStrokes[#presetStrokes + 1] = stroke(b, Theme.border, 1)
                b.MouseButton1Click:Connect(function() mark(); if m.rainbow then m.setRainbow(false) end; m.setColor(c, true, "preset") end)
            end
        end
    end

    -- візуальна синхронізація з моделлю
    local function refresh(src, instant)
        local c = m.color()
        local set = instant and spSnap or sp
        sv.BackgroundColor3 = Color3.fromHSV(m.h, 1, 1)
        set(svCursor, "Position", UDim2.new(m.s, 0, 1 - m.v, 0), SPRING.snap)
        svCursor.BackgroundColor3 = c
        set(hueCursor, "Position", UDim2.new(m.h, 0, 0.5, 0), SPRING.snap)
        hueCursor.BackgroundColor3 = Color3.fromHSV(m.h, 1, 1)
        if alphaFill then
            alphaFill.BackgroundColor3 = c
            set(alphaCursor, "Position", UDim2.new(m.a, 0, 0.5, 0), SPRING.snap)
        end
        preview.BackgroundColor3 = c
        if src ~= "hex" and not hex:IsFocused() then hex.Text = "#" .. toHex(c) end
        if rainbowSw then rainbowSw.value = m.rainbow; rainbowSw.render(not instant) end
    end
    m.listeners[#m.listeners + 1] = refresh
    body.Destroying:Connect(function()
        local i = table.find(m.listeners, refresh)
        if i then table.remove(m.listeners, i) end
    end)
    refresh(nil, true)

    -- перетягування: глобальний слухач вікна викликає setPos з екранними координатами
    local function startDrag(hit, setPos)
        hit.InputBegan:Connect(function(inp)
            if not isPress(inp) then return end
            mark()
            local sf = hit:FindFirstAncestorWhichIsA("ScrollingFrame")
            if sf then sf.ScrollingEnabled = false end
            win._sliderDragState = {
                track = hit, scrollFrame = sf, setPos = setPos, setValue = function() end,
                onEnd = function() m.finish() end,
            }
            setPos(inputScreenPos(inp))
        end)
    end
    startDrag(svHit, function(p)
        local a, sz = svHit.AbsolutePosition, svHit.AbsoluteSize
        if sz.X <= 0 or sz.Y <= 0 then return end
        m.setHSV(m.h, (p.X - a.X) / sz.X, 1 - (p.Y - a.Y) / sz.Y, false, "sv")
    end)
    startDrag(hueHit, function(p)
        local a, sz = hueHit.AbsolutePosition, hueHit.AbsoluteSize
        if sz.X <= 0 then return end
        if m.rainbow then m.setRainbow(false) end
        m.setHSV(math.clamp((p.X - a.X) / sz.X, 0, 0.999), m.s, m.v, false, "hue")
    end)
    if alphaHit then
        startDrag(alphaHit, function(p)
            local a, sz = alphaHit.AbsolutePosition, alphaHit.AbsoluteSize
            if sz.X <= 0 then return end
            m.setAlpha((p.X - a.X) / sz.X, false, "alpha")
        end)
    end

    hex.InputBegan:Connect(function(i) if isPress(i) then mark() end end)
    hex.Focused:Connect(function() mark(); tw(hexStroke, 0.2, { Color = Theme.accent }) end)
    hex.FocusLost:Connect(function()
        tw(hexStroke, 0.2, { Color = Theme.border })
        local c = fromHex(hex.Text)
        if c then m.setColor(c, true, "hex"); hex.Text = "#" .. toHex(m.color()) else refresh() end
    end)

    win._onTheme(function()
        tw(svStroke, 0.3, { Color = Theme.border }); tw(prevStroke, 0.3, { Color = Theme.border })
        tw(hexWrap, 0.3, { BackgroundColor3 = Theme.card2 }); tw(hexStroke, 0.3, { Color = Theme.border })
        hex.TextColor3 = Theme.text; hex.PlaceholderColor3 = Theme.muted
        if alphaBar then tw(alphaBar, 0.3, { BackgroundColor3 = Theme.track }) end
        for _, s in ipairs(presetStrokes) do tw(s, 0.3, { Color = Theme.border }) end
    end)

    return { frame = body, height = H, refresh = refresh }
end

-- ── маленький чип-вибірник у рядку (кружечок кольору → випадаюча панель) ──
-- o: { default, flag, callback, alpha, rainbow, presets, live }
function ColorUI.chip(win, container, order, o, H)
    o = o or {}
    local m = newColorModel(win, o)
    local btn = new("TextButton", {
        Text = "", Size = UDim2.fromOffset(30, H), BackgroundColor3 = m.color(), BorderSizePixel = 0,
        AutoButtonColor = false, LayoutOrder = order,
    }, container)
    corner(btn, 6)
    local btnStroke = stroke(btn, Theme.border, 1)
    m.listeners[#m.listeners + 1] = function() btn.BackgroundColor3 = m.color() end
    win._onTheme(function() tw(btnStroke, 0.3, { Color = Theme.border }) end)

    local pop, popScale, panelObj
    local isOpen = false
    local function closePop()
        if not isOpen then return end
        isOpen = false
        if win._popup and win._popup.card == pop then win._popup = nil end
        if win._currentExpanded == closePop then win._currentExpanded = nil end
        tw(pop, 0.2, { GroupTransparency = 1 })
        sp(popScale, "Scale", win._scale() * 0.95, SPRING.smooth)
        tw(btnStroke, 0.2, { Color = Theme.border })
        task.delay(0.22, function() if not isOpen and pop then pop.Visible = false end end)
    end
    local function ensure()
        if pop then return end
        local ui = win.ScreenGui
        local pad = 12
        local ph = ColorUI.panelHeight(m, o)
        pop = new("CanvasGroup", {
            Name = "ColorPopover", Size = UDim2.fromOffset(232, ph + pad * 2), BackgroundColor3 = Theme.card,
            BorderSizePixel = 0, ZIndex = 600, GroupTransparency = 1, Visible = false,
        }, ui)
        corner(pop, 12)
        local popStroke = stroke(pop, Theme.accent, 1, 0.35)
        popScale = new("UIScale", { Scale = win._scale() }, pop)
        local inner = new("Frame", {
            Position = UDim2.fromOffset(pad, pad), Size = UDim2.new(1, -pad * 2, 1, -pad * 2), BackgroundTransparency = 1,
        }, pop)
        local po = { presets = o.presets, rainbow = o.rainbow }
        po.mark = function() if win._popup and win._popup.card == pop then win._popup.insideAt = os.clock() end end
        panelObj = ColorUI.buildPanel(win, inner, m, po)
        win._onTheme(function()
            tw(pop, 0.3, { BackgroundColor3 = Theme.card }); tw(popStroke, 0.3, { Color = Theme.accent })
        end)
        win.Main:GetPropertyChangedSignal("Position"):Connect(function() if isOpen then closePop() end end)
    end
    local function openPop()
        if win._popup then pcall(win._popup.collapse) end
        if win._currentExpanded then pcall(win._currentExpanded) end
        ensure()
        local sc = win._scale()
        local vp = viewport()
        local w, h = 232 * sc, (ColorUI.panelHeight(m, o) + 24) * sc
        local a, sz = btn.AbsolutePosition, btn.AbsoluteSize
        local x = math.clamp(a.X + sz.X - w, 8, math.max(8, vp.X - w - 8))
        local y = a.Y + sz.Y + 8
        if y + h > vp.Y - 8 then y = a.Y - h - 8 end
        y = math.clamp(y, 8, math.max(8, vp.Y - h - 8))
        pop.Position = UDim2.fromOffset(x, y)
        pop.Visible = true
        spSnap(popScale, "Scale", sc * 0.95)
        panelObj.refresh(nil, true)
        isOpen = true
        win._popup = { card = pop, collapse = closePop, insideAt = os.clock() }
        win._currentExpanded = closePop
        tw(pop, 0.25, { GroupTransparency = 0 })
        sp(popScale, "Scale", sc, SPRING.pop)
        tw(btnStroke, 0.2, { Color = Theme.accent })
    end
    btn.InputBegan:Connect(function(i) if isPress(i) and win._popup then win._popup.insideAt = os.clock() end end)
    btn.MouseButton1Click:Connect(function() if isOpen then closePop() else openPop() end end)

    registerColorFlags(m, o)
    local api = colorApi(m, o, { Open = function() openPop() end, Close = function() closePop() end })
    return { model = m, api = api, button = btn }
end

-- ── стандартна картка: назва + кружечок, клік розгортає панель ──
-- opts: name, key, flag, default (Color3 / "#hex"), callback(color, alpha), alpha, rainbow, presets, live, expanded
function SubTab:AddColorPicker(opts)
    opts = opts or {}
    local win = self._window
    local m = newColorModel(win, opts)
    local HEAD = 44
    local pad = 12
    local panelH = ColorUI.panelHeight(m, opts)
    local expandedH = HEAD + 4 + panelH + 14

    local frame, frameStroke = makeHost(self._container, HEAD, false, self._LO(), false)
    frame.ClipsDescendants = true
    local header = new("TextButton", {
        Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, HEAD),
    }, frame)
    local lbl = label(header, opts.name or (opts.key and T(opts.key)) or opts.flag or "Color", 13, Theme.text, {
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -90, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)
    local swatch = new("Frame", {
        Size = UDim2.fromOffset(38, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        BackgroundColor3 = m.color(), BorderSizePixel = 0,
    }, header)
    corner(swatch, 7)
    local swStroke = stroke(swatch, Theme.border, 1)
    m.listeners[#m.listeners + 1] = function() swatch.BackgroundColor3 = m.color() end

    local holder = new("Frame", {
        Position = UDim2.fromOffset(pad, HEAD + 4), Size = UDim2.new(1, -pad * 2, 0, panelH), BackgroundTransparency = 1, Visible = false,
    }, frame)
    local panel = ColorUI.buildPanel(win, holder, m, { presets = opts.presets, rainbow = opts.rainbow })

    local expanded = false
    local collapseFn
    local function setExpanded(v, instant)
        v = v and true or false
        if v == expanded and not instant then return end
        expanded = v
        if expanded then
            if win._currentExpanded and win._currentExpanded ~= collapseFn then pcall(win._currentExpanded) end
            win._currentExpanded = collapseFn
        elseif win._currentExpanded == collapseFn then
            win._currentExpanded = nil
        end
        local target = UDim2.new(1, 0, 0, expanded and expandedH or HEAD)
        if expanded then holder.Visible = true; panel.refresh(nil, true) end
        if instant then spSnap(frame, "Size", target) else sp(frame, "Size", target, SPRING.smooth) end
        tw(swStroke, 0.2, { Color = expanded and Theme.accent or Theme.border })
        if not expanded then
            task.delay(instant and 0 or 0.55, function() if not expanded then holder.Visible = false end end)
        end
    end
    collapseFn = function() setExpanded(false) end
    local st = { hover = false, down = false }
    interact(header, st, function(a) styleHost(frame, frameStroke, false, st, a) end)
    header.MouseButton1Click:Connect(function() setExpanded(not expanded) end)
    win._onTheme(function()
        lbl.TextColor3 = Theme.text
        tw(swStroke, 0.3, { Color = expanded and Theme.accent or Theme.border })
    end)
    if opts.expanded then setExpanded(true, true) end

    registerColorFlags(m, opts)
    local api = colorApi(m, opts, {
        Host = frame,
        Expand = function() setExpanded(true) end,
        Collapse = function() setExpanded(false) end,
        IsExpanded = function() return expanded end,
    })
    registerSearch(self, frame, function() return lbl.Text end)
    return api
end

