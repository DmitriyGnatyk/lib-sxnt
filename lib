        new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 8) }, btn)
        table.insert(W._tabButtons, btn)
        table.insert(W._tabData, { btn = btn, icon = iconChar, textKey = textKey, displayText = text })

        local st = { hover = false, down = false }
        local function render()
            local active = (W._activeTab == index)
            tw(btn, 0.2, {
                TextColor3 = active and Theme.onAccent or (st.hover and Theme.text or Theme.muted),
