local Window = {}; Window.__index = Window
local Tab    = {}; Tab.__index = Tab
local SubTab = {}; SubTab.__index = SubTab
local ExpandableCard = {}; ExpandableCard.__index = ExpandableCard

local TAB_H, TAB_GAP = 36, 6

-- ─── MAIN WINDOW ────────────────────────────────────────────
function Library:CreateWindow(opts)
    opts = opts or {}
    if opts.translations then Library:RegisterTranslations(opts.translations) end
    if opts.language and (VALID_LANGS[opts.language] or L[opts.language]) then currentLang = opts.language end
    if opts.theme then
        if THEMES[opts.theme] then applyThemeToMirror(opts.theme)
        else warn("[SXNT] невідома тема: " .. tostring(opts.theme)) end
    end
    if opts.font then
        local d = FONT_DEFS[opts.font]
        if d then FONT, FONT_BOLD = d[1], d[2]; currentFontName = opts.font
        else warn("[SXNT] невідомий шрифт: " .. tostring(opts.font)) end
    end

    -- прибираємо старі вікна (і з цієї, і з попередньої загрузки скрипта)
    for i = #Library._windows, 1, -1 do
        local w = Library._windows[i]
        if w then pcall(function() w:Destroy() end) end
    end
    local gui = GetMainGui()
    local stale = gui:FindFirstChild("SXNT_Interface")
    if stale then stale:Destroy() end
    -- стара назва з версій <= 4.0: чіпаємо лише якщо це справді наш GUI (а не інтерфейс гри)
    local legacy = gui:FindFirstChild("Interface")
    if legacy and legacy:IsA("ScreenGui") and legacy:FindFirstChild("Main") and legacy:FindFirstChild("Icon") then legacy:Destroy() end

    local W = setmetatable({}, Window)
    W._connections = {}
    W._tabs = {}
    W._tabButtons = {}
    W._tabFrames = {}
    W._tabWraps = {}
    W._tabData = {}
    W._tabRenders = {}
    W._themeFns = {}
    W._activeTab = 0
    W._textElements = {}
    W._layoutCounter = 0
    W._sliderDragState = nil
    W._currentExpanded = nil
    W._popup = nil
    W._destroyed = false
    W._notifs = {}
    W._notifN = 0
    W._C = Theme
    W._searchItems = {}
    W._listening = false
    W._closeHooks = {}
    W._tabScales = {}
    W._fontHooks = {}
    W._kbAutoShow = opts.keybindList ~= false
    W._bindsOn = true

    local conns = W._connections
    local function track(c) conns[#conns + 1] = c; return c end
    W._track = track
    function W._onTheme(fn) table.insert(W._themeFns, fn) end
    function W:_runTheme()
        for _, fn in ipairs(self._themeFns) do pcall(fn) end
    end
    local onTheme = W._onTheme

    local avatarUrl = opts.avatar or DEFAULT_AVATAR
    local firstName = (LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName) or LocalPlayer.Name
    local tgUsername = "@" .. LocalPlayer.Name
    local titleText = opts.title or "SXNT"

    local ui = new("ScreenGui", {
        Name = "SXNT_Interface", ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false,
        IgnoreGuiInset = true, DisplayOrder = opts.displayOrder or 100,
    })
    ui.Parent = gui
    W.ScreenGui = ui

    local soundVolume = opts.soundVolume or 1.2
    local function getSoundVolume() return soundVolume end
    ui.DescendantAdded:Connect(function(inst) attachClickSound(inst, getSoundVolume) end)

    -- ── стан відкриття / миші ──
    local isOpen = false
    local animTok = 0
    local savedMouse = nil
    local hideIcon = false

    local function restoreMouse()
        if not isOpen then return end
        pcall(function()
            if opts.lockMouseOnClose then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            elseif savedMouse then
                UserInputService.MouseBehavior = savedMouse.Behavior
                UserInputService.MouseIconEnabled = savedMouse.Icon
            end
        end)
    end
    local function forceMouse()
        if not isOpen then return end
        pcall(function()
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if not UserInputService.MouseIconEnabled then UserInputService.MouseIconEnabled = true end
        end)
    end

    -- v4: охоронець миші підключений лише поки меню відкрите (раніше RenderStepped працював завжди)
    local guardConns
    local function stopGuard()
        if guardConns then
            for _, c in ipairs(guardConns) do c:Disconnect() end
            guardConns = nil
        end
    end
    local function startGuard()
        if guardConns then return end
        guardConns = {
            RunService.RenderStepped:Connect(forceMouse),
            UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(forceMouse),
            UserInputService:GetPropertyChangedSignal("MouseIconEnabled"):Connect(forceMouse),
        }
    end

    -- ── опційний blur фону (поки меню відкрите) ──
    local blurFx
    local blurEnabled = opts.blur == true
    local function applyBlur()
        if blurEnabled and isOpen then
            if not (blurFx and blurFx.Parent) then
                blurFx = Instance.new("BlurEffect"); blurFx.Name = "SXNT_Blur"; blurFx.Size = 0
                blurFx.Parent = game:GetService("Lighting")
            end
            tw(blurFx, 0.45, { Size = 16 }, ES.Quad)
        elseif blurFx and blurFx.Parent then
            tw(blurFx, 0.3, { Size = 0 }, ES.Quad)
        end
    end
    W._setBlur = function(v) blurEnabled = v and true or false; applyBlur() end
    W._getBlur = function() return blurEnabled end

    ui.Destroying:Connect(function()
        W._destroyed = true
        if blurFx then pcall(function() blurFx:Destroy() end) end
        stopGuard()
        restoreMouse()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        local idx = table.find(Library._windows, W)
        if idx then table.remove(Library._windows, idx) end
    end)

    -- ── розміри / позиції ──
    local winW, winH = opts.width or 500, opts.height or 360
    local function calcFit()
        local v = viewport()
        return math.min(1, (v.X * 0.98) / winW, (v.Y * 0.95) / winH)
    end
    local baseScale = calcFit()
    local center = viewport() / 2

    -- ─────────────── ІКОНКА ───────────────
    local ICON_SIZE = IS_MOBILE and 56 or 48
    local iconCenter = Vector2.new(20 + ICON_SIZE / 2, viewport().Y * 0.4 + ICON_SIZE / 2)
    local icon = new("TextButton", {
        Name = "Icon", Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(iconCenter.X, iconCenter.Y), BackgroundColor3 = Theme.accent,
        Text = "", AutoButtonColor = false, BorderSizePixel = 0,
    }, ui)
    corner(icon, 999)
    local iconStroke = stroke(icon, WHITE, 1.5, 0.35)
    local iconScale = new("UIScale", { Scale = 0 }, icon)
    label(icon, firstName:sub(1, 1):upper(), 22, WHITE, {
        _font = "b", Size = UDim2.fromScale(1, 1), TextXAlignment = CENTER,
    })
    local iconImg = new("ImageLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = avatarUrl, ZIndex = 2,
    }, icon)
    corner(iconImg, 999)
    local iconRing = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0,
    }, icon)
    corner(iconRing, 999)
    local iconRingStroke = stroke(iconRing, Theme.accent, 2.5, 0)
    local iconLoops = {
        loopTween(iconRing, 1.1, { Size = UDim2.new(1, 12, 1, 12) }),
        loopTween(iconRingStroke, 1.1, { Transparency = 0.85, Thickness = 1 }),
    }
    local function setIconLoops(on)   -- пульс іконки не потрібен, поки вона схована
        for _, t in ipairs(iconLoops) do
            pcall(function() if on then t:Play() else t:Pause() end end)
        end
    end
    onTheme(function()
        tw(icon, 0.35, { BackgroundColor3 = Theme.accent })
        tw(iconRingStroke, 0.35, { Color = Theme.accent })
    end)

    local iconState = { hover = false, down = false }
    interact(icon, iconState, function()
        if isOpen or hideIcon then return end
        sp(iconScale, "Scale", iconState.down and 0.9 or (iconState.hover and 1.1 or 1), SPRING.soft)
    end)
    task.delay(0.15, function()
        if icon.Parent and not isOpen then sp(iconScale, "Scale", 1, SPRING.pop) end
    end)

    -- ─────────────── ГОЛОВНЕ ВІКНО ───────────────
    local main = new("CanvasGroup", {
        Name = "Main", Size = UDim2.fromOffset(winW, winH), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(center.X, center.Y), BackgroundColor3 = Theme.bg,
        BorderSizePixel = 0, Visible = false, GroupTransparency = 1,
    }, ui)
    corner(main, 18)
    -- рамка з рухомим градієнтним відблиском (UIGradient на UIStroke не фарбує вміст)
    local function borderSeq()
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.accent),
            ColorSequenceKeypoint.new(0.35, Theme.border),
            ColorSequenceKeypoint.new(0.65, Theme.border),
            ColorSequenceKeypoint.new(1, Theme.accent2),
        })
    end
    local mainStroke = stroke(main, WHITE, 1.4, 0.2)
    local mainStrokeGrad = new("UIGradient", { Color = borderSeq() }, mainStroke)
    local borderSpin = spin(mainStrokeGrad, 9)
    local uiScale = new("UIScale", { Scale = baseScale }, main)
    -- ВАЖЛИВО: градієнт фону лежить на ЗВИЧАЙНОМУ Frame. UIGradient прямо на CanvasGroup
    -- множить усі діти на свої кольори, і все вікно ставало майже чорним.
    local bgFill = new("Frame", { Name = "Bg", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 0 }, main)
    local mainGrad = gradient(bgFill, Theme.bg:Lerp(Theme.accent, 0.07), Theme.bg, 135)
    local aurora = new("Frame", { Name = "Aurora", Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = Theme.accent, BorderSizePixel = 0, ZIndex = 0 }, main)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.8, 1) }, aurora)
    local decorList = { loopTween(aurora, 4.5, { BackgroundTransparency = 0.3 }), borderSpin }
    local topGlow = new("Frame", { Name = "TopGlow", Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1 }, main)
    local topGlowGrad = gradient(topGlow, Theme.accent, Theme.accent2, 0)
    W.Main = main
    function W._scale() return uiScale.Scale end
    W._decorExtra = {}

    local dotsBg = new("Frame", {
        Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 46),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0, ClipsDescendants = true,
    }, main)
    local function dotColor(i) return (i % 3 == 0) and Theme.accent2 or Theme.accent end
    local dots = makeParticles(dotsBg, 20, dotColor)
    decorList[#decorList + 1] = dots
    local function setDecor(on)   -- v4: декоративні анімації йдуть лише поки меню відкрите
        for _, d in ipairs(decorList) do
            if type(d) == "table" then
                if on then d.resume() else d.pause() end
            else
                pcall(function() if on then d:Play() else d:Pause() end end)
            end
        end
    end

    -- зовнішні компоненти (кільце профілю, пульс) реєструють свої tween-и: вони йдуть лише поки меню відкрите
    function W._addDecor(d)
        decorList[#decorList + 1] = d
        if not isOpen then pcall(function() d:Pause() end) end
    end

    -- відкриття / закриття
    function W:Open()
        if isOpen or self._destroyed then return end
        isOpen = true; animTok += 1
        local tok = animTok
        savedMouse = { Behavior = UserInputService.MouseBehavior, Icon = UserInputService.MouseIconEnabled }
        sp(iconScale, "Scale", 0, SPRING.smooth)
        task.delay(0.3, function() if animTok == tok and icon.Parent then icon.Visible = false; setIconLoops(false) end end)
        if not main.Visible then
            main.GroupTransparency = 1
            spSnap(uiScale, "Scale", baseScale * 0.9)
            main.Visible = true
        end
        tw(main, 0.4, { GroupTransparency = 0 })
        sp(uiScale, "Scale", baseScale, SPRING.pop)
        startGuard(); forceMouse()
        setDecor(true)
        pcall(function() borderSpin:Play() end)
        applyBlur()
        for i, b in ipairs(W._tabButtons) do
            b.TextTransparency = 1
            task.delay(0.1 + i * 0.05, function()
                if animTok == tok and b.Parent then tw(b, 0.45, { TextTransparency = 0 }) end
            end)
        end
        if opts.onOpen then safe(opts.onOpen) end
    end
    function W:Close()
        if not isOpen then return end
        animTok += 1
        local tok = animTok
        if W._currentExpanded then pcall(W._currentExpanded) end
        for _, h in ipairs(W._closeHooks) do pcall(h) end
        stopGuard()          -- інакше при Immediate-сигналах охоронець одразу поверне Default
        restoreMouse()
        isOpen = false
        applyBlur()
        tw(main, 0.3, { GroupTransparency = 1 })
        sp(uiScale, "Scale", baseScale * 0.94, SPRING.smooth)
        task.delay(0.32, function()
            if animTok ~= tok or not main.Parent then return end
            main.Visible = false
            pcall(function() borderSpin:Pause() end)
            setDecor(false)
            if not hideIcon then
                icon.Visible = true
                setIconLoops(true)
                spSnap(iconScale, "Scale", 0)
                sp(iconScale, "Scale", 1, SPRING.pop)
            end
        end)
        if opts.onClose then safe(opts.onClose) end
    end
    function W:Toggle()
        if isOpen then self:Close() else self:Open() end
    end
    function W:IsOpen() return isOpen end
    function W:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        stopGuard()
        restoreMouse()
        isOpen = false
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        if ui and ui.Parent then ui:Destroy() end
        local idx = table.find(Library._windows, self)
        if idx then table.remove(Library._windows, idx) end
    end


    -- ── плавне перетягування ──
    local function clampMain(c)
        local vp = viewport()
        local hw, hh = winW * uiScale.Scale / 2, winH * uiScale.Scale / 2
        return Vector2.new(
            math.clamp(c.X, 70 - hw, vp.X - 70 + hw),
            math.clamp(c.Y, hh, vp.Y - 46 + hh))
    end
    local function clampIcon(c)
        local vp = viewport(); local h = ICON_SIZE / 2
        return Vector2.new(math.clamp(c.X, h, vp.X - h), math.clamp(c.Y, h, vp.Y - h))
    end
    local function setMainCenter(c)
        center = c; main.Position = UDim2.fromOffset(c.X, c.Y)
