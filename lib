    avatarBg.TextSize = 28; avatarBg.TextColor3 = Color3.new(1,1,1)
    avatarBg.Size = UDim2.new(1,0,1,0); avatarBg.BackgroundColor3 = Theme.accent
    uiCorner(avatarBg, 36); avatarBg.BackgroundTransparency = 1; avatarBg.TextTransparency = 1
    local avatarImg = Instance.new("ImageLabel", avatarWrap)
    avatarImg.Size = UDim2.new(1,0,1,0); avatarImg.BackgroundTransparency = 1
    avatarImg.ImageTransparency = 1; uiCorner(avatarImg, 36)
    if avatarUrl ~= "" then avatarImg.Image = avatarUrl end
    local userLbl = Instance.new("TextLabel", content)
    userLbl.Text = username; userLbl.Font = Enum.Font.Cartoon; userLbl.TextSize = 12
    userLbl.TextColor3 = Theme.muted; userLbl.Size = UDim2.new(1,0,0,18)
    userLbl.Position = UDim2.new(0,0,0,188); userLbl.BackgroundTransparency = 1
    userLbl.TextTransparency = 1
    local barBg = Instance.new("Frame", content)
    barBg.Size = UDim2.new(1,-48,0,6); barBg.Position = UDim2.new(0,24,0,220)
    barBg.BackgroundColor3 = Color3.fromRGB(35,35,48); barBg.BorderSizePixel = 0
    barBg.BackgroundTransparency = 1; uiCorner(barBg, 3)
    local barFill = Instance.new("Frame", barBg)
    barFill.Size = UDim2.new(0,0,1,0); barFill.BackgroundColor3 = Theme.accent
    barFill.BorderSizePixel = 0; uiCorner(barFill, 3)
    addGradient(barFill, Theme.accent, Theme.accent2, 0)
    local statusLbl = Instance.new("TextLabel", content)
    statusLbl.Text = T_.loading or "Loading menu..."; statusLbl.Font = Enum.Font.Cartoon; statusLbl.TextSize = 11
    statusLbl.TextColor3 = Theme.muted; statusLbl.Size = UDim2.new(1,0,0,16)
    statusLbl.Position = UDim2.new(0,0,0,232); statusLbl.BackgroundTransparency = 1
    statusLbl.TextTransparency = 1
    local checkMark = Instance.new("TextLabel", content)
    checkMark.Text = "OK"; checkMark.Font = Enum.Font.Cartoon; checkMark.TextSize = 14
    checkMark.TextColor3 = Theme.green; checkMark.Size = UDim2.new(0,30,0,30)
    checkMark.Position = UDim2.new(1,-44,0,24); checkMark.BackgroundTransparency = 1
    checkMark.TextTransparency = 1
    animateCardIn(card, 340, 270); task.wait(0.25)
    uiTween(welcomeLbl, 0.4, {TextTransparency = 0}):Play()
    uiTween(avatarBg, 0.45, {BackgroundTransparency = 0, TextTransparency = 0}, Enum.EasingStyle.Back):Play()
    uiTween(avatarGlow, 0.5, {BackgroundTransparency = 0.7}):Play()
    uiTween(avatarImg, 0.5, {ImageTransparency = 0}):Play()
    task.wait(0.15)
    uiTween(userLbl, 0.35, {TextTransparency = 0}):Play()
    uiTween(barBg, 0.3, {BackgroundTransparency = 0}):Play()
    uiTween(statusLbl, 0.3, {TextTransparency = 0}):Play()
    local barTween = uiTween(barFill, 1.4, {Size = UDim2.new(1,0,1,0)}, Enum.EasingStyle.Quad)
