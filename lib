-- ═══════════════════════════════════════════════════════════
--  v4: КЛАВІШІ, КОМБІНАЦІЇ ТА БІНДИ
-- ═══════════════════════════════════════════════════════════
-- Клавіша = назва KeyCode ("Q", "One", "LeftShift") або "MB2"/"MB3" (права/середня кнопка миші).
-- Комбінація = до 3 клавіш разом: "Q+One", "LeftShift+F". Одинарна клавіша ("F") сумісна зі старими конфігами.
local KEY_PRETTY = {
    One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
    LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
    LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", Backquote = "`", Minus = "-", Equals = "=",
    LeftBracket = "[", RightBracket = "]", BackSlash = "\\", Semicolon = ";", Quote = "'", Comma = ",",
    Period = ".", Slash = "/", CapsLock = "Caps", Insert = "Ins", Delete = "Del", PageUp = "PgUp", PageDown = "PgDn",
    KeypadZero = "Num0", KeypadOne = "Num1", KeypadTwo = "Num2", KeypadThree = "Num3", KeypadFour = "Num4",
    KeypadFive = "Num5", KeypadSix = "Num6", KeypadSeven = "Num7", KeypadEight = "Num8", KeypadNine = "Num9",
    KeypadPlus = "Num+", KeypadMinus = "Num-", KeypadMultiply = "Num*", KeypadDivide = "Num/",
    KeypadPeriod = "Num.", KeypadEnter = "NumEnter", MB2 = "RMB", MB3 = "MMB",
}
local KEY_REVERSE = {}
for k, v in pairs(KEY_PRETTY) do KEY_REVERSE[string.lower(v)] = k end
local MODE_ORDER = { "toggle", "hold", "press" }

local KEY_LOWER
local function resolveKeyName(s)
    s = tostring(s):gsub("^%s+", ""):gsub("%s+$", "")
    if s == "" then return nil end
    local pretty = KEY_REVERSE[string.lower(s)]
    if pretty then return pretty end
    local ok, v = pcall(function() return Enum.KeyCode[s] end)
    if ok and v then return s end
    if not KEY_LOWER then   -- нечутливий до регістру пошук ("q" → "Q"), будується один раз
        KEY_LOWER = {}
        for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do KEY_LOWER[string.lower(item.Name)] = item.Name end
    end
    return KEY_LOWER[string.lower(s)]
end

local function keyFromInput(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.Keyboard then
        local n = input.KeyCode.Name
        if n ~= "Unknown" then return n end
    elseif t == Enum.UserInputType.MouseButton2 then
        return "MB2"
    elseif t == Enum.UserInputType.MouseButton3 then
        return "MB3"
    end
    return nil
end
local function validKeyName(n)
    if n == "MB2" or n == "MB3" then return true end
    local ok, v = pcall(function() return Enum.KeyCode[n] end)
    return ok and v ~= nil
end
-- приймає: nil, "Q", "Q+One", "LShift + 1", Enum.KeyCode, { "Q", Enum.KeyCode.One }
local function parseCombo(v)
    local out = {}
    local function add(n)
        if not n or #out >= 3 or not validKeyName(n) then return end
        for _, e in ipairs(out) do if e == n then return end end
        out[#out + 1] = n
    end
    if v == nil then return out end
    if typeof(v) == "EnumItem" then
        add(v.Name)
    elseif type(v) == "table" then
        for _, k in ipairs(v) do
            if typeof(k) == "EnumItem" then add(k.Name) else add(resolveKeyName(k)) end
        end
    elseif type(v) == "string" then
        if v == "" or v == "None" then return out end
        for part in v:gmatch("[^+]+") do add(resolveKeyName(part)) end
    end
    return out
end
local function comboString(keys) return #keys > 0 and table.concat(keys, "+") or "None" end
local function comboText(keys)
    if #keys == 0 then return nil end
    local t = {}
    for i, k in ipairs(keys) do t[i] = KEY_PRETTY[k] or k end
    return table.concat(t, " + ")
end
local function firstKeyCode(keys)
    local k = keys[1]
    if k and k ~= "MB2" and k ~= "MB3" then return Enum.KeyCode[k] end
    return nil
end

-- ── менеджер біндів (по одному на вікно; один набір слухачів на всі бінди) ──
function Window:_initBinds()
    if self._binds then return end
    local win = self
    self._binds = {}
    local pressed, pending = {}, {}
    self._pressed = pressed
    table.insert(self._closeHooks, function()
        if win._listening and win._cancelListen then pcall(win._cancelListen) end
    end)

    local function flush(k)
        local p = pending[k]
        if not p then return end
        pending[k] = nil
        for _, b in ipairs(p) do if b.enabled then win:_fireBind(b, true) end end
    end

    self._track(UserInputService.InputBegan:Connect(function(input, gp)
        local k = keyFromInput(input)
        if not k or win._listening or win._destroyed then return end
        -- клавіатура: блокуємо лише під час набору тексту (раніше gp глушив і клавіші, зайняті грою);
        -- миша: gp лишається, щоб клік по самому меню не спрацьовував як бінд
        if k == "MB2" or k == "MB3" then
            if gp then return end
        elseif UserInputService:GetFocusedTextBox() then
            return
        elseif gp and Library.BindRespectGameProcessed then
            return
        end
        pressed[k] = true
        -- серед збігів виграють найдовші комбінації: «Q+1» перекриває одиночну «Q»
        local best, hits = 0, nil
        for _, b in ipairs(win._binds) do
            if b.keySet[k] and b.n > 0 and b.enabled and (win._bindsOn ~= false or b.id == "__menu") then
                local all = true
                for i = 1, b.n do if not pressed[b.keys[i]] then all = false; break end end
                if all then
                    if b.n > best then best = b.n; hits = { b }
                    elseif b.n == best then hits[#hits + 1] = b end
                end
            end
        end
        if not hits then return end
        -- довша комбінація скасовує відкладені коротші
        if best > 1 then
            for key in pairs(hits[1].keySet) do pending[key] = nil end
        end
        -- якщо існує довша комбінація з цією клавішею, даємо їй 0.14 с шанс завершитись (інакше затримки немає)
        local longer = false
        for _, b in ipairs(win._binds) do
            if b.enabled and b.n > best and b.keySet[k] then longer = true; break end
        end
        if longer then
            pending[k] = hits
            task.delay(0.14, function() if pending[k] == hits then flush(k) end end)
        else
            for _, b in ipairs(hits) do win:_fireBind(b, true) end
        end
    end))
    self._track(UserInputService.InputEnded:Connect(function(input)
        local k = keyFromInput(input)
        if not k then return end
        flush(k)   -- швидкий тап теж рахується
        pressed[k] = nil
        for _, b in ipairs(win._binds) do
            if b.mode == "hold" and b.active and b.keySet[k] then win:_fireBind(b, false) end
        end
    end))
    pcall(function()
        self._track(UserInputService.WindowFocusReleased:Connect(function()
            table.clear(pressed); table.clear(pending)
            for _, b in ipairs(win._binds) do
                if b.mode == "hold" and b.active then win:_fireBind(b, false) end
            end
        end))
    end)
end

function Window:_setBindState(b, v, user)
    if b.active == v then return end
    b.active = v
    if user and b.apply then safe(b.apply, v) end
    if user and b.onToggle then safe(b.onToggle, v) end
    if b.onState then b.onState() end
    self:_hudRefresh()
end
function Window:_fireBind(b, down)
    if b.mode == "hold" then
        if b.active ~= down then self:_setBindState(b, down, true) end
    elseif b.mode == "toggle" then
        if down then self:_setBindState(b, not b.active, true) end
    elseif down then
        b.flash = os.clock()
        if b.onState then b.onState() end
        self:_hudRefresh()
        task.delay(0.4, function() if not self._destroyed then self:_hudRefresh() end end)   -- погасити підсвітку
    end
    if down and b.onPress then safe(b.onPress) end
end

function Window:_removeBind(b)
    local idx = table.find(self._binds, b)
    if idx then table.remove(self._binds, idx) end
    b.enabled = false
    self:_hudRefresh()
end

-- def: { id, name, keys, mode, list, modes, apply(state), onPress(), onToggle(state), onKeys(keys), onState() }
function Window:_addBind(def)
    self:_initBinds()
    local win = self
    local b = {
        id = def.id, name = def.name or "Bind", keys = {}, n = 0, keySet = {}, mode = def.mode or "toggle",
        modes = def.modes or MODE_ORDER, active = false, list = def.list ~= false, enabled = true, flash = 0,
        apply = def.apply, onPress = def.onPress, onToggle = def.onToggle, onKeys = def.onKeys, onState = def.onState,
    }
    if not table.find(MODE_ORDER, b.mode) then b.mode = "toggle" end
    local function setKeysRaw(keys)
        b.keys = keys; b.n = #keys; b.keySet = {}
        for _, k in ipairs(keys) do b.keySet[k] = true end
    end
    setKeysRaw(parseCombo(def.keys))
    b.setKeysRaw = setKeysRaw

    local api = {}
    function api.Get() return comboString(b.keys) end
    function api.GetKeys() return table.clone(b.keys) end
    function api.GetText() return comboText(b.keys) end
    function api.Set(_, v, silent)
        setKeysRaw(parseCombo(v))
        if b.onKeysUI then b.onKeysUI() end
        if b.onKeys and not silent then safe(b.onKeys, b.keys) end
        win:_hudRefresh()
    end
    function api.GetMode() return b.mode end
    function api.SetMode(_, m)
        if not table.find(b.modes, m) then return end
        if b.mode == "hold" and b.active and m ~= "hold" then win:_setBindState(b, false, true) end
        b.mode = m
        if b.onState then b.onState() end
        win:_hudRefresh()
    end
    function api.IsActive() return b.active end
    function api.SetActive(_, v) win:_setBindState(b, v and true or false, true) end
    function api.SetEnabled(_, v) b.enabled = v ~= false end
    function api.SetListed(_, v) b.list = v ~= false; win:_hudRefresh() end
    function api.SetName(_, n) b.name = tostring(n); win:_hudRefresh() end
    function api.Remove() win:_removeBind(b) end
    b.api = api

    table.insert(self._binds, b)
    if b.list and b.id ~= "__menu" and not self._kb then
        local vis = Library._hud.kbVisible
        if vis == nil then vis = self._kbAutoShow ~= false end
        self:AddKeybindList({ visible = vis })
    end
    self:_hudRefresh()
    return b
end

-- Публічний API: Window:AddBind{ name, keys = "Q+One", mode = "toggle"|"hold"|"press", onPress, onToggle, list }
-- onToggle(state) — для режимів toggle/hold; onPress() — при кожному натисканні.
function Window:AddBind(opts)
    opts = opts or {}
    local b = self:_addBind({
        id = opts.id, name = opts.name, keys = opts.keys or opts.default,
        mode = opts.mode or (opts.onToggle and "toggle" or "press"),
        list = opts.list, modes = opts.modes, apply = opts.apply, onPress = opts.onPress, onToggle = opts.onToggle,
    })
    return b.api
end

-- Захоплення клавіш: тримай кілька клавіш разом і відпусти. Esc — скасувати, Backspace/Delete — очистити.
function Window:_beginCapture(h, btn)
    if self._listening and self._cancelListen then pcall(self._cancelListen) end
    local win = self
    local held, order, conns = {}, {}, {}
    local done = false
    local function stop()
        if done then return end
        done = true
        for _, c in ipairs(conns) do c:Disconnect() end
        table.clear(conns)
        win._cancelListen = nil
        -- відкладено: щоб остання відпущена клавіша не спрацювала одразу як бінд
        task.defer(function() if not win._cancelListen then win._listening = false end end)
    end
    local function cancel()
        if done then return end
        stop()
        if h.cancel then safe(h.cancel) end
    end
    self._listening = true
    self._listenBtn = btn
    self._listenInsideAt = os.clock()
    self._cancelListen = cancel
    conns[1] = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then cancel(); return end
            if #order == 0 and (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete) then
                stop(); if h.done then safe(h.done, {}, true) end
                return
            end
        end
        local k = keyFromInput(input)
        if k and not held[k] and #order < 3 then
            held[k] = true; order[#order + 1] = k
            if h.preview then safe(h.preview, order) end
        end
    end)
    conns[2] = UserInputService.InputEnded:Connect(function(input)
        local k = keyFromInput(input)
        if k and held[k] then
            held[k] = nil
            if next(held) == nil and #order > 0 then
                stop(); if h.done then safe(h.done, table.clone(order), false) end
            end
        end
    end)
    return cancel
end

-- Контейнер для «аксесуарів» справа в рядку (колір, режим, кнопка бінду…)
function KeyMgr.accessories(host, rightPad, H)
    local c = new("Frame", {
        Name = "Accessories", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -rightPad, 0.5, 0),
        Size = UDim2.fromOffset(0, H), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
    }, host)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
    }, c)
    return c
end

-- o: { name, flag, default, mode, modes, showMode, list, compact, height, bind, required,
--      apply, onPress, onToggle, callback, allowRightClick }
-- Повертає { bind, api, keyButton, render, sync(state) }
function KeyMgr.buildControls(win, container, o)
    local compact = o.compact
    local H = o.height or (compact and 22 or 28)
    local listening = false
    local preview
    local keyBtn, keyStroke, modeBtn, delBtn

    local bind = o.bind or win:_addBind({
        id = o.id, name = o.name, keys = o.default, mode = o.mode, modes = o.modes, list = o.list,
        apply = o.apply, onPress = o.onPress, onToggle = o.onToggle,
    })

    local function render()
        local txt = comboText(bind.keys)
        if delBtn then delBtn.Visible = (#bind.keys > 0) and not listening end
        if listening then keyBtn.Text = preview or "..."
        else keyBtn.Text = txt or T("none") end
        local active = bind.active and bind.mode ~= "press"
        tw(keyBtn, 0.18, {
            TextColor3 = listening and Theme.accent or (txt and Theme.text or Theme.muted),
            BackgroundColor3 = active and Theme.card2:Lerp(Theme.accent, 0.14) or Theme.card2,
        })
        tw(keyStroke, 0.2, { Color = (listening or active) and Theme.accent or Theme.border })
        if modeBtn then
            modeBtn.Text = T("mode_" .. bind.mode)
            tw(modeBtn, 0.18, { TextColor3 = active and Theme.accent or Theme.muted })
        end
    end

    keyBtn = new("TextButton", {
        Text = "", _font = "b", TextSize = compact and 11 or 12, TextColor3 = Theme.text,
        Size = UDim2.fromOffset(0, H), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.card2,
        BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = 2,
    }, container)
    corner(keyBtn, compact and 6 or 8)
    new("UIPadding", { PaddingLeft = UDim.new(0, compact and 8 or 10), PaddingRight = UDim.new(0, compact and 8 or 10) }, keyBtn)
    new("UISizeConstraint", { MinSize = Vector2.new(compact and 44 or 64, H) }, keyBtn)
    keyStroke = stroke(keyBtn, Theme.border, 1)

    local function fireKeyChange()
        if bind.onKeys then safe(bind.onKeys, bind.keys) end
        if o.callback then safe(o.callback, firstKeyCode(bind.keys), comboString(bind.keys), table.clone(bind.keys)) end
    end
    local function cycleMode()
        local modes = bind.modes
        local idx = table.find(modes, bind.mode) or 0
        bind.api:SetMode(modes[(idx % #modes) + 1])
        if o.flag then Library:_commit(o.flag .. "_mode", bind.mode) end
        render()
    end

    if o.showMode then
        modeBtn = new("TextButton", {
            Text = "", _font = "r", TextSize = 10, TextColor3 = Theme.muted, Size = UDim2.fromOffset(0, H),
            AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.card2, BackgroundTransparency = 0.25,
            BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = 1,
        }, container)
        corner(modeBtn, compact and 6 or 8)
        new("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, modeBtn)
        modeBtn.MouseButton1Click:Connect(cycleMode)
    end

    -- маленький «×»: прибрати бінд одним кліком (для обов'язкових, як клавіша меню, його немає)
    if not o.required then
        delBtn = new("TextButton", {
            Text = "×", _font = "b", TextSize = compact and 13 or 15, TextColor3 = Theme.muted,
            Size = UDim2.fromOffset(compact and 16 or 20, H), BackgroundColor3 = Theme.card2, BackgroundTransparency = 0.25,
            BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = 3, Visible = false,
        }, container)
        corner(delBtn, compact and 6 or 8)
        local dst = { hover = false, down = false }
        interact(delBtn, dst, function() tw(delBtn, 0.15, { TextColor3 = dst.hover and Theme.red or Theme.muted }) end)
        delBtn.MouseButton1Click:Connect(function()
            if listening or #bind.keys == 0 then return end
            if bind.mode == "hold" and bind.active then win:_setBindState(bind, false, true) end
            bind.setKeysRaw({})
            render()
            Library:_commit(o.flag, comboString(bind.keys))
            fireKeyChange()
            win:_hudRefresh()
        end)
        win._onTheme(function() delBtn.BackgroundColor3 = Theme.card2; delBtn.TextColor3 = Theme.muted end)
    end

    keyBtn.InputBegan:Connect(function(i) if isPress(i) then win._listenInsideAt = os.clock() end end)
    keyBtn.MouseButton1Click:Connect(function()
        if listening then
            if win._cancelListen then win._cancelListen() end
            return
        end
        listening = true; preview = nil; render()
        win:_beginCapture({
            preview = function(keys) preview = (comboText(keys) or "") .. " …"; keyBtn.Text = preview end,
            done = function(keys)
                listening = false; preview = nil
                if o.required and #keys == 0 then render(); return end   -- напр. клавішу меню не можна стерти
                bind.setKeysRaw(keys)
                render()
                Library:_commit(o.flag, comboString(keys))
                fireKeyChange()
                win:_hudRefresh()
            end,
            cancel = function() listening = false; preview = nil; render() end,
        }, keyBtn)
    end)
    if o.showMode or o.allowRightClick then keyBtn.MouseButton2Click:Connect(cycleMode) end

    bind.onKeysUI = render
    bind.onState = render
    win._onTheme(render)
    table.insert(win._textElements, { type = "custom", update = render })   -- мова: чип режиму та «None»
    render()

    if o.flag then
        Library:RegisterFlag(o.flag, function() return comboString(bind.keys) end, function(v)
            local keys = parseCombo(v)
            if o.required and #keys == 0 then return end
            bind.setKeysRaw(keys); render(); win:_hudRefresh(); fireKeyChange()
        end, comboString(bind.keys))
        Library:RegisterFlag(o.flag .. "_mode", function() return bind.mode end, function(v)
            if table.find(bind.modes, v) then bind.api:SetMode(v); render() end
        end, bind.mode)
    end

    return {
        bind = bind, api = bind.api, keyButton = keyBtn, render = render,
        sync = function(state) bind.active = state and true or false; render(); win:_hudRefresh() end,
    }
end

-- Keybind: клік → тримай клавіші (можна комбінацію) → відпусти. Esc — скасувати, Backspace — очистити.
-- opts: name, key, flag, default ("Q+One" / Enum.KeyCode), mode, modes, showMode, list, listName,
--       target (прапор / функція / об'єкт з :Set) — що вмикати цим біндом,
--       onPress(), onToggle(state), callback(keyCode, combo, keys)
function SubTab:AddKeybind(opts)
    opts = opts or {}
    local win = self._window
    local flag = opts.flag
    local host, hostStroke = makeHost(self._container, 44, false, self._LO(), false)
    local lbl = label(host, opts.name or (opts.key and T(opts.key)) or flag or "Keybind", 13, Theme.text, {
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -190, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)
    local container = KeyMgr.accessories(host, 10, 28)

    local targetApply
    local t = opts.target
    if type(t) == "string" then targetApply = function(v) Library:SetFlag(t, v) end
    elseif type(t) == "function" then targetApply = t
    elseif type(t) == "table" and t.Set then targetApply = function(v) t:Set(v) end end
    local hasState = targetApply ~= nil or opts.onToggle ~= nil
    local mode = opts.mode or (hasState and "toggle" or "press")
    local showMode = opts.showMode
    if showMode == nil then showMode = hasState end

    local ctl = KeyMgr.buildControls(win, container, {
        name = opts.listName or opts.name or flag or "Bind", flag = flag, default = opts.default, mode = mode, modes = opts.modes,
        showMode = showMode, list = opts.list, apply = targetApply, onPress = opts.onPress, onToggle = opts.onToggle,
        callback = opts.callback, allowRightClick = true, bind = opts.bind, required = opts.required,
    })
    if opts.key then
        table.insert(win._textElements, { type = "custom", update = function()
            if not opts.listName then ctl.bind.name = T(opts.key); win:_hudRefresh() end
        end })
        if not opts.name and not opts.listName then ctl.bind.name = T(opts.key) end
    end
    if type(t) == "string" then Library:OnFlagChanged(t, function(v) ctl.sync(v == true) end) end

    local state = { hover = false, down = false }
    interact(host, state, function(a) styleHost(host, hostStroke, false, state, a) end)
    win._onTheme(function() lbl.TextColor3 = Theme.text end)

    local api = setmetatable({
        -- сумісність із v3: Get() віддає KeyCode першої клавіші
        Get = function() return firstKeyCode(ctl.bind.keys) end,
        GetCombo = function() return comboString(ctl.bind.keys) end,
        Set = function(_, v) ctl.bind.api:Set(v, true); Library:_commit(flag, comboString(ctl.bind.keys)) end,
    }, { __index = ctl.api })
    registerSearch(self, host)
    return host, api
end


