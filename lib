local KeyMgr, ColorUI = {}, {}   -- v4: заповнюються нижче (потрібні в buildToggle)
-- пошук: реєструємо хост компонента та функцію, що повертає його поточну назву
local function nameOf(inst, fallback)
    return function()
        if inst:IsA("TextButton") and inst.Text ~= "" then return inst.Text end
        local l = inst:FindFirstChildWhichIsA("TextLabel")
        if l and l.Text ~= "" then return l.Text end
        return fallback or ""
    end
end
local function registerSearch(sub, inst, getName, isSection)
    local win = sub._window
    if win and win._searchItems then
        win._searchItems[#win._searchItems + 1] = { inst = inst, name = getName or nameOf(inst), section = isSection, sub = sub }
    end
end

local function regText(win, obj, key, fmt)
    if not key then return end
    table.insert(win._textElements, { type = "custom", update = function()
        local v = T(key)
        obj.Text = fmt and fmt(v) or v
    end })
end

local function makeHost(parent, height, compact, order, asButton)
    local host = Instance.new(asButton and "TextButton" or "Frame")
    host.Size = UDim2.new(1, 0, 0, height); host.BorderSizePixel = 0
    host.BackgroundColor3 = compact and Theme.card2 or Theme.card
    host.LayoutOrder = order
    if asButton then host.Text = ""; host.AutoButtonColor = false end
    corner(host, compact and 8 or 10)
    local st = (not compact) and stroke(host, Theme.border, 1) or nil
    host.Parent = parent
    return host, st
end

local function styleHost(host, hostStroke, compact, state, animate)
    local base = compact and Theme.card2 or Theme.card
    local hov = compact and base:Lerp(Theme.tint, 0.05) or Theme.cardHover
    local bg = state.down and pressed(hov) or (state.hover and hov or base)
    local dur = animate and 0.18 or 0
    tw(host, dur, { BackgroundColor3 = bg })
    if hostStroke then
        tw(hostStroke, dur, { Color = state.hover and Theme.accent:Lerp(Theme.border, 0.5) or Theme.border })
    end
end

local function makeSwitch(host, compact, initial)
    local TW, TH, K = 44, 24, 18
    if compact then TW, TH, K = 36, 20, 14 end
    local pad = (TH - K) / 2
    local track = new("Frame", {
        Size = UDim2.fromOffset(TW, TH), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        BackgroundColor3 = Theme.track, BorderSizePixel = 0,
    }, host)
    corner(track, 999)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(K, K), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, track)
    corner(knob, 999)
    local sw = { value = initial, down = false, track = track, knob = knob }
    function sw.render(animate)
        local on = sw.value
        local w = K + (sw.down and 4 or 0)
        local x = on and (TW - w - pad) or pad
        tw(track, animate and 0.3 or 0, { BackgroundColor3 = on and Theme.accent or Theme.track })
        tw(knob, animate and 0.3 or 0, { BackgroundColor3 = on and WHITE or Theme.muted:Lerp(WHITE, 0.55) })
        if animate then
            sp(knob, "Position", UDim2.new(0, x, 0.5, 0), SPRING.pop)
            sp(knob, "Size", UDim2.fromOffset(w, K), SPRING.snap)
        else
            spSnap(knob, "Position", UDim2.new(0, x, 0.5, 0)); spSnap(knob, "Size", UDim2.fromOffset(w, K))
        end
    end
    function sw.press(d)
        if sw.down ~= d then sw.down = d; sw.render(true) end
    end
    sw.render(false)
    return sw
end

-- ── TOGGLE ──
local function buildToggle(win, parent, order, opts, compact)
    local flag = opts.flag
    local value = opts.default == true
    local hasDesc = (not compact) and opts.desc ~= nil
    local host, hostStroke = makeHost(parent, compact and 36 or (hasDesc and 56 or 44), compact, order, true)
    local lbl = label(host, opts.name or (opts.key and T(opts.key)) or flag or "Toggle", compact and 12 or 13, Theme.text, {
        Position = UDim2.fromOffset(compact and 10 or 14, hasDesc and 9 or 0),
        Size = hasDesc and UDim2.new(1, -70, 0, 18) or UDim2.new(1, -70, 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)
    local descLbl
    if hasDesc then
        descLbl = label(host, tostring(opts.desc), 11, Theme.muted, {
            Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -70, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd,
        })
    end
    local sw = makeSwitch(host, compact, value)

    local state = { hover = false, down = false }
    local function render(animate) styleHost(host, hostStroke, compact, state, animate); sw.press(state.down) end
    interact(host, state, render)
    win._onTheme(function()
        render(true); sw.render(true); lbl.TextColor3 = Theme.text
        if descLbl then descLbl.TextColor3 = Theme.muted end
    end)

    local ctlKb   -- v4: бінд у рядку (стан синхронізується з перемикачем)
    local function apply(v) value = v; sw.value = v; sw.render(true); if ctlKb then ctlKb.sync(v) end end
    local function fire(v) if opts.callback then safe(opts.callback, v) end end
    host.MouseButton1Click:Connect(function()
        apply(not value)
        Library:_commit(flag, value)
        fire(value)
    end)

    local api = {}
    function api.Get() return value end
    function api.Set(_, v)
        v = v == true
        if v == value then return end
        apply(v); fire(v)
    end

    -- v4: вбудовані аксесуари справа: колір (opts.color) і клавіша / комбінація (opts.keybind)
    if opts.keybind or opts.color then
        local H = compact and 22 or 26
        local rightPad = 12 + (compact and 36 or 44) + 8
        local acc = KeyMgr.accessories(host, rightPad, H)
        local function fit()
            local pad = rightPad + acc.AbsoluteSize.X / math.max(win._scale(), 0.01) + 10
            lbl.Size = hasDesc and UDim2.new(1, -pad, 0, 18) or UDim2.new(1, -pad, 1, 0)
            if descLbl then descLbl.Size = UDim2.new(1, -pad, 0, 18) end
        end
        acc:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
        if opts.keybind then
            local kb = type(opts.keybind) == "table" and opts.keybind or {}
            local nm = kb.name or opts.name or (opts.key and T(opts.key)) or flag or "Toggle"
            ctlKb = KeyMgr.buildControls(win, acc, {
                name = nm, flag = kb.flag or (flag and (flag .. "_bind")), default = kb.default, mode = kb.mode or "toggle",
                modes = kb.modes or { "toggle", "hold" }, showMode = kb.showMode ~= false, list = kb.list,
                compact = true, height = H, onPress = kb.onPress, callback = kb.callback,
                apply = function(v)
                    if v ~= value then api.Set(nil, v); Library:_commit(flag, value) end
                end,
            })
            ctlKb.sync(value)
            if opts.key and not kb.name and not opts.name then
                table.insert(win._textElements, { type = "custom", update = function()
                    ctlKb.bind.name = T(opts.key); win:_hudRefresh()
                end })
            end
            api.Bind = ctlKb.api
        end
        if opts.color then
            local co = opts.color
            if type(co) ~= "table" then co = { default = co } end
            local chipObj = ColorUI.chip(win, acc, 0, {
                default = co.default or co[1], flag = co.flag or (flag and (flag .. "_color")), callback = co.callback,
                alpha = co.alpha, rainbow = co.rainbow, presets = co.presets, live = co.live,
            }, H)
            api.Color = chipObj.api
        end
        fit()
    end
    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v) api.Set(nil, v) end, value)
    end
    return host, api
end

-- ── SLIDER ──
local function buildSlider(win, parent, order, opts, compact)
    local flag = opts.flag
    local minV = tonumber(opts.min) or 0
    local maxV = tonumber(opts.max) or 100
    if maxV <= minV then maxV = minV + 1 end
    local step = tonumber(opts.step) or 1
    if step <= 0 then step = 1 end
    local decimals = 0
    do
        local txt = string.format("%.8f", step):gsub("0+$", "")   -- без наукової нотації (1e-05)
        local frac = txt:match("%.(%d+)")
        if frac then decimals = math.min(#frac, 8) end
    end
    local suffix = tostring(opts.suffix or "")
    local function snap(v)
        v = math.clamp(v, minV, maxV)
        v = minV + math.floor((v - minV) / step + 0.5) * step
        v = math.clamp(v, minV, maxV)
        return tonumber(string.format("%." .. decimals .. "f", v)) or v
    end
    local function fmt(v)
        if decimals == 0 then return tostring(math.floor(v + 0.5)) .. suffix end
        local s = string.format("%." .. decimals .. "f", v)
        s = s:gsub("0+$", ""):gsub("%.$", "")
        return s .. suffix
    end
    local function ratioOf(v) return (v - minV) / (maxV - minV) end

    local value = snap(tonumber(opts.default) or minV)
    local host, hostStroke = makeHost(parent, compact and 46 or 54, compact, order, false)
    local textSize = compact and 12 or 13
    local lbl = label(host, opts.name or (opts.key and T(opts.key)) or flag or "Slider", textSize, Theme.text, {
        Position = UDim2.fromOffset(compact and 10 or 14, compact and 4 or 7), Size = UDim2.new(0.6, 0, 0, 18),
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)
    local valLbl = label(host, fmt(value), textSize, Theme.accent, {
        _font = "b", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, compact and -10 or -14, 0, compact and 4 or 7),
        Size = UDim2.new(0.4, 0, 0, 18), TextXAlignment = RIGHT,
    })

    local hit = new("TextButton", {
        Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
        Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, compact and 22 or 29),
    }, host)
    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = Theme.track, BorderSizePixel = 0,
    }, hit)
    corner(track, 3)
    local fill = new("Frame", { Size = UDim2.fromScale(ratioOf(value), 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, track)
    corner(fill, 3)
    local fillGrad = gradient(fill, Theme.accent, Theme.accent2, 0)
    local HS = compact and 14 or 16
    local handle = new("Frame", {
        Size = UDim2.fromOffset(HS, HS), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratioOf(value), 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3,
    }, hit)
    corner(handle, 999)
    local handleStroke = stroke(handle, Theme.accent, 2)

    local dragging = false
    local hoverState = { hover = false, down = false }
    local function renderHandle()
        local s = HS + (dragging and 4 or (hoverState.hover and 2 or 0))
        sp(handle, "Size", UDim2.fromOffset(s, s), SPRING.pop)
        tw(host, 0.18, { BackgroundColor3 = (hoverState.hover or dragging) and (compact and Theme.card2:Lerp(Theme.tint, 0.04) or Theme.cardHover) or (compact and Theme.card2 or Theme.card) })
        if hostStroke then
            tw(hostStroke, 0.18, { Color = (hoverState.hover or dragging) and Theme.accent:Lerp(Theme.border, 0.5) or Theme.border })
        end
    end
    hit.MouseEnter:Connect(function() hoverState.hover = true; renderHandle() end)
    hit.MouseLeave:Connect(function() hoverState.hover = false; renderHandle() end)

    local function visual(v, dur)
        local p = ratioOf(v)
        local preset = dur > 0.1 and SPRING.smooth or SPRING.snap
        sp(fill, "Size", UDim2.fromScale(p, 1), preset)
        sp(handle, "Position", UDim2.new(p, 0, 0.5, 0), preset)
        valLbl.Text = fmt(v)
    end
    local function commitPos(relX, width)
        if width <= 0 then return end
        local p = math.clamp(relX / width, 0, 1)
        local v = snap(minV + p * (maxV - minV))
        visual(v, 0.07)
        if v ~= value then
            value = v
            Library:_commit(flag, v)
            if opts.callback then safe(opts.callback, v) end
        end
    end
    hit.InputBegan:Connect(function(inp)
        if not isPress(inp) then return end
        local sf = parent:FindFirstAncestorWhichIsA("ScrollingFrame")
        if sf then sf.ScrollingEnabled = false end
        dragging = true; renderHandle()
        win._sliderDragState = {
            track = hit, scrollFrame = sf, setValue = commitPos,
            onEnd = function() dragging = false; renderHandle() end,
        }
        commitPos(inp.Position.X - hit.AbsolutePosition.X, hit.AbsoluteSize.X)
    end)

    win._onTheme(function()
        renderHandle()
        setGrad(fillGrad, Theme.accent, Theme.accent2)
        tw(handleStroke, 0.3, { Color = Theme.accent })
        tw(track, 0.3, { BackgroundColor3 = Theme.track })
        lbl.TextColor3 = Theme.text; valLbl.TextColor3 = Theme.accent
    end)

    local api = {}
    function api.Get() return value end
    function api.Set(_, v)
        v = snap(tonumber(v) or value)
        local changed = v ~= value
        value = v
        visual(v, 0.25)
        if changed and opts.callback then safe(opts.callback, v) end
    end
    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v) api.Set(nil, v) end, value)
    end
    return hit, api, host
end

-- ── BUTTON ──
local function buildButton(win, parent, order, opts, compact)
    local primary = opts.primary == true or (compact and opts.active == true)
    local h = compact and 28 or 42
    local btn = new("TextButton", {
        Text = tostring(opts.name or (opts.key and T(opts.key)) or "Button"), _font = "r", TextSize = compact and 12 or 13,
        Size = UDim2.new(1, 0, 0, h), BorderSizePixel = 0, AutoButtonColor = false, LayoutOrder = order,
        BackgroundColor3 = primary and Color3.fromRGB(235, 235, 235) or (compact and Theme.card2 or Theme.card),
        TextColor3 = primary and Theme.onAccent or Theme.text,
    })
    local radius = compact and 7 or 10
    corner(btn, radius)
    local btnStroke = (not compact and not primary) and stroke(btn, Theme.border, 1) or nil
    local grad, fillFrame
    if primary then
        -- UIGradient на TextButton фарбує ще й текст → градієнт лежить на Frame ПОЗАДУ кнопки
        local holder = new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = order })
        fillFrame = new("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(238, 238, 238), BorderSizePixel = 0, ZIndex = 1,
        }, holder)
        corner(fillFrame, radius)
        grad = gradient(fillFrame, Theme.accent, Theme.accent2, 0)
        btn.Size = UDim2.fromScale(1, 1); btn.BackgroundTransparency = 1; btn.ZIndex = 2
        holder.Parent = parent
        btn.Parent = holder
    else
        btn.Parent = parent
    end
    regText(win, btn, opts.key)

    local state = { hover = false, down = false }
    local function render(animate)
        local dur = animate and 0.18 or 0
        if primary then
            local g = state.down and 200 or (state.hover and 255 or 238)
            tw(fillFrame, dur, { BackgroundColor3 = Color3.fromRGB(g, g, g) })
            tw(btn, dur, { TextColor3 = Theme.onAccent })
        else
            local base = compact and Theme.card2 or Theme.card
            local hov = compact and base:Lerp(Theme.tint, 0.07) or Theme.cardHover
            tw(btn, dur, {
                BackgroundColor3 = state.down and pressed(hov) or (state.hover and hov or base),
                TextColor3 = Theme.text,
            })
            if btnStroke then
                tw(btnStroke, dur, { Color = state.hover and Theme.accent:Lerp(Theme.border, 0.4) or Theme.border })
            end
        end
    end
    interact(btn, state, render)
    win._onTheme(function()
        if grad then setGrad(grad, Theme.accent, Theme.accent2) end
        render(true)
    end)
    btn.InputBegan:Connect(function(i)
        if isPress(i) then
            ripple(btn, inputScreenPos(i), primary and WHITE or Theme.accent, win._scale(), radius)
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if opts.callback then safe(opts.callback) end
    end)
    return btn
end

-- ── COLLAPSIBLE (ExpandableCard і MiniExpandable) ──
local Group = {}; Group.__index = Group
local function newGroup(win, holder, gap, onResize)
    return setmetatable({ win = win, holder = holder, gap = gap or 6, items = {}, onResize = onResize, order = 0 }, Group)
end
function Group:nextOrder() self.order += 1; return self.order end
function Group:add(inst, getH)
    self.items[#self.items + 1] = { inst = inst, getH = getH }
    self:changed(false)
end
function Group:height()
    local h = 0
    for i, it in ipairs(self.items) do
        h += it.getH()
        if i > 1 then h += self.gap end
    end
    return h
end
function Group:changed(animate)
    if self.onResize then self.onResize(animate) end
end

local function buildCollapsible(win, parent, order, opts, compact, parentGroup)
    local flag = opts.flag
    local value
    if compact then value = opts.default == true
    else value = (opts.default == true) or (opts.default == nil) end
    local headH = compact and 36 or 42
    local sidePad = compact and 8 or 12
    local bottomPad = compact and 8 or 10

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, headH); frame.BorderSizePixel = 0; frame.ClipsDescendants = true
    frame.BackgroundColor3 = compact and Theme.card2 or Theme.card; frame.LayoutOrder = order
    corner(frame, compact and 8 or 10)
    local frameStroke = (not compact) and stroke(frame, Theme.border, 1) or nil
    frame.Parent = parent

    local header = new("TextButton", {
        Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, headH),
    }, frame)
    local arrow = label(header, "▸", compact and 11 or 13, Theme.muted, {
        Size = UDim2.fromOffset(16, headH), Position = UDim2.fromOffset(sidePad, 0), TextXAlignment = CENTER,
    })
    local lbl = label(header, opts.name or (opts.key and T(opts.key)) or flag or "Card", compact and 12 or 13, Theme.text, {
        Position = UDim2.fromOffset(sidePad + 20, 0), Size = UDim2.new(1, -(sidePad + 20 + 62), 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)
    local sw = makeSwitch(header, compact, value)

    local holder = new("Frame", {
        Size = UDim2.new(1, -sidePad * 2, 0, 0), Position = UDim2.fromOffset(sidePad, headH),
        BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Visible = value,
    }, frame)
    local list = new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, holder)

    local api = {}
    local group
    local fallbackH = tonumber(opts.height) or 0
    local function contentH()
        local h = group:height()
        if h == 0 then
            h = (opts.dynamicHeight and tonumber(opts.dynamicHeight()) or fallbackH) or 0
        end
        return h
    end
    local function targetH()
        if not value then return headH end
        local h = contentH()
        return headH + h + (h > 0 and bottomPad or 0)
    end
    local function layout(animate)
        local ch = value and contentH() or 0
        local dur = animate and 0.6 or 0
        if value then holder.Visible = true end
        local fs, hs = UDim2.new(1, 0, 0, targetH()), UDim2.new(1, -sidePad * 2, 0, ch)
        if animate then
            sp(frame, "Size", fs, SPRING.smooth); sp(holder, "Size", hs, SPRING.smooth)
            sp(arrow, "Rotation", value and 90 or 0, SPRING.soft)
        else
            spSnap(frame, "Size", fs); spSnap(holder, "Size", hs); spSnap(arrow, "Rotation", value and 90 or 0)
        end
        tw(arrow, animate and 0.3 or 0, { TextColor3 = value and Theme.accent or Theme.muted })
        if not value then
            if animate then
                task.delay(dur, function() if not value then holder.Visible = false end end)
            else
                holder.Visible = false
            end
        end
    end
    group = newGroup(win, holder, 6, function(animate)
        layout(animate)
        if parentGroup then parentGroup:changed(animate) end
    end)

    local state = { hover = false, down = false }
    local function renderFrame(animate)
        sw.press(state.down)
        local base = compact and Theme.card2 or Theme.card
        local hov = compact and base:Lerp(Theme.tint, 0.05) or Theme.cardHover
        local dur = animate and 0.18 or 0
        tw(frame, dur, { BackgroundColor3 = state.hover and hov or base })
        if frameStroke then
            tw(frameStroke, dur, { Color = state.hover and Theme.accent:Lerp(Theme.border, 0.5) or Theme.border })
        end
    end
    interact(header, state, renderFrame)
    win._onTheme(function() renderFrame(true); sw.render(true); layout(true); lbl.TextColor3 = Theme.text end)

    local function setValue(v)
        value = v; sw.value = v; sw.render(true)
        layout(true)
        if parentGroup then parentGroup:changed(true) end
        if api.onState then api.onState(v) end
    end
    local function fire(v) if opts.callback then safe(opts.callback, v) end end
    header.MouseButton1Click:Connect(function()
        setValue(not value)
        Library:_commit(flag, value)
        fire(value)
    end)
    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v)
            v = v == true
            if v ~= value then setValue(v); fire(v) end
        end, value)
    end

    if opts.keybind and not compact then
        local kb = type(opts.keybind) == "table" and opts.keybind or {}
        local kbH = 26
        local acc = new("Frame", {
            Name = "CardAccessories", AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -64, 0.5, 0),     -- 12 (switch pad) + 44 (switch) + 8 (gap)
            Size = UDim2.fromOffset(0, kbH), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1, ZIndex = 2,
        }, header)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5),
            SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
        }, acc)
        local ctlKb = KeyMgr.buildControls(win, acc, {
            name = kb.name or opts.name or (opts.key and T(opts.key)) or flag or "Card",
            flag = kb.flag or (flag and (flag .. "_bind")),
            default = kb.default, mode = kb.mode or "toggle",
            modes = kb.modes or { "toggle", "hold" },
            showMode = kb.showMode ~= false,
            list = kb.list, compact = false, height = kbH,
            onPress = kb.onPress, callback = kb.callback,
            apply = function(v)
                if v ~= value then setValue(v); fire(v) end
            end,
        })
        ctlKb.sync(value)
        api.Bind = ctlKb.api
        -- стиснути label, щоб не залазив під аксесуари
        local function refit()
            local w = acc.AbsoluteSize.X / math.max(win._scale(), 0.01)
            lbl.Size = UDim2.new(1, -(sidePad + 20 + 64 + 8 + w + 8), 1, 0)
        end
        acc:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
        refit()
    end

    layout(false)
    api.frame, api.holder, api.list, api.group = frame, holder, list, group
    api.targetH = targetH
    api.get = function() return value end
    return api
end

