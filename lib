    uiTween(checkMark, 0.3, {TextTransparency = 0}, Enum.EasingStyle.Back):Play()
    statusLbl.Text = T_.entering or "Entering..."; task.wait(0.35)
    if dotsConn then dotsConn:Disconnect() end
    animateCardOut(card, cardStroke, cardGrad, function()
        splashGui:Destroy()
        if opts.onComplete then pcall(opts.onComplete) end
    end)
end

