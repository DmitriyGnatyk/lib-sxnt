-- Tween, який сам скасовує попередній tween тих самих властивостей (без race condition)
local activeTweens = setmetatable({}, { __mode = "k" })
local springs, springConn = {}, nil

-- Кольорові / прозорі властивості анімуються м'якою Sine InOut кривою, рухи — Quint Out
local PAINT = {
    BackgroundColor3 = true, TextColor3 = true, Color = true, ImageColor3 = true, ScrollBarImageColor3 = true,
    BackgroundTransparency = true, TextTransparency = true, ImageTransparency = true,
    GroupTransparency = true, Transparency = true, Thickness = true,
}
local function tw(obj, t, props, style, dir)
    local sb = springs[obj]
    if sb then for k in pairs(props) do sb[k] = nil end end
    if t <= 0 then
        for k, v in pairs(props) do obj[k] = v end
        return nil
    end
    local keys, paint = {}, true
    for k in pairs(props) do
        keys[#keys + 1] = k
        if not PAINT[k] then paint = false end
    end
    table.sort(keys)
    local key = table.concat(keys, ",")
    if style == nil then
        if paint then style, dir, t = ES.Sine, ED.InOut, t * 1.2
        else style = ES.Quint end
    end
    local bucket = activeTweens[obj]
    if not bucket then bucket = {}; activeTweens[obj] = bucket end
    local prev = bucket[key]
    if prev then prev:Cancel() end
    local tween = TweenService:Create(obj, TweenInfo.new(t, style, dir or ED.Out), props)
    bucket[key] = tween
    tween:Play()
    return tween
end

-- ═══ SPRING ENGINE ═══
-- Пружина зберігає швидкість при зміні цілі, тому анімацію можна переривати будь-коли
-- (відкрив-закрив-відкрив, швидке перемикання вкладок, тягнення повзунка) — без ривків.
-- { частота (рад/с), демпфування } — демпфування 1 = без перельоту, < 1 = м'яке «пружинення»
local SPRING = {
    soft   = { 13, 0.82 },
    pop    = { 15, 0.62 },
    smooth = { 10, 1.0 },
    snap   = { 26, 1.0 },
}
local SPRING_EPS = {
    n  = { 0.0008 },
    u  = { 0.0006, 0.02 },
    u2 = { 0.0006, 0.02, 0.0006, 0.02 },
    v2 = { 0.02, 0.02 },
    c  = { 0.002, 0.002, 0.002 },
}
local function toArr(v)
    local t = typeof(v)
    if t == "number" then return { v }, "n" end
    if t == "UDim2" then return { v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset }, "u2" end
    if t == "UDim" then return { v.Scale, v.Offset }, "u" end
    if t == "Vector2" then return { v.X, v.Y }, "v2" end
    if t == "Color3" then return { v.R, v.G, v.B }, "c" end
    return nil
end
local function fromArr(a, kind)
    if kind == "n" then return a[1]
    elseif kind == "u2" then return UDim2.new(a[1], a[2], a[3], a[4])
    elseif kind == "u" then return UDim.new(a[1], a[2])
    elseif kind == "v2" then return Vector2.new(a[1], a[2])
    end
    return Color3.new(math.clamp(a[1], 0, 1), math.clamp(a[2], 0, 1), math.clamp(a[3], 0, 1))
end
local function stepSprings(dt)
    dt = math.min(dt, 0.05)
    local n = math.max(1, math.ceil(dt * 120))
    local h = dt / n
    for obj, props in pairs(springs) do
        if not obj:IsDescendantOf(game) then
            springs[obj] = nil
        else
            for prop, s in pairs(props) do
                local k, c, x, v, t = s.k, s.c, s.x, s.v, s.t
                for _ = 1, n do
                    for i = 1, #x do
                        v[i] += (-k * (x[i] - t[i]) - c * v[i]) * h
                        x[i] += v[i] * h
                    end
                end
                local done = true
                for i = 1, #x do
                    local e = s.eps[i]
                    if math.abs(x[i] - t[i]) > e or math.abs(v[i]) > e * 10 then done = false; break end
                end
                if done then
                    for i = 1, #x do x[i] = t[i] end
                    props[prop] = nil
                end
                obj[prop] = fromArr(x, s.kind)
            end
            if next(props) == nil then springs[obj] = nil end
        end
    end
    if next(springs) == nil and springConn then
        springConn:Disconnect(); springConn = nil
    end
end
local function sp(obj, prop, target, preset)
    preset = preset or SPRING.smooth
    local arr, kind = toArr(target)
    if not arr then obj[prop] = target; return end
    local tb = activeTweens[obj]
    if tb then
        for key, tween in pairs(tb) do
            if ("," .. key .. ","):find("," .. prop .. ",", 1, true) then tween:Cancel(); tb[key] = nil end
        end
    end
    local bucket = springs[obj]
    if not bucket then bucket = {}; springs[obj] = bucket end
    local s = bucket[prop]
    if not s then
        local cur = toArr(obj[prop])
        if not cur then obj[prop] = target; return end
        s = { x = cur, v = table.create(#cur, 0), kind = kind, eps = SPRING_EPS[kind] }
        bucket[prop] = s
    end
    s.t = arr
    local w = preset[1]
    s.k = w * w; s.c = 2 * preset[2] * w
    if not springConn then springConn = RunService.Heartbeat:Connect(stepSprings) end
end
local function spSnap(obj, prop, value)
    local b = springs[obj]
    if b then b[prop] = nil end
    obj[prop] = value
end

-- Нескінченний пульс (рахується рушієм, не Lua)
local function loopTween(obj, t, props)
    local tween = TweenService:Create(obj, TweenInfo.new(t, ES.Sine, ED.InOut, -1, true), props)
    tween:Play(); return tween
end
local function spin(grad, secs)
    local tween = TweenService:Create(grad, TweenInfo.new(secs, ES.Linear, ED.In, -1), { Rotation = 360 })
