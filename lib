-- Активна тема (змінне дзеркало; усі компоненти читають звідси)
local Theme = {}
local currentThemeName = "Ice"
local function applyThemeToMirror(name)
    local t = getTheme(name)
    for k in pairs(Theme) do Theme[k] = nil end
    for k, v in pairs(t) do Theme[k] = v end
    -- похідні кольори (можна не вказувати у власних темах)
    Theme.cardHover = t.cardHover or t.card:Lerp(WHITE, 0.05)
    Theme.card2     = t.card2     or t.card:Lerp(WHITE, 0.045)
    Theme.track     = t.track     or t.bg:Lerp(WHITE, 0.16)
    Theme.amber     = t.amber     or Color3.fromRGB(255, 185, 70)
    local a = t.accent
    local lum = 0.299 * a.R + 0.587 * a.G + 0.114 * a.B
    Theme.onAccent  = t.onAccent  or (lum > 0.6 and Color3.fromRGB(16, 16, 22) or WHITE)
    currentThemeName = THEMES[name] and name or "Ice"
end
applyThemeToMirror("Ice")

