function SubTab:AddThemePicker(opts)
    opts = opts or {}
    local win = self._window
    local api = self:AddDropdown({
        name = opts.name, key = opts.key or "theme", flag = opts.flag or "sxnt_theme",
        options = Library.ThemeOrder, default = Library:GetThemeName(),
        swatch = function(n) local t = THEMES[n]; return t.accent, t.accent2 end,
        callback = function(v)
            if v ~= Library:GetThemeName() then Library:SetTheme(v) end
            if opts.callback then safe(opts.callback, v) end
        end,
