local function createCenterCard(parent, w, h, cornerR)
    local card = Instance.new("Frame")
    card.Name = "SxntCard"; card.Size = UDim2.new(0,0,0,0)
    card.Position = UDim2.new(0.5,0,0.5,0); card.AnchorPoint = Vector2.new(0.5,0.5)
    card.BackgroundColor3 = Theme.bg; card.BorderSizePixel = 0; card.ClipsDescendants = true
    card.Parent = parent; uiCorner(card, cornerR or 20)
    local cardStroke = uiStroke(card, Theme.accent, 1.5, 0.3); pulseStroke(cardStroke, Theme.accent, Theme.accent2)
    local cardGrad = addGradient(card, Color3.fromRGB(18,18,28), Color3.fromRGB(10,14,24), 135)
    local dotsHolder = Instance.new("Frame", card); dotsHolder.Size = UDim2.new(1,0,1,0)
    dotsHolder.BackgroundTransparency = 1; dotsHolder.ZIndex = 1
    -- floating dots
    local dots = {}
    for i = 1, 18 do
        local dot = Instance.new("Frame", dotsHolder)
        dot.Size = UDim2.new(0, math.random(2,5), 0, math.random(2,5))
        dot.Position = UDim2.new(math.random(),0,math.random(),0)
        dot.BackgroundColor3 = (i % 3 == 0) and Theme.accent2 or Theme.accent
        dot.BackgroundTransparency = math.random(50,85)/100; dot.BorderSizePixel = 0; dot.ZIndex = 0
        uiCorner(dot, 999)
        table.insert(dots, { obj = dot, spd = math.random(8,22)/1000, dir = math.random() > 0.5 and 1 or -1,
            baseX = dot.Position.X.Scale, baseY = dot.Position.Y.Scale })
    end
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not dotsHolder.Parent then conn:Disconnect() return end
        for _, d in ipairs(dots) do
            local o = d.obj
            if o and o.Parent then
                local ny = (o.Position.Y.Scale + d.spd * d.dir) % 1
                local nx = d.baseX + math.sin(tick()*2 + d.baseY*10) * 0.02
                o.Position = UDim2.new(nx, 0, ny, 0)
            end
        end
    end)
    return card, cardStroke, cardGrad, dotsHolder, conn
end

local function animateCardIn(card, w, h)
    uiTween(card, 0.55, {Size = UDim2.new(0,w,0,h)}, Enum.EasingStyle.Back):Play()
end
local function animateCardOut(card, cardStroke, cardGrad, onDone)
    uiTween(card, 0.35, { Size = UDim2.new(0, card.Size.X.Offset+40, 0, card.Size.Y.Offset+40), BackgroundTransparency = 1 },
        Enum.EasingStyle.Quad, Enum.EasingDirection.In):Play()
    if cardStroke then uiTween(cardStroke, 0.35, {Transparency = 1}):Play() end
    if cardGrad then cardGrad:Destroy() end
    for _, ch in ipairs(card:GetDescendants()) do
        if ch:IsA("GuiObject") then pcall(function()
            uiTween(ch, 0.28, { BackgroundTransparency = 1, TextTransparency = 1, ImageTransparency = 1 }):Play()
        end) end
    end
    task.delay(0.38, onDone)
end

local function ShowWelcomeSplash(opts)
