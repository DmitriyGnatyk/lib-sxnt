function SubTab:AddSection(text, key)
    local win = self._window
    local s = label(self._container, tostring(text), 12, Theme.accent, {
        Font = FONT_BOLD, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = self._LO(),
    })
    local line = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Theme.border, BorderSizePixel = 0, Visible = false,
    }, s)
    local lineGrad = new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, line)
    local function place()
        local w = s.TextBounds.X
        if w <= 0 then return end
        line.Visible = true
        line.Position = UDim2.new(0, w + 10, 0.5, 0)
        line.Size = UDim2.new(1, -(w + 10), 0, 1)
    end
    s:GetPropertyChangedSignal("TextBounds"):Connect(place)
    place()
    win._onTheme(function() s.TextColor3 = Theme.accent; line.BackgroundColor3 = Theme.border end)
    regText(win, s, key)
    return s
end

function SubTab:AddLabel(text)
    local win = self._window
    local l = label(self._container, tostring(text), 13, Theme.text, {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true, LayoutOrder = self._LO(),
    })
    new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2) }, l)
    win._onTheme(function() l.TextColor3 = Theme.text end)
    return l
end

function SubTab:AddButton(opts)
    return buildButton(self._window, self._container, self._LO(), opts or {}, false)
end

function SubTab:AddToggle(opts)
    local host, api = buildToggle(self._window, self._container, self._LO(), opts or {}, false)
    return host, api
end

function SubTab:AddSlider(opts)
    local hit, api = buildSlider(self._window, self._container, self._LO(), opts or {}, false)
    return hit, api
end

function SubTab:AddDropdown(opts)
    opts = opts or {}
    local win = self._window
    local flag = opts.flag
    local options = opts.options or opts.items or {}
    local value = opts.default or options[1]
    if opts.getValue then
        local ok, v = pcall(opts.getValue)
        if ok and v ~= nil then value = v end
    end
    local setValueCb = opts.setValue

    local HEAD, ITEM, GAP, MAXVIS = 44, 28, 3, 5
    local frame, frameStroke = makeHost(self._container, HEAD, false, self._LO(), false)
    frame.ClipsDescendants = true

    local lbl = label(frame, opts.name or (opts.key and T(opts.key)) or flag or "Dropdown", 13, Theme.text, {
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.4, -14, 0, HEAD), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)

    local btn = new("TextButton", {
        Text = "", Size = UDim2.new(0.6, -18, 0, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0, HEAD / 2),
        BackgroundColor3 = Theme.card2, BorderSizePixel = 0, AutoButtonColor = false,
    }, frame)
    corner(btn, 8)
    local btnStroke = stroke(btn, Theme.border, 1)
    local valueLbl = label(btn, tostring(value), 12, Theme.text, {
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -34, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local chevron = label(btn, "▼", 9, Theme.muted, {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(16, 16), TextXAlignment = CENTER,
    })

    local listHolder = new("Frame", {
        Size = UDim2.new(1, -16, 0, 0), Position = UDim2.fromOffset(8, HEAD + 2), BackgroundTransparency = 1,
        Visible = false, ClipsDescendants = true,
    }, frame)
    local scroll = new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, listHolder)
    new("UIListLayout", { Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
    new("UIPadding", { PaddingRight = UDim.new(0, 4) }, scroll)

    local expanded = false
    local optionButtons = {}
    local api = {}

    local function listHeight()
        local vis = math.min(#options, MAXVIS)
        if vis == 0 then return 0 end
        return vis * ITEM + (vis - 1) * GAP
    end
    local function expandedHeight() return HEAD + 2 + listHeight() + 8 end

    local function styleOption(ob, opt, hover)
        local selected = (opt == value)
        tw(ob.btn, 0.15, {
            BackgroundTransparency = hover and 0.0 or (selected and 0.55 or 1),
            BackgroundColor3 = hover and Theme.cardHover or Theme.card2,
            TextColor3 = selected and Theme.accent or Theme.text,
        })
        tw(ob.bar, 0.2, { BackgroundTransparency = selected and 0 or 1 })
    end
    local function refreshOptions()
        for opt, ob in pairs(optionButtons) do styleOption(ob, opt, false) end
    end

    local function collapse()
        if not expanded then return end
        expanded = false
        if win._currentExpanded == collapse then win._currentExpanded = nil end
        if win._popup and win._popup.card == frame then win._popup = nil end
        tw(frame, 0.32, { Size = UDim2.new(1, 0, 0, HEAD) }, ES.Quint)
        tw(chevron, 0.3, { Rotation = 0, TextColor3 = Theme.muted }, ES.Quint)
        tw(btnStroke, 0.2, { Color = Theme.border })
        tw(listHolder, 0.32, { Size = UDim2.new(1, -16, 0, 0) }, ES.Quint)
        task.delay(0.33, function() if not expanded then listHolder.Visible = false end end)
    end

    local function expand()
        if win._currentExpanded and win._currentExpanded ~= collapse then pcall(win._currentExpanded) end
        if expanded then return end
        expanded = true
        win._currentExpanded = collapse
        win._popup = { card = frame, collapse = collapse }
        listHolder.Visible = true
        tw(frame, 0.38, { Size = UDim2.new(1, 0, 0, expandedHeight()) }, ES.Quint)
        tw(listHolder, 0.38, { Size = UDim2.new(1, -16, 0, listHeight()) }, ES.Quint)
        tw(chevron, 0.3, { Rotation = 180, TextColor3 = Theme.accent }, ES.Quint)
        tw(btnStroke, 0.2, { Color = Theme.accent })
        refreshOptions()
    end

    local function fire(v)
        if opts.callback then pcall(opts.callback, v) end
    end
    local function applyValue(v)
        value = v
        valueLbl.Text = tostring(v)
        refreshOptions()
    end

    local function buildOptions()
        for _, ch in ipairs(scroll:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        table.clear(optionButtons)
        for idx, opt in ipairs(options) do
            local ob = new("TextButton", {
                Text = tostring(opt), Font = FONT, TextSize = 12, TextColor3 = Theme.text, Size = UDim2.new(1, 0, 0, ITEM),
                BackgroundColor3 = Theme.card2, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
                TextXAlignment = LEFT, LayoutOrder = idx, TextTruncate = Enum.TextTruncate.AtEnd,
            }, scroll)
            corner(ob, 7)
            new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 6) }, ob)
            local bar = new("Frame", {
                Size = UDim2.new(0, 3, 0, 14), Position = UDim2.new(0, -9, 0.5, -7), BackgroundColor3 = Theme.accent,
                BackgroundTransparency = 1, BorderSizePixel = 0,
            }, ob)
            corner(bar, 2)
            local rec = { btn = ob, bar = bar }
            optionButtons[opt] = rec
            ob.MouseEnter:Connect(function() styleOption(rec, opt, true) end)
            ob.MouseLeave:Connect(function() styleOption(rec, opt, false) end)
            ob.MouseButton1Click:Connect(function()
                applyValue(opt)
                Library:_commit(flag, opt)
                if setValueCb then pcall(setValueCb, opt) end
                fire(opt)
                collapse()
            end)
            styleOption(rec, opt, false)
        end
    end
    buildOptions()

    local bst = { hover = false, down = false }
    interact(btn, bst, function()
        tw(btn, 0.18, { BackgroundColor3 = bst.down and Theme.card2:Lerp(Theme.bg, 0.3) or (bst.hover and Theme.card2:Lerp(WHITE, 0.05) or Theme.card2) })
        if not expanded then tw(btnStroke, 0.18, { Color = bst.hover and Theme.accent:Lerp(Theme.border, 0.5) or Theme.border }) end
    end)
    btn.MouseButton1Click:Connect(function() if expanded then collapse() else expand() end end)

    win._onTheme(function()
        lbl.TextColor3 = Theme.text; valueLbl.TextColor3 = Theme.text
        tw(frame, 0.3, { BackgroundColor3 = Theme.card }); tw(frameStroke, 0.3, { Color = Theme.border })
        tw(btn, 0.3, { BackgroundColor3 = Theme.card2 }); scroll.ScrollBarImageColor3 = Theme.accent
        tw(chevron, 0.3, { TextColor3 = expanded and Theme.accent or Theme.muted })
        tw(btnStroke, 0.3, { Color = expanded and Theme.accent or Theme.border })
        refreshOptions()
    end)

    api.SetOptions = function(_, newOptions, newCurrent)
        options = newOptions or {}
        if newCurrent ~= nil then applyValue(newCurrent) end
        buildOptions()
        if expanded then
            tw(frame, 0.3, { Size = UDim2.new(1, 0, 0, expandedHeight()) }, ES.Quint)
            tw(listHolder, 0.3, { Size = UDim2.new(1, -16, 0, listHeight()) }, ES.Quint)
        end
    end
    api.Get = function() return value end
    api.Set = function(_, v)
        applyValue(v); fire(v)
    end
    api.Refresh = function() buildOptions() end

    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v) api.Set(nil, v) end, value)
    end
    return api
end

