        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, 12, 1, 12), BackgroundTransparency = 1,
    }, avatarWrap)
    corner(ring, 999)
    local ringStroke = stroke(ring, WHITE, 2, 1)
    local ringGrad = gradient(ringStroke, Theme.accent, Theme.accent2, 0)
    spin(ringGrad, 3)
    local avatarBg = label(avatarWrap, firstName:sub(1, 1):upper(), 28, WHITE, {
        Font = FONT_BOLD, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.accent,
        BackgroundTransparency = 1, TextTransparency = 1, TextXAlignment = CENTER,
    })
    corner(avatarBg, 999)
    local avatarImg = new("ImageLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ImageTransparency = 1, ZIndex = 2,
    }, avatarWrap)
    corner(avatarImg, 999)
    if avatarUrl ~= "" then avatarImg.Image = avatarUrl end

    local userLbl = label(content, username, 12, Theme.muted, {
        Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 184),
        TextXAlignment = CENTER, TextTransparency = 1,
    })

    local barBg = new("Frame", {
        Size = UDim2.new(1, -56, 0, 6), Position = UDim2.fromOffset(28, 220),
        BackgroundColor3 = Theme.track, BackgroundTransparency = 1, BorderSizePixel = 0,
    }, content)
    corner(barBg, 3)
    local barFill = new("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, barBg)
