end
function SubTab:AddFontPicker(opts)
    opts = opts or {}
    local win = self._window
    local api = self:AddDropdown({
        name = opts.name, key = opts.key or "font", flag = opts.flag or "sxnt_font",
        options = Library.FontOrder, default = Library:GetFont(),
        optionFont = function(n) local d = FONT_DEFS[n]; return d and d[1] end,
        callback = function(v)
            if v ~= Library:GetFont() then Library:SetFont(v) end
            if opts.callback then safe(opts.callback, v) end
        end,
    })
    table.insert(win._fontHooks, function(n) api:SetSilent(n) end)
    return api
end

