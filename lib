local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end

-- Tween, який сам скасовує попередній tween тих самих властивостей (без race condition)
local activeTweens = setmetatable({}, { __mode = "k" })
local function tw(obj, t, props, style, dir)
    if t <= 0 then
        for k, v in pairs(props) do obj[k] = v end
        return nil
    end
    local keys = {}
    for k in pairs(props) do keys[#keys + 1] = k end
    table.sort(keys)
    local key = table.concat(keys, ",")
    local bucket = activeTweens[obj]
    if not bucket then bucket = {}; activeTweens[obj] = bucket end
    local prev = bucket[key]
    if prev then prev:Cancel() end
    local tween = TweenService:Create(obj, TweenInfo.new(t, style or ES.Quart, dir or ED.Out), props)
    bucket[key] = tween
    tween:Play()
    return tween
end

-- Нескінченний пульс (рахується рушієм, не Lua)
local function loopTween(obj, t, props)
    local tween = TweenService:Create(obj, TweenInfo.new(t, ES.Sine, ED.InOut, -1, true), props)
    tween:Play(); return tween
end
local function spin(grad, secs)
    local tween = TweenService:Create(grad, TweenInfo.new(secs, ES.Linear, ED.In, -1), { Rotation = 360 })
    tween:Play(); return tween
end

local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (r and r >= 999) and UDim.new(1, 0) or UDim.new(0, r or 8)
    c.Parent = parent; return c
end
local function stroke(parent, col, th, trans)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = col or Theme.border; s.Thickness = th or 1; s.Transparency = trans or 0
    s.Parent = parent; return s
end
local function gradient(parent, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2); g.Rotation = rot or 0
    g.Parent = parent; return g
end
local function setGrad(g, c1, c2) g.Color = ColorSequence.new(c1, c2) end

local function label(parent, txt, size, color, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1; l.BorderSizePixel = 0
    l.Font = FONT; l.TextSize = size or 13; l.TextColor3 = color or Theme.text
    l.Text = tostring(txt or ""); l.TextXAlignment = LEFT
    if props then for k, v in pairs(props) do l[k] = v end end
    l.Parent = parent; return l
end

-- Безпечний батько для GUI: CoreGui, якщо він доступний, інакше PlayerGui
local cachedGui
local function GetMainGui()
    if cachedGui and cachedGui.Parent then return cachedGui end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then
        local probe = Instance.new("ScreenGui")
        local pok = pcall(function() probe.Parent = cg end)
        local good = pok and probe.Parent == cg
        pcall(function() probe:Destroy() end)
        if good then cachedGui = cg; return cg end
    end
    cachedGui = LocalPlayer:WaitForChild("PlayerGui")
    return cachedGui
end

local function playClickSound(volume)
    local s = Instance.new("Sound")
    s.SoundId = CLICK_SOUND_ID; s.Volume = volume or 1.2
    s.Parent = GetMainGui(); s:Play()
    Debris:AddItem(s, 1.5)
end
local function attachClickSound(inst, getVolume)
    if not inst:IsA("TextButton") then return end
    if inst:GetAttribute("SXNT_ClickAttached") then return end
    inst:SetAttribute("SXNT_ClickAttached", true)
    inst.MouseButton1Click:Connect(function()
        local v = 1.2
        if typeof(getVolume) == "function" then v = getVolume() or 1.2 end
        if v > 0 then playClickSound(v) end
    end)
end

-- Координати вводу в системі координат екрана (з урахуванням GuiInset)
local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function inputScreenPos(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseMovement then
        return UserInputService:GetMouseLocation()
    end
    return Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
end
local function pointInGui(inst, p)
    local a, s = inst.AbsolutePosition, inst.AbsoluteSize
    return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

-- Hover / press для будь-якого GuiObject
local function interact(inst, state, render)
    inst.MouseEnter:Connect(function() state.hover = true; render(true) end)
    inst.MouseLeave:Connect(function() state.hover = false; state.down = false; render(true) end)
    inst.InputBegan:Connect(function(i)
        if isPress(i) then state.down = true; render(true) end
    end)
    inst.InputEnded:Connect(function(i)
        if isPress(i) then
            state.down = false
            if i.UserInputType == Enum.UserInputType.Touch then state.hover = false end
            render(true)
        end
    end)
end

-- Ripple: коло, що розходиться від місця кліку (обрізається по закругленню через CanvasGroup)
local function ripple(host, pos, color, scale, radius)
    local layer = host:FindFirstChild("_Ripple")
    if not layer then
        layer = new("CanvasGroup", {
            Name = "_Ripple", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1), ZIndex = host.ZIndex + 1,
        }, host)
        corner(layer, radius or 8)
    end
    scale = (scale and scale > 0) and scale or 1
    local rel = (pos - host.AbsolutePosition) / scale
    local d = math.max(host.AbsoluteSize.X, host.AbsoluteSize.Y) / scale * 2.4
    local c = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rel.X, rel.Y),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = color or WHITE,
        BackgroundTransparency = 0.82, BorderSizePixel = 0,
    }, layer)
    corner(c, 999)
    tw(c, 0.6, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, ES.Quint)
    Debris:AddItem(c, 0.7)
end

-- Легкі частинки: кожна рухається власним tween-ом (без циклу кожен кадр)
local function makeParticles(holder, count, colorFn)
    local list = {}
    local function drift(p)
        if not p.Parent then return end
        local tween = TweenService:Create(p, TweenInfo.new(math.random(70, 150) / 10, ES.Sine, ED.InOut), {
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundTransparency = math.random(55, 90) / 100,
        })
        tween.Completed:Connect(function(state)
            if state == Enum.PlaybackState.Completed then drift(p) end
        end)
        tween:Play()
    end
    for i = 1, count do
        local size = math.random(2, 5)
        local dot = new("Frame", {
            Size = UDim2.fromOffset(size, size), Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = colorFn(i), BackgroundTransparency = math.random(55, 90) / 100,
            BorderSizePixel = 0,
        }, holder)
        corner(dot, 999)
        list[i] = dot
        task.delay(math.random() * 2, function() drift(dot) end)
    end
    return list
end

