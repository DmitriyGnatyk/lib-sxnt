        if animate then
            tw(mini, 0.3, {Size = UDim2.new(1, 0, 0, targetH)}, Enum.EasingStyle.Quart):Play()
            tw(holder, 0.3, {Size = UDim2.new(1, -16, 0, targetSubH)}, Enum.EasingStyle.Quart):Play()
