function SubTab:AddExpandableCard(opts)
    opts = opts or {}
    local C = self._C
    local tw = self._tw
    local corner = self._corner
    local stroke = self._stroke
    local flag = opts.flag
    local value = opts.default == true or (opts.default == nil and true)

    local card = Instance.new("Frame", self._container)
    card.Size = UDim2.new(1, 0, 0, 42)
    card.BackgroundColor3 = C.card
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.LayoutOrder = self._LO()
    corner(card, 10); stroke(card, C.border, 1)

    local lbl = Instance.new("TextLabel", card)
    lbl.Text = tostring(opts.name or flag or "Card")
    lbl.Font = Enum.Font.Cartoon; lbl.TextColor3 = C.text; lbl.TextSize = 13
    lbl.Position = UDim2.new(0, 12, 0, 0); lbl.Size = UDim2.new(0.7, 0, 0, 42)
    lbl.BackgroundTransparency = 1; lbl.TextXAlignment = Enum.TextXAlignment.Left

    local tgl = Instance.new("TextButton", card)
    tgl.Text = ""; tgl.Size = UDim2.new(0, 44, 0, 24)
    tgl.Position = UDim2.new(1, -54, 0, 9)
    tgl.BackgroundColor3 = value and C.accent or Color3.fromRGB(50,50,55)
    tgl.BorderSizePixel = 0; corner(tgl, 12); tgl.AutoButtonColor = false

    local kn = Instance.new("Frame", tgl)
    kn.Size = UDim2.new(0, 18, 0, 18)
    kn.Position = value and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,3,0.5,-9)
    kn.BackgroundColor3 = Color3.new(1,1,1); kn.BorderSizePixel = 0; corner(kn, 9)

    local holder = Instance.new("Frame", card)
    holder.Size = UDim2.new(1, -24, 0, 0)
    holder.Position = UDim2.new(0, 12, 0, 42)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = true

    local list = Instance.new("UIListLayout", holder)
    list.Padding = UDim.new(0, 6); list.SortOrder = Enum.SortOrder.LayoutOrder

    local cardObj = setmetatable({
        _card = card,
        _holder = holder,
        _list = list,
        _C = C, _tw = tw, _corner = corner, _stroke = stroke,
        _isOpen = value,
    }, ExpandableCard)

    local getDynamicHeight = opts.dynamicHeight
    local baseHeight = tonumber(opts.height) or 200
    local function getH()
        if getDynamicHeight then return getDynamicHeight() end
        return baseHeight
    end

    local function setExpanded(state, animate)
        state = state == true
        cardObj._isOpen = state
        local dynH = getH()
        local targetCardH = state and (42 + dynH) or 42
        local targetSubH = state and dynH or 0
        if animate then
            tw(card, 0.35, {Size = UDim2.new(1, 0, 0, targetCardH)}, Enum.EasingStyle.Quart):Play()
            tw(holder, 0.35, {Size = UDim2.new(1, -24, 0, targetSubH)}, Enum.EasingStyle.Quart):Play()
        else
            card.Size = UDim2.new(1, 0, 0, targetCardH)
            holder.Size = UDim2.new(1, -24, 0, targetSubH)
        end
    end
    setExpanded(value, false)

    tgl.MouseButton1Click:Connect(function()
        value = not value
        tw(tgl, 0.2, {BackgroundColor3 = value and C.accent or Color3.fromRGB(50,50,55)})
        tw(kn, 0.2, {Position = value and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,3,0.5,-9)})
        setExpanded(value, true)
        if opts.callback then pcall(opts.callback, value) end
    end)

    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v)
            if v ~= value then
                value = v
                tw(tgl, 0.2, {BackgroundColor3 = v and C.accent or Color3.fromRGB(50,50,55)})
                tw(kn, 0.2, {Position = v and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,3,0.5,-9)})
                setExpanded(v, true)
                if opts.callback then pcall(opts.callback, v) end
            end
        end, value)
    end

    function cardObj:Refresh()
        if self._isOpen then setExpanded(true, true) end
    end
    return cardObj
end

