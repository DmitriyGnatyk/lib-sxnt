-- ═══════════════════════════════════════════════════════════
-- Кастомний акцент накладається поверх будь-якої теми (і переживає зміну теми, доки його не скинуто).
local function repaintAllWindows()
    for _, w in ipairs(table.clone(Library._windows)) do
        if w and w._applyTheme then pcall(w._applyTheme) end
    end
end
function Library:SetAccent(c1, c2)
    c1 = parseColor(c1)
    if not c1 then return false end
    if c2 then c2 = parseColor(c2) end
    if not c2 then
        local h, s, v = c1:ToHSV()
        c2 = Color3.fromHSV((h + 0.08) % 1, s, v)
    end
    accentOv = { c1, c2 }
    applyThemeToMirror(currentThemeName)
    repaintAllWindows()
    Library:_commit("sxnt_accent", "#" .. toHex(c1))
    return true
end
function Library:ClearAccent()
    if not accentOv then return end
    accentOv = nil
    applyThemeToMirror(currentThemeName)
    repaintAllWindows()
    Library:_commit("sxnt_accent", "")
end
function Library:GetAccentOverride() return accentOv and accentOv[1] or nil end
-- прапор, щоб акцент зберігався в конфігах: "#RRGGBB" або "" (немає перевизначення)
Library:RegisterFlag("sxnt_accent",
    function() return accentOv and ("#" .. toHex(accentOv[1])) or "" end,
    function(v) if type(v) ~= "string" or v == "" then Library:ClearAccent() else Library:SetAccent(v) end end, "")

-- Вимкнути/увімкнути всі бінди одним перемикачем (клавіша меню працює завжди)
function Window:SetBindsEnabled(v)
    self._bindsOn = v ~= false
    Library:_commit("sxnt_binds_on", self._bindsOn)
end
function Window:AreBindsEnabled() return self._bindsOn ~= false end

local ACCENT_PRESETS = { "0096FF", "7C5BFF", "A35BFF", "FF5BC8", "FF3B5C", "FF8A3B", "FFD23B", "4BE37B", "3BDDFF", "FFFFFF" }

-- Window:AddSettingsTab{ icon, key, name, show = { appearance, hud, keys, config = false → без розділу }, configs }
-- Повертає Tab; усі елементи — звичайні компоненти, тож працюють пошук, теми, переклади й конфіги.
function Window:AddSettingsTab(opts)
    opts = opts or {}
    local win = self
    local show = opts.show or {}
    self:_initHud()
    local tab = self:AddTab({ icon = opts.icon or "⚙", key = opts.key or "tab_settings", name = opts.name })

    local function sub(key)
        local s = tab:AddSubTab(T(key))
        regText(win, s._pill, key)   -- назва пілюлі перекладається разом з усім інтерфейсом
        return s
    end
    local function notify(kind, msg) win:Notify({ type = kind, title = T("tab_settings"), content = msg }) end

    -- ── Вигляд ──
    if show.appearance ~= false then
        local s = sub("sub_appearance")
        s:AddSection(T("sec_theme"), "sec_theme")
        s:AddThemePicker()
        s:AddFontPicker()

        local resetting = false
        local picker
        picker = s:AddColorPicker({
            key = "accent_color", default = Theme.accent, live = false, presets = ACCENT_PRESETS,
            callback = function(c) if not resetting then Library:SetAccent(c) end end,
        })
        local function syncPicker(c)
            resetting = true
            picker:Set(c)
            resetting = false
        end
        s:AddButton({ key = "accent_reset", callback = function()
            Library:ClearAccent(); syncPicker(Theme.accent)
        end })
        Library:OnFlagChanged("sxnt_accent", function(v)
            if type(v) == "string" and v ~= "" then syncPicker(v) else syncPicker(Theme.accent) end
        end)
        win._onTheme(function() if not accentOv then syncPicker(Theme.accent) end end)

        s:AddSection(T("sec_interface"), "sec_interface")
        local langs = { "ENG", "UA", "TR", "RUS" }
        local extra = {}
        for code in pairs(L) do if not table.find(langs, code) then extra[#extra + 1] = code end end
        table.sort(extra)
        for _, code in ipairs(extra) do langs[#langs + 1] = code end
        s:AddDropdown({
            key = "lang", options = langs, default = Library:GetLanguage(),
            callback = function(v) if v ~= Library:GetLanguage() then Library:SetLanguage(v) end end,
        })
        s:AddToggle({ key = "blur", default = win:GetBlur(), flag = "sxnt_blur", callback = function(v) win:SetBlur(v) end })
        if not IS_MOBILE then
            s:AddToggle({ key = "hideicon", default = false, flag = "sxnt_hide_icon", callback = function(v) win._hideIcon(v) end })
        end
        s:AddSection(T("sec_sound"), "sec_sound")
        s:AddSlider({
            key = "volume", min = 0, max = 2, step = 0.1, default = win._GetVolume(), flag = "sxnt_volume",
            callback = function(v) win._SetVolume(v) end,
        })
    end

    -- ── HUD ──
    if show.hud ~= false then
        local s = sub("sub_hud")
        local hud = Library._hud
        s:AddSection(T("sec_hud"), "sec_hud")
        local function hudToggle(key, flagName, get, set)
            local _, api = s:AddToggle({ key = key, default = get(), callback = set })
            Library:OnFlagChanged(flagName, function(v) api:Set(v == true) end)   -- синхронізація із зовнішніми змінами
            return api
        end
        hudToggle("hud_watermark", "sxnt_wm_visible", function() return hud.wmVisible == true end, function(v) win:SetWatermark(v) end)
        hudToggle("hud_keybinds_show", "sxnt_kb_visible", function() return hud.kbVisible == true end, function(v) win:SetKeybindList(v) end)
        hudToggle("hud_only_active", "sxnt_kb_active_only", function() return hud.kbOnlyActive == true end, function(v) win:SetKeybindOnlyActive(v) end)
        hudToggle("hud_docked", "sxnt_kb_docked", function() return hud.kbDocked ~= false end, function(v) win:SetKeybindDocked(v) end)
        s:AddToggle({ key = "hud_draggable", default = win:IsHudDraggable(), flag = "sxnt_hud_draggable", callback = function(v) win:SetHudDraggable(v) end })
        s:AddButton({ key = "hud_reset", callback = function() win:ResetHud() end })
    end

    -- ── Клавіші ──
    if show.keys ~= false then
        local s = sub("sub_keys")
        s:AddSection(T("sec_binds"), "sec_binds")
        if win._menuBind then
            s:AddKeybind({ key = "keybind", flag = "sxnt_menu_key", bind = win._menuBind, required = true, showMode = false })
        end
        s:AddToggle({ key = "binds_master", default = win:AreBindsEnabled(), flag = "sxnt_binds_on", callback = function(v) win:SetBindsEnabled(v) end })
        local hint = s:AddLabel(T("keys_hint"))
        regText(win, hint, "keys_hint")
    end

    -- ── Конфіги ──
    if show.config ~= false then
        local s = sub("sub_config")
        local fs = fsAvailable()
        s:AddSection(T("sec_configs"), "sec_configs")
        if not fs then regText(win, s:AddLabel(T("cfg_nofs")), "cfg_nofs") end
        if fs then
            local _, nameApi = s:AddTextbox({ key = "cfg_name", placeholder = "default", default = "default" })
            local pickApi
            local function refreshList()
                local list = Library:ListConfigs()
                if #list == 0 then list = { T("cfg_none") } end
                pickApi:SetOptions(list, list[1])
            end
            pickApi = s:AddDropdown({
                key = "cfg_pick", options = { T("cfg_none") }, default = T("cfg_none"),
                callback = function(v) if table.find(Library:ListConfigs(), v) then nameApi:Set(v) end end,   -- не залежить від мови заглушки
            })
            refreshList()
            table.insert(win._textElements, { type = "custom", update = refreshList })   -- заглушка «(none)» перекладається
            local function currentName()
                local n = nameApi:Get()
                if cfgName(n) == "" then notify("warning", T("cfg_empty")); return nil end
                return n
            end
            s:AddButton({ key = "cfg_save", primary = true, callback = function()
                local n = currentName(); if not n then return end
                local ok, err = Library:SaveConfig(n)
                notify(ok and "success" or "error", ok and T("cfg_saved") or (T("cfg_err") .. ": " .. tostring(err)))
                if ok then refreshList() end
            end })
            s:AddButton({ key = "cfg_load", callback = function()
                local n = currentName(); if not n then return end
                local ok, res = Library:LoadConfig(n)
                notify(ok and "success" or "error", ok and (T("cfg_loaded") .. " (" .. tostring(res) .. ")") or (T("cfg_err") .. ": " .. tostring(res)))
            end })
            s:AddButton({ key = "cfg_autoload", callback = function()
                local n = currentName(); if not n then return end
                if Library:SetAutoload(n) then notify("success", T("cfg_autoset")) else notify("error", T("cfg_err")) end
            end })
            s:AddButton({ key = "cfg_delete", callback = function()
                local n = currentName(); if not n then return end
                if Library:DeleteConfig(n) then notify("success", T("cfg_deleted")); refreshList() else notify("error", T("cfg_err")) end
            end })
        end
        s:AddSection(T("sec_transfer"), "sec_transfer")
        s:AddButton({ key = "cfg_export", callback = function()
            local ok = Library.Copy(HttpService:JSONEncode(Library:ExportConfig()))
            notify(ok and "success" or "error", ok and T("cfg_copied") or T("no_clipboard"))
        end })
        local importApi
        local _importHost
        _importHost, importApi = s:AddTextbox({ key = "cfg_import", placeholder = "{ ... }", callback = function(v)
            if v == "" then return end
            local ok, data = pcall(function() return HttpService:JSONDecode(v) end)
            if ok and type(data) == "table" then
                notify("success", T("cfg_imported") .. " (" .. Library:ImportConfig(data) .. ")")
            else
                notify("error", T("cfg_err"))
            end
            importApi:Set("")
        end })
    end
    return tab
end

return Library
