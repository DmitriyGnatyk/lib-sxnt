--  FLAG / STATE STORE
-- ═══════════════════════════════════════════════════════════
local Flags = {}           -- [name] = { get = fn, set = fn, value = any, default = any }
local flagListeners = {}   -- [name] = { fn, fn, ... }

local function fireListeners(flag)
    local lst = flagListeners[flag]
    if not lst then return end
    local val = Flags[flag] and Flags[flag].value
    for _, fn in ipairs(lst) do pcall(fn, val) end
end

