    logo.TextColor3 = Theme.accent; logo.Size = UDim2.new(1,0,0,36)
    logo.Position = UDim2.new(0,0,0,28); logo.BackgroundTransparency = 1
    local welcomeLbl = Instance.new("TextLabel", content)
    welcomeLbl.Text = (T_[greetKey] or "Welcome") .. ", " .. firstName .. "!"
    welcomeLbl.Font = Enum.Font.Cartoon; welcomeLbl.TextSize = 16
    welcomeLbl.TextColor3 = Theme.text; welcomeLbl.Size = UDim2.new(1,-40,0,24)
    welcomeLbl.Position = UDim2.new(0,20,0,72); welcomeLbl.BackgroundTransparency = 1
