-- Координати вводу в системі координат екрана (з урахуванням GuiInset)
local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function inputScreenPos(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseMovement then
        return UserInputService:GetMouseLocation()
    end
    return Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
end
local function pointInGui(inst, p)
    local a, s = inst.AbsolutePosition, inst.AbsoluteSize
    return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

-- Hover / press для будь-якого GuiObject
local function interact(inst, state, render)
    inst.MouseEnter:Connect(function() state.hover = true; render(true) end)
    inst.MouseLeave:Connect(function() state.hover = false; state.down = false; render(true) end)
    inst.InputBegan:Connect(function(i)
        if isPress(i) then state.down = true; render(true) end
    end)
    inst.InputEnded:Connect(function(i)
        if isPress(i) then
            state.down = false
            if i.UserInputType == Enum.UserInputType.Touch then state.hover = false end
            render(true)
        end
    end)
end

-- Ripple: коло, що розходиться від місця кліку (обрізається по закругленню через CanvasGroup)
local function ripple(host, pos, color, scale, radius)
    local layer = host:FindFirstChild("_Ripple")
    if not layer then
        layer = new("CanvasGroup", {
            Name = "_Ripple", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1), ZIndex = host.ZIndex + 1,
        }, host)
        corner(layer, radius or 8)
    end
    scale = (scale and scale > 0) and scale or 1
    local rel = (pos - host.AbsolutePosition) / scale
    local d = math.max(host.AbsoluteSize.X, host.AbsoluteSize.Y) / scale * 2.4
    local c = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rel.X, rel.Y),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = color or WHITE,
        BackgroundTransparency = 0.86, BorderSizePixel = 0,
    }, layer)
    corner(c, 999)
    tw(c, 0.85, { Size = UDim2.fromOffset(d, d) }, ES.Quint)
    tw(c, 0.85, { BackgroundTransparency = 1 }, ES.Sine, ED.In)
    Debris:AddItem(c, 0.95)
end

-- Легкі частинки: кожна рухається власним tween-ом (без циклу кожен кадр)
local function makeParticles(holder, count, colorFn)
    local list = {}
    local live, paused = setmetatable({}, { __mode = "k" }), false
    local function drift(p)
        if not p.Parent then return end
        if paused then live[p] = false; return end   -- зупинена частинка чекає на resume
        local tween = TweenService:Create(p, TweenInfo.new(math.random(70, 150) / 10, ES.Sine, ED.InOut), {
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundTransparency = math.random(55, 90) / 100,
        })
        live[p] = tween
        tween.Completed:Connect(function(state)
            if state == Enum.PlaybackState.Completed then drift(p) end
        end)
        tween:Play()
    end
    for i = 1, count do
        local size = math.random(2, 5)
        local dot = new("Frame", {
            Size = UDim2.fromOffset(size, size), Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = colorFn(i), BackgroundTransparency = math.random(55, 90) / 100,
            BorderSizePixel = 0,
        }, holder)
        corner(dot, 999)
        list[i] = dot
        task.delay(math.random() * 2, function() drift(dot) end)
    end
    -- v4: поки вікно закрите, частинки не анімуються (економія кадру)
    function list.pause()
        paused = true
        for _, t in pairs(live) do
            if t then pcall(function() t:Pause() end) end
        end
    end
    function list.resume()
        if not paused then return end
        paused = false
        for p, t in pairs(live) do
            if not p.Parent then live[p] = nil
            elseif t then pcall(function() t:Play() end)
            else drift(p) end
        end
    end
    return list
end

