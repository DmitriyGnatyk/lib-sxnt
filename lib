local Window = {}; Window.__index = Window
local Tab    = {}; Tab.__index = Tab
local SubTab = {}; SubTab.__index = SubTab
local ExpandableCard = {}; ExpandableCard.__index = ExpandableCard

Library._windows = {}

-- ─── MAIN WINDOW ────────────────────────────────────────────
function Library:CreateWindow(opts)
    opts = opts or {}
    if opts.translations then L = opts.translations end
    if opts.language and VALID_LANGS[opts.language] then currentLang = opts.language end
    if opts.theme and THEMES[opts.theme] then applyThemeToMirror(opts.theme) end

    local gui = GetMainGui()
    if gui:FindFirstChild("Interface") then gui.Interface:Destroy() end

    local WindowObj = setmetatable({}, Window)
    WindowObj._connections = {}
    WindowObj._tabs = {}
    WindowObj._tabButtons = {}
    WindowObj._tabFrames = {}
    WindowObj._tabWraps = {}
    WindowObj._tabData = {}
    WindowObj._activeTab = 1
    WindowObj._textElements = {}
    WindowObj._layoutCounter = 0
    WindowObj._sliderDragState = nil
    WindowObj._currentExpanded = nil
    WindowObj._destroyed = false

    local function trackMenuConn(conn) table.insert(WindowObj._connections, conn) end
    WindowObj._track = trackMenuConn

    local C = {
        bg = Theme.bg, card = Theme.card, accent = Theme.accent, green = Theme.green,
        text = Theme.text, muted = Theme.muted, border = Theme.border, red = Theme.red,
        telegram = Theme.telegram,
    }
