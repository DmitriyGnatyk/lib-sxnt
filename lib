    local greetKey = isReturning and "welcome_back" or "welcome_new"
    local splashGui = Instance.new("ScreenGui"); splashGui.Name = "SxntWelcome"
    splashGui.ResetOnSpawn = false; splashGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    splashGui.Parent = GetMainGui()
