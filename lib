function SubTab:AddExpandableCard(opts)
    opts = opts or {}
    local win = self._window
    local c = buildCollapsible(win, self._container, self._LO(), opts, false, nil)
    local cardObj = setmetatable({
        _card = c.frame, _holder = c.holder, _list = c.list, _group = c.group, _win = win,
        _C = Theme, _tw = tw, _corner = corner, _stroke = stroke, _isOpen = c.get(),
    }, ExpandableCard)
    c.onState = function(v) cardObj._isOpen = v end
    function cardObj:Refresh() c.group:changed(true) end
    return cardObj
end

local function addMiniSwitch(win, g, o)
    local host = buildToggle(win, g.holder, g:nextOrder(), o or {}, true)
    g:add(host, function() return 36 end)
    return host
end
local function addMiniSlider(win, g, o)
    local _, _, host = buildSlider(win, g.holder, g:nextOrder(), o or {}, true)
    g:add(host, function() return 46 end)
    return host
end
local function addMiniButton(win, g, o)
    local btn = buildButton(win, g.holder, g:nextOrder(), o or {}, true)
    g:add(btn, function() return 28 end)
    return btn
end
local function addMiniExpandable(win, parentGroup, o)
    local c = buildCollapsible(win, parentGroup.holder, parentGroup:nextOrder(), o or {}, true, parentGroup)
    parentGroup:add(c.frame, c.targetH)
    local inner = {}
    -- працює і як inner.AddMiniSwitch(opts), і як inner:AddMiniSwitch(opts)
    local function pick(a, b) if a == inner then return b end return a end
    inner.AddMiniSwitch = function(a, b) return addMiniSwitch(win, c.group, pick(a, b)) end
    inner.AddMiniSlider = function(a, b) return addMiniSlider(win, c.group, pick(a, b)) end
    inner.AddMiniButton = function(a, b) return addMiniButton(win, c.group, pick(a, b)) end
    inner.AddMiniExpandable = function(a, b) return addMiniExpandable(win, c.group, pick(a, b)) end
    return inner
end

function ExpandableCard:AddMiniSwitch(opts) return addMiniSwitch(self._win, self._group, opts) end
function ExpandableCard:AddMiniSlider(opts) return addMiniSlider(self._win, self._group, opts) end
function ExpandableCard:AddMiniButton(opts) return addMiniButton(self._win, self._group, opts) end
function ExpandableCard:AddMiniExpandable(opts) return addMiniExpandable(self._win, self._group, opts) end

return Library
