        Size = UDim2.new(1, -56, 0, 6), Position = UDim2.fromOffset(28, 220),
        BackgroundColor3 = Theme.track, BackgroundTransparency = 1, BorderSizePixel = 0,
    }, content)
    corner(barBg, 3)
    local barFill = new("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, barBg)
    corner(barFill, 3)
    gradient(barFill, Theme.accent, Theme.accent2, 0)

    local statusLbl = label(content, T_.loading or "Loading menu...", 11, Theme.muted, {
        Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 236),
        TextXAlignment = CENTER, TextTransparency = 1,
    })
    local checkMark = label(content, "OK", 13, Theme.green, {
        _font = "b", Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -44, 0, 20),
        TextXAlignment = CENTER, TextTransparency = 1,
    })

    -- поява
    tw(card, 0.35, { GroupTransparency = 0 }, ES.Quad)
    sp(cardScale, "Scale", fit, SPRING.pop)
    task.wait(0.2)
    tw(logo, 0.45, { TextTransparency = 0 }, ES.Quad)
    task.wait(0.08)
    tw(welcomeLbl, 0.4, { TextTransparency = 0 }, ES.Quad)
    tw(avatarBg, 0.45, { BackgroundTransparency = 0, TextTransparency = 0 }, ES.Back)
    tw(avatarImg, 0.5, { ImageTransparency = 0 }, ES.Quad)
    tw(ringStroke, 0.5, { Transparency = 0.1 }, ES.Quad)
    task.wait(0.12)
    tw(userLbl, 0.35, { TextTransparency = 0 }, ES.Quad)
    tw(barBg, 0.3, { BackgroundTransparency = 0 }, ES.Quad)
    tw(statusLbl, 0.3, { TextTransparency = 0 }, ES.Quad)
    local barTween = tw(barFill, 1.4, { Size = UDim2.fromScale(1, 1) }, ES.Quad, ED.InOut)
    if barTween then barTween.Completed:Wait() end
    tw(checkMark, 0.3, { TextTransparency = 0 }, ES.Back)
    statusLbl.Text = T_.entering or "Entering..."
    task.wait(0.35)

    -- зникнення
    tw(card, 0.35, { GroupTransparency = 1 }, ES.Quad, ED.In)
    sp(cardScale, "Scale", fit * 1.06, SPRING.smooth)
    task.delay(0.4, function()
        splashGui:Destroy()
        if opts.onComplete then safe(opts.onComplete) end
    end)
end

