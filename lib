local function uiTween(obj, t, props, style, dir)
    return TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
end
local function uiCorner(parent, r)
    local c = Instance.new("UICorner", parent); c.CornerRadius = UDim.new(0, r or 10); return c
end
local function uiStroke(parent, col, th, trans)
    local s = Instance.new("UIStroke", parent); s.Color = col or Theme.border; s.Thickness = th or 1; s.Transparency = trans or 0; return s
end
local function addGradient(parent, c1, c2, rot)
    local g = Instance.new("UIGradient", parent)
    g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2) })
    g.Rotation = rot or 45; return g
end
local function addGlowRing(parent, color, size)
    local ring = Instance.new("Frame", parent)
    ring.Name = "GlowRing"; ring.Size = UDim2.new(1, size or 8, 1, size or 8)
    ring.Position = UDim2.new(0.5,0,0.5,0); ring.AnchorPoint = Vector2.new(0.5,0.5)
    ring.BackgroundColor3 = color or Theme.accent; ring.BackgroundTransparency = 0.75
    ring.BorderSizePixel = 0; ring.ZIndex = parent.ZIndex - 1
    uiCorner(ring, 999); return ring
end
local function pulseStroke(stroke, c1, c2)
    task.spawn(function()
        while stroke.Parent do
            uiTween(stroke, 1.2, {Color = c2}, Enum.EasingStyle.Sine):Play(); task.wait(1.2)
            if not stroke.Parent then break end
            uiTween(stroke, 1.2, {Color = c1}, Enum.EasingStyle.Sine):Play(); task.wait(1.2)
        end
    end)
end

local function GetMainGui()
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok then return cg end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function playClickSound(volume)
    local s = Instance.new("Sound")
    s.SoundId = CLICK_SOUND_ID
    s.Volume = volume or 1.2
    s.Parent = GetMainGui()
    s:Play()
    Debris:AddItem(s, 1.5)
end
local function playHoverSound(volume)
    local s = Instance.new("Sound")
    s.SoundId = HOVER_SOUND_ID
    s.Volume = volume or 0.5
    s.Parent = GetMainGui()
    s:Play()
    Debris:AddItem(s, 0.8)
end
local function attachClickSound(inst, getVolume)
    if not inst:IsA("TextButton") then return end
    if inst:GetAttribute("SXNT_ClickAttached") then return end
    inst:SetAttribute("SXNT_ClickAttached", true)
    inst.MouseButton1Click:Connect(function()
        local v = 1.2
        if typeof(getVolume) == "function" then v = getVolume() or 1.2 end
        playClickSound(v)
    end)
end

