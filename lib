            if v ~= value then
                value = v
                tw(tgl, 0.2, {BackgroundColor3 = v and C.accent or Color3.fromRGB(55,55,60)})
                tw(kn, 0.2, {Position = v and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)})
                setExpanded(v, true)
                if opts.callback then pcall(opts.callback, v) end
            end
        end, value)
    end

    -- return a small object exposing AddMiniSwitch/AddMiniSlider into `holder`
    local inner = {}
    inner.AddMiniSwitch = function(o) return makeMiniSwitch(holder, o or {}, C, tw, corner) end
