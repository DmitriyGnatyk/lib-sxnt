-- Стан HUD живе в Library._hud (позиції, видимість), тож переживає перестворення вікна і потрапляє в конфіг.
local Hud = { Z = 400, WM_DEFAULT = Vector2.new(16, 16), KB_DEFAULT = Vector2.new(16, 56), GAP = 6 }

function Hud.measure(text, size, bold)
    local ok, v = pcall(function()
        return TextService:GetTextSize(text, size, bold and FONT_BOLD or FONT, Vector2.new(1000, 100))
    end)
    return ok and v.X or (#text * size * 0.58)
end
function Hud.toPx(f, fallback)
    if not f then return fallback end
    local vp = viewport()
    return Vector2.new(f.X * vp.X, f.Y * vp.Y)
end
function Hud.toFrac(p)
    local vp = viewport()
    return Vector2.new(p.X / math.max(vp.X, 1), p.Y / math.max(vp.Y, 1))
end
-- ping: елемент статистики кешується (раніше шукався заново кожні 0.5 с)
function Hud.ping()
    if Hud._pingItem == nil then
        local ok, item = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"] end)
        Hud._pingItem = ok and item or false
    end
    if not Hud._pingItem then return nil end
    local ok, v = pcall(function() return Hud._pingItem:GetValue() end)
    return ok and math.floor(v + 0.5) or nil
end
-- плавне показ/ховання (CanvasGroup)
function Hud.fade(frame, v)
    local tok = (frame:GetAttribute("_ft") or 0) + 1
    frame:SetAttribute("_ft", tok)
    if v then
        if not frame.Visible then frame.GroupTransparency = 1; frame.Visible = true end
        tw(frame, 0.25, { GroupTransparency = 0 })
    else
        tw(frame, 0.2, { GroupTransparency = 1 })
        task.delay(0.22, function()
            if frame.Parent and frame:GetAttribute("_ft") == tok then frame.Visible = false end
        end)
    end
end
-- перетягування мишею/дотиком зі згладжуванням; клік без руху (< 4 px) нічого не робить
function Hud.drag(frame, getPos, apply, clamp)
    frame.InputBegan:Connect(function(input)
        if not isPress(input) or Library._hud.draggable == false then return end
        local startMouse = Vector2.new(input.Position.X, input.Position.Y)
        local startPos = getPos()
        local target, cur, moved = startPos, startPos, false
        local moveConn, stepConn, endConn
        local function finish()
            if not moveConn then return end
            moveConn:Disconnect(); stepConn:Disconnect(); endConn:Disconnect()
            moveConn = nil
            if moved then apply(clamp(target)) end
        end
        moveConn = UserInputService.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or (i.UserInputType == Enum.UserInputType.Touch and i == input) then
                local d = Vector2.new(i.Position.X, i.Position.Y) - startMouse
                if d.Magnitude > 4 then moved = true end
                if moved then target = clamp(startPos + d) end
            end
        end)
        stepConn = RunService.Heartbeat:Connect(function(dt)
            if not moved then return end
            cur = cur:Lerp(target, 1 - math.exp(-30 * dt))
            apply(cur)
        end)
        endConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then finish() end
        end)
    end)
end

-- реєструємо прапори HUD (щоб видимість/режими потрапляли в конфіги й керувались із Library:SetFlag)
function Window:_initHud()
    if self._hudInit then return end
    self._hudInit = true
    local win, hud = self, Library._hud
    local function reg(name, get, set) Library:RegisterFlag(name, get, set, get()) end
    reg("sxnt_wm_visible", function() return hud.wmVisible == true end, function(v) win:SetWatermark(v == true) end)
    reg("sxnt_kb_visible", function() return hud.kbVisible == true end, function(v) win:SetKeybindList(v == true) end)
    reg("sxnt_kb_active_only", function() return hud.kbOnlyActive == true end, function(v) win:SetKeybindOnlyActive(v == true) end)
    reg("sxnt_kb_docked", function() return hud.kbDocked ~= false end, function(v) win:SetKeybindDocked(v == true) end)
    local cam = Workspace.CurrentCamera
    if cam then
        self._track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() win:_hudLayout(true) end))
    end
end

-- позиції: коли список «пристиковано», він стоїть під водяним знаком і рухається разом із ним
function Window:_hudPositions()
    local hud = Library._hud
    local wmPx = Hud.toPx(hud.wmF, Hud.WM_DEFAULT)
    local kbPx
    if hud.kbDocked ~= false then
        local off = 0
        local wm = self._watermark
        if wm and hud.wmVisible then
            local h = wm.Frame.AbsoluteSize.Y
            off = (h > 0 and h or 28) + Hud.GAP
        end
        kbPx = wmPx + Vector2.new(0, off)
    else
        kbPx = Hud.toPx(hud.kbF, Hud.KB_DEFAULT)
    end
    return wmPx, kbPx
end
function Window:_hudLayout(instant)
    local wmPx, kbPx = self:_hudPositions()
    local wm, kb = self._watermark, self._kb
    if wm and wm.Frame.Parent then
        local f = wm.Frame
        local sz = f.AbsoluteSize
        local vp = viewport()
        local p = Vector2.new(math.clamp(wmPx.X, 0, math.max(0, vp.X - sz.X)), math.clamp(wmPx.Y, 0, math.max(0, vp.Y - sz.Y)))
        spSnap(f, "Position", UDim2.fromOffset(p.X, p.Y))
    end
    if kb and kb.Frame.Parent then
        local f = kb.Frame
        local sz = f.AbsoluteSize
        local vp = viewport()
        local p = Vector2.new(math.clamp(kbPx.X, 0, math.max(0, vp.X - sz.X)), math.clamp(kbPx.Y, 0, math.max(0, vp.Y - sz.Y)))
        local target = UDim2.fromOffset(p.X, p.Y)
        if instant then spSnap(f, "Position", target) else sp(f, "Position", target, SPRING.soft) end
    end
end
-- об'єднує десятки змін за кадр в одне оновлення
function Window:_hudRefresh()
    if self._hudDirty or self._destroyed then return end
    self._hudDirty = true
    task.defer(function()
        self._hudDirty = false
        if self._kb and not self._destroyed then self._kb.Refresh() end
    end)
end

-- ── Водяний знак ──
-- opts: text, showFps, showPing, visible, position (Vector2/UDim2, лише якщо ще не збережено), draggable
function Window:AddWatermark(opts)
    opts = opts or {}
    local win = self
    local ui = self.ScreenGui
    if not ui or not ui.Parent then return end
    self:_initHud()
    local hud = Library._hud
    if self._watermark then pcall(function() self._watermark.Destroy() end) end
    local brand = tostring(opts.text or "SXNT")
    local showFps, showPing = opts.showFps ~= false, opts.showPing ~= false
    if hud.wmVisible == nil then hud.wmVisible = opts.visible ~= false end
    if opts.draggable ~= nil and hud.draggable == nil then hud.draggable = opts.draggable ~= false end
    if opts.position and not hud.wmF then
        local p = opts.position
        if typeof(p) == "UDim2" then p = Vector2.new(p.X.Offset, p.Y.Offset) end
        if typeof(p) == "Vector2" then hud.wmF = Hud.toFrac(p) end
    end

    local frame = new("CanvasGroup", {
        Name = "Watermark", Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(0, 28),
        AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.bg, BackgroundTransparency = 0.12,
        BorderSizePixel = 0, ZIndex = Hud.Z, Visible = hud.wmVisible, GroupTransparency = hud.wmVisible and 0 or 1, Active = true,
    }, ui)
    corner(frame, 10)
    local st = stroke(frame, WHITE, 1.2, 0.25)
    local sg = gradient(st, Theme.accent, Theme.accent2, 0)
    new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, frame)
    local lbl = label(frame, "", 12, Theme.text, {
        _font = "b", Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, RichText = true,
    })
    local fps, ping = 0, nil
    local function refresh()
        local a, m = Theme.accent:ToHex(), Theme.muted:ToHex()
        local txt = string.format('<font color="#%s">%s</font>', a, brand)
        if showFps then txt ..= string.format('  <font color="#%s">|</font>  %d fps', m, fps) end
        if showPing and ping then txt ..= string.format('  <font color="#%s">|</font>  %d ms', m, ping) end
        lbl.Text = txt
    end

    -- лічильник FPS працює лише поки знак видимий
    local statConn
    local function startStats()
        if statConn or not (showFps or showPing) then return end
        local acc, frames = 0, 0
        statConn = RunService.Heartbeat:Connect(function(dt)
            acc += dt; frames += 1
            if acc >= 0.5 then
                fps = math.floor(frames / acc + 0.5); frames = 0; acc = 0
                if showPing then ping = Hud.ping() end
                refresh()
            end
        end)
    end
    local function stopStats()
        if statConn then statConn:Disconnect(); statConn = nil end
    end
    if hud.wmVisible then startStats() end
    refresh()
    win:_hudLayout(true)
    lbl:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() win:_hudLayout(true) end)

    -- перетягування (разом зі списком біндів, якщо він пристикований)
    local function groupSize()
        local sz = frame.AbsoluteSize
        local w, h = sz.X, sz.Y
        if hud.kbDocked ~= false and win._kb and hud.kbVisible then
            local ks = win._kb.Frame.AbsoluteSize
            w = math.max(w, ks.X); h = h + Hud.GAP + ks.Y
        end
        return w, h
    end
    Hud.drag(frame, function() return Hud.toPx(hud.wmF, Hud.WM_DEFAULT) end, function(p)
        hud.wmF = Hud.toFrac(p); win:_hudLayout(true)
    end, function(p)
        local vp = viewport()
        local w, h = groupSize()
        return Vector2.new(math.clamp(p.X, 0, math.max(0, vp.X - w)), math.clamp(p.Y, 0, math.max(0, vp.Y - h)))
    end)

    win._onTheme(function()
        setGrad(sg, Theme.accent, Theme.accent2); tw(frame, 0.3, { BackgroundColor3 = Theme.bg }); refresh()
    end)
    table.insert(win._fontHooks, function() task.defer(function() refresh(); win:_hudLayout(true) end) end)

    local api = { Frame = frame }
    function api.SetVisible(_, v)
        v = v and true or false
        hud.wmVisible = v
        Hud.fade(frame, v)
        if v then startStats(); refresh() else stopStats() end
        win:_hudLayout(false)
        Library:_commit("sxnt_wm_visible", v)
    end
    function api.Destroy()
        stopStats()
        if frame.Parent then frame:Destroy() end
        if win._watermark == api then win._watermark = nil end
    end
    frame.Destroying:Connect(stopStats)
    self._watermark = api
    Library:_commit("sxnt_wm_visible", hud.wmVisible == true)
    return api
end
function Window:SetWatermark(v, opts)
    v = v and true or false
    if v then
        if self._watermark and self._watermark.Frame.Parent then self._watermark:SetVisible(true)
        else Library._hud.wmVisible = true; self:AddWatermark(opts); Library:_commit("sxnt_wm_visible", true) end
    else
        if self._watermark and self._watermark.Frame.Parent then self._watermark:SetVisible(false)
        else Library._hud.wmVisible = false; Library:_commit("sxnt_wm_visible", false) end
    end
end
function Window:IsWatermarkVisible() return Library._hud.wmVisible == true and self._watermark ~= nil end

-- ── Список біндів ──
-- opts: visible, title, onlyActive (показувати лише ввімкнені), docked (стик під водяним знаком)
function Window:AddKeybindList(opts)
    opts = opts or {}
    local win = self
    local ui = self.ScreenGui
    if not ui or not ui.Parent then return end
    self:_initHud()
    self:_initBinds()
    local hud = Library._hud
    if self._kb then pcall(function() self._kb.Destroy() end) end
    if hud.kbVisible == nil then hud.kbVisible = opts.visible ~= false end
    if hud.kbOnlyActive == nil then hud.kbOnlyActive = opts.onlyActive == true end
    if hud.kbDocked == nil then hud.kbDocked = opts.docked ~= false end

    local frame = new("CanvasGroup", {
        Name = "KeybindList", Size = UDim2.fromOffset(150, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.bg, BackgroundTransparency = 0.12, BorderSizePixel = 0, ZIndex = Hud.Z,
        Visible = false, GroupTransparency = 1, Active = true,
    }, ui)
    corner(frame, 10)
    local st = stroke(frame, WHITE, 1.2, 0.25)
    local sg = gradient(st, Theme.accent, Theme.accent2, 0)
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, frame)
    new("UIPadding", { PaddingBottom = UDim.new(0, 5) }, frame)
    local header = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 0 }, frame)
    local titleKey = opts.title == nil
    local title = label(header, opts.title or T("hud_keybinds"), 11, Theme.accent, {
        _font = "b", Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
    })
    local line = new("Frame", { Position = UDim2.new(0, 8, 1, -1), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, header)
    local lineGrad = gradient(line, Theme.accent, Theme.accent2, 0)
    new("UIGradient", { Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1),
    }) }, line)

    local ROW_H = 20
    local rows = {}
    local shownNow = false

    local function styleRow(r, active, animate)
        local d = animate and 0.2 or 0
        tw(r.dot, d, { BackgroundColor3 = active and Theme.accent or Theme.muted, BackgroundTransparency = active and 0 or 0.45 })
        tw(r.name, d, { TextColor3 = active and Theme.text or Theme.muted })
        tw(r.key, d, { TextColor3 = active and Theme.accent or Theme.muted })
        r.active = active
    end
    local function makeRow(b)
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true, BorderSizePixel = 0,
        }, frame)
        local dot = new("Frame", {
            Size = UDim2.fromOffset(6, 6), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 11, 0.5, 0),
            BackgroundColor3 = Theme.muted, BorderSizePixel = 0,
        }, row)
        corner(dot, 999)
        local name = label(row, "", 12, Theme.muted, { Position = UDim2.fromOffset(25, 0), Size = UDim2.new(1, -60, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
        local key = label(row, "", 11, Theme.muted, {
            _font = "b", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(40, ROW_H),
            TextXAlignment = RIGHT,
        })
        local r = { frame = row, dot = dot, name = name, key = key, active = false }
        sp(row, "Size", UDim2.new(1, 0, 0, ROW_H), SPRING.soft)
        return r
    end
    local function removeRow(b, r)
        rows[b] = nil
        sp(r.frame, "Size", UDim2.new(1, 0, 0, 0), SPRING.smooth)
        tw(r.name, 0.18, { TextTransparency = 1 }); tw(r.key, 0.18, { TextTransparency = 1 }); tw(r.dot, 0.18, { BackgroundTransparency = 1 })
        task.delay(0.35, function() if r.frame.Parent then r.frame:Destroy() end end)
    end

    local curW
    local function refresh()
        if not frame.Parent then return end
        local now = os.clock()
        local want, count = {}, 0
        for i, b in ipairs(win._binds or {}) do
            if b.list and b.n > 0 and b.enabled then
                local active
                if b.mode == "press" then active = (now - b.flash) < 0.35 else active = b.active end
                if not hud.kbOnlyActive or active then want[b] = { order = i, active = active }; count += 1 end
            end
        end
        for b, r in pairs(table.clone(rows)) do
            if not want[b] then removeRow(b, r) end
        end
        local w = math.max(150, Hud.measure(title.Text, 11, true) + 24)
        for b, info in pairs(want) do
            local r = rows[b]
            local fresh = r == nil
            if fresh then r = makeRow(b); rows[b] = r end
            local keyTxt = comboText(b.keys) or ""
            local keyW = Hud.measure(keyTxt, 11, true)
            r.name.Text = b.name
            r.key.Text = keyTxt
            r.key.Size = UDim2.fromOffset(keyW + 2, ROW_H)
            r.name.Size = UDim2.new(1, -(25 + keyW + 22), 1, 0)
            r.frame.LayoutOrder = info.order
            if fresh then styleRow(r, info.active, false) elseif r.active ~= info.active then styleRow(r, info.active, true) end
            w = math.max(w, 25 + Hud.measure(b.name, 12, false) + 18 + keyW + 12)
        end
        if curW ~= w then
            if curW == nil or not shownNow then spSnap(frame, "Size", UDim2.fromOffset(w, 0)) else sp(frame, "Size", UDim2.fromOffset(w, 0), SPRING.soft) end
            curW = w
        end
        local show = hud.kbVisible == true and count > 0
        if show ~= shownNow then
            shownNow = show
            Hud.fade(frame, show)
            win:_hudLayout(true)
        end
    end
    local function clampPx(p, w, h)
        local vp = viewport()
        return Vector2.new(math.clamp(p.X, 0, math.max(0, vp.X - w)), math.clamp(p.Y, 0, math.max(0, vp.Y - h)))
    end
    -- перетягування: якщо пристиковано — рухає всю групу (водяний знак + список), інакше лише список
    Hud.drag(frame, function() local _, kbPx = win:_hudPositions(); return kbPx end, function(p)
        if hud.kbDocked ~= false then
            local wmPx, kbPx = win:_hudPositions()
            hud.wmF = Hud.toFrac(p - (kbPx - wmPx))
        else
            hud.kbF = Hud.toFrac(p)
        end
        win:_hudLayout(true)
    end, function(p)
        local sz = frame.AbsoluteSize
        if hud.kbDocked ~= false then
            local wmPx, kbPx = win:_hudPositions()
            local off = kbPx - wmPx
            local wmW = (win._watermark and hud.wmVisible) and win._watermark.Frame.AbsoluteSize.X or 0
            return clampPx(p - off, math.max(sz.X, wmW), sz.Y + off.Y) + off
        end
        return clampPx(p, sz.X, sz.Y)
    end)

    win._onTheme(function()
        setGrad(sg, Theme.accent, Theme.accent2); setGrad(lineGrad, Theme.accent, Theme.accent2)
        tw(frame, 0.3, { BackgroundColor3 = Theme.bg }); title.TextColor3 = Theme.accent
        for _, r in pairs(rows) do styleRow(r, r.active, true) end
    end)
    table.insert(win._fontHooks, function() curW = nil; task.defer(refresh) end)
    table.insert(win._textElements, { type = "custom", update = function()
        if titleKey then title.Text = T("hud_keybinds") end
        curW = nil; refresh()
    end })

    local api = { Frame = frame, Refresh = refresh }
    function api.SetVisible(_, v)
        hud.kbVisible = v and true or false
        refresh(); Library:_commit("sxnt_kb_visible", hud.kbVisible)
    end
    function api.Destroy()
        if frame.Parent then frame:Destroy() end
        if win._kb == api then win._kb = nil end
    end
    self._kb = api
    refresh()
    win:_hudLayout(true)
    Library:_commit("sxnt_kb_visible", hud.kbVisible == true)
    return api
end
function Window:SetKeybindList(v)
    v = v and true or false
    Library._hud.kbVisible = v
    if self._kb then self._kb:SetVisible(v)
    elseif v and self._binds and #self._binds > 0 then self:AddKeybindList({ visible = true })
    else Library:_commit("sxnt_kb_visible", v) end
end
function Window:IsKeybindListVisible() return Library._hud.kbVisible == true end
function Window:SetKeybindOnlyActive(v)
    Library._hud.kbOnlyActive = v and true or false
    Library:_commit("sxnt_kb_active_only", Library._hud.kbOnlyActive)
    self:_hudRefresh()
end
function Window:SetKeybindDocked(v)
    local hud = Library._hud
    v = v and true or false
    if v and hud.kbDocked == false then hud.kbF = nil end
    if not v and hud.kbDocked ~= false and self._kb then   -- відстикувати: лишаємо список на місці
        local _, kbPx = self:_hudPositions()
        hud.kbF = Hud.toFrac(kbPx)
    end
    hud.kbDocked = v
    Library:_commit("sxnt_kb_docked", v)
    self:_hudLayout(false)
end
function Window:SetHudDraggable(v) Library._hud.draggable = v ~= false end
function Window:IsHudDraggable() return Library._hud.draggable ~= false end
-- повернути позиції за замовчуванням і пристикувати список
function Window:ResetHud()
    local hud = Library._hud
    hud.wmF, hud.kbF = nil, nil
    self:SetKeybindDocked(true)
    self:_hudLayout(false)
end

function Window:SetBlur(v) if self._setBlur then self._setBlur(v) end end
function Window:GetBlur() return self._getBlur and self._getBlur() or false end

-- ═══════════════════════════════════════════════════════════
--  v3: КОНФІГИ (потрібен executor з writefile / readfile)
-- ═══════════════════════════════════════════════════════════
local HttpService = game:GetService("HttpService")
Library.ConfigFolder = "SXNT"
Library.ConfigIgnore = {}      -- [flag] = true — не зберігати цей прапор

local function fsAvailable()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end
local function cfgName(name) return (tostring(name or ""):gsub("[^%w_%-\128-\255]", "")) end
local function cfgPath(name) return Library.ConfigFolder .. "/" .. cfgName(name) .. ".json" end
local function ensureFolder()
    if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
        pcall(function() if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end end)
    end
end

Library.ConfigSaveHud = true          -- зберігати позиції водяного знака / списку біндів
Library.ConfigSaveAppearance = true   -- зберігати тему / шрифт / мову разом із прапорами
function Library:ExportConfig()
    local out = {}
    if Library.ConfigSaveAppearance then
        out.__theme, out.__font, out.__language = currentThemeName, currentFontName, currentLang
    end
    for name in pairs(Flags) do
        local skip = (name == "sxnt_theme" or name == "sxnt_font") and not Library.ConfigSaveAppearance
        if not Library.ConfigIgnore[name] and not skip then
            local v = Library:GetFlag(name)
            local t = typeof(v)
            if t == "boolean" or t == "number" or t == "string" then out[name] = v
            elseif t == "Color3" then out[name] = "#" .. toHex(v) end   -- v4: кольори зберігаються як "#RRGGBB"
        end
    end
    if Library.ConfigSaveHud ~= false then
        local h, hp = Library._hud, {}
        if h.wmF then hp.wm = { h.wmF.X, h.wmF.Y } end
        if h.kbF then hp.kb = { h.kbF.X, h.kbF.Y } end
        if next(hp) then out.__hud = hp end
    end
    return out
end
function Library:ImportConfig(tbl)
    if type(tbl) ~= "table" then return 0 end
    local n = 0
    if Library.ConfigSaveAppearance then
        if type(tbl.__theme) == "string" and THEMES[tbl.__theme] and tbl.__theme ~= currentThemeName then Library:SetTheme(tbl.__theme) end
        if type(tbl.__font) == "string" and FONT_DEFS[tbl.__font] and tbl.__font ~= currentFontName then Library:SetFont(tbl.__font) end
        if type(tbl.__language) == "string" and (VALID_LANGS[tbl.__language] or L[tbl.__language]) and tbl.__language ~= currentLang then
            Library:SetLanguage(tbl.__language)
        end
    end
    for name, v in pairs(tbl) do
        local skip = (name == "sxnt_theme" or name == "sxnt_font") and not Library.ConfigSaveAppearance
        if Flags[name] and not Library.ConfigIgnore[name] and not skip then Library:SetFlag(name, v); n += 1 end
    end
    -- позиції HUD застосовуємо після прапорів (прапор «пристикувати» міг змінити їх)
    if Library.ConfigSaveHud ~= false and type(tbl.__hud) == "table" then
        local h = Library._hud
        local function v2(a)
            if type(a) == "table" and tonumber(a[1]) and tonumber(a[2]) then
                return Vector2.new(math.clamp(a[1], 0, 1), math.clamp(a[2], 0, 1))
            end
        end
        h.wmF = v2(tbl.__hud.wm) or h.wmF
        h.kbF = v2(tbl.__hud.kb) or h.kbF
        for _, w in ipairs(table.clone(Library._windows)) do
            if w._hudLayout then pcall(function() w:_hudLayout(true) end) end
        end
    end
    return n
end
function Library:SaveConfig(name)
    if cfgName(name) == "" then return false, "empty name" end
    if not fsAvailable() then return false, "filesystem unavailable" end
    ensureFolder()
    local ok, err = pcall(function() writefile(cfgPath(name), HttpService:JSONEncode(Library:ExportConfig())) end)
    return ok, (not ok) and tostring(err) or nil
end
function Library:LoadConfig(name)
    if cfgName(name) == "" then return false, "empty name" end
    if not fsAvailable() then return false, "filesystem unavailable" end
    local okE, exists = pcall(isfile, cfgPath(name))
    if not (okE and exists) then return false, "not found" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
    if not ok then return false, "bad json" end
    return true, Library:ImportConfig(data)
end
function Library:ListConfigs()
    local out = {}
    if typeof(listfiles) ~= "function" then return out end
    ensureFolder()
    local ok, files = pcall(listfiles, Library.ConfigFolder)
    if not ok or type(files) ~= "table" then return out end
    for _, path in ipairs(files) do
        local n = tostring(path):match("([^/\\]+)%.json$")
        if n then out[#out + 1] = n end
    end
    table.sort(out)
    return out
end
function Library:DeleteConfig(name)
    if typeof(delfile) ~= "function" or cfgName(name) == "" then return false end
    local ok = pcall(delfile, cfgPath(name))
    if ok and Library:GetAutoload() == cfgName(name) then   -- не лишаємо autoload на неіснуючий конфіг
        local p = Library.ConfigFolder .. "/autoload.txt"
        if not pcall(delfile, p) then pcall(writefile, p, "") end
    end
    return ok
end
function Library:SetAutoload(name)
    if not fsAvailable() then return false end
    ensureFolder()
    return (pcall(writefile, Library.ConfigFolder .. "/autoload.txt", cfgName(name)))
end
function Library:GetAutoload()
    if not fsAvailable() then return nil end
    local p = Library.ConfigFolder .. "/autoload.txt"
    local okE, exists = pcall(isfile, p)
    if not (okE and exists) then return nil end
    local ok, v = pcall(readfile, p)
    v = ok and cfgName(v) or ""
    return v ~= "" and v or nil
end
function Library:AutoLoad()
    local n = Library:GetAutoload()
    if n then return Library:LoadConfig(n) end
    return false, "no autoload"
end


