function Tab:AddSubTab(name)
    name = tostring(name or "General")
    local win = self._window

    -- спільний ряд "пілюль" з ковзним індикатором
    if not self._pillRow then
        local row = new("Frame", { Name = "PillRow", Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = -1 }, self._frame)
        local ind = new("Frame", {
            Name = "Indicator", Size = UDim2.fromOffset(0, 26), Position = UDim2.fromOffset(0, 1),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, Visible = false, ZIndex = 1,
        }, row)
        corner(ind, 8)
        local indGrad = gradient(ind, Theme.accent, Theme.accent2, 0)
        local list = new("Frame", { Name = "Pills", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, row)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center,
        }, list)
        self._pillRow, self._pillList, self._pillInd = row, list, ind
        win._onTheme(function() setGrad(indGrad, Theme.accent, Theme.accent2) end)
    end
    local row, ind = self._pillRow, self._pillInd

    local function syncIndicator(animate)
        local active = self._activeSub
        if not active then return end
        local pill = active._pill
        local sc = win._scale()
        local w = pill.AbsoluteSize.X / sc
        if w <= 0 then return end
        local x = (pill.AbsolutePosition.X - row.AbsolutePosition.X) / sc
        ind.Visible = true
        if animate then
            sp(ind, "Position", UDim2.fromOffset(x, 1), SPRING.soft)
            sp(ind, "Size", UDim2.fromOffset(w, 26), SPRING.soft)
        else
            if math.abs(ind.Position.X.Offset - x) > 0.4 or math.abs(ind.Size.X.Offset - w) > 0.4 then
                spSnap(ind, "Position", UDim2.fromOffset(x, 1)); spSnap(ind, "Size", UDim2.fromOffset(w, 26))
            end
        end
    end

    local pill = new("TextButton", {
        Text = name, _font = "r", TextSize = 12, TextColor3 = Theme.muted, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0,
        AutoButtonColor = false, LayoutOrder = #self._subTabs + 1, ZIndex = 2,
    }, self._pillList)
    corner(pill, 8)
    new("UIPadding", { PaddingLeft = UDim.new(0, 13), PaddingRight = UDim.new(0, 13) }, pill)

    local page = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Visible = false, LayoutOrder = 0,
    }, self._frame)
    new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, page)

    local subObj = setmetatable({
        _tab = self, _window = win, _pill = pill, _page = page, _container = page,
        _C = Theme, _tw = tw, _corner = corner, _stroke = stroke, _LO = self._LO,
    }, SubTab)

    local st = { hover = false, down = false }
    local function renderPill()
        local active = self._activeSub == subObj
        tw(pill, 0.2, { TextColor3 = active and Theme.onAccent or (st.hover and Theme.text or Theme.muted) })
    end
    interact(pill, st, renderPill)
    subObj._renderPill = renderPill
    win._onTheme(renderPill)

    pill:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if self._activeSub == subObj then syncIndicator(false) end
    end)
    pill:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if self._activeSub == subObj then syncIndicator(false) end
    end)

    local function select()
        if self._activeSub == subObj then return end
        local prev = self._activeSub
        if win._currentExpanded then pcall(win._currentExpanded) end
        self._activeSub = subObj
        if prev then prev._page.Visible = false; prev._renderPill() end
        page.Visible = true
        renderPill()
        syncIndicator(prev ~= nil)
        if prev and self._wrap then
            self._wrap.GroupTransparency = 0.6
            tw(self._wrap, 0.45, { GroupTransparency = 0 })
            local wsc = win._tabScales[self._index]
            if wsc then spSnap(wsc, "Scale", 0.985); sp(wsc, "Scale", 1, SPRING.soft) end
        end
    end
    subObj._select = select
    pill.MouseButton1Click:Connect(select)

    table.insert(self._subTabs, subObj)
    if not self._activeSub then select() end
    return subObj
end

