function SubTab:AddSlider(opts)
    opts = opts or {}
    local C = self._C
    local tw = self._tw
    local corner = self._corner
    local stroke = self._stroke
    local flag = opts.flag
    local minV = tonumber(opts.min) or 0
    local maxV = tonumber(opts.max) or 100
    local step = tonumber(opts.step) or 1
    local suffix = tostring(opts.suffix or "")
    local value = math.clamp(tonumber(opts.default) or minV, minV, maxV)

    local frame = Instance.new("Frame", self._container)
    frame.Size = UDim2.new(1,0,0,50)
    frame.BackgroundColor3 = C.card
    frame.BorderSizePixel = 0; corner(frame, 10); stroke(frame, C.border, 1)
    frame.LayoutOrder = self._LO()

    local lbl = Instance.new("TextLabel", frame)
    lbl.Font = Enum.Font.Cartoon; lbl.TextColor3 = C.text; lbl.TextSize = 13
    lbl.Position = UDim2.new(0,12,0,4); lbl.Size = UDim2.new(0.6,0,0,20)
    lbl.BackgroundTransparency = 1; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = tostring(opts.name or flag or "Slider") .. ": "

    local valLbl = Instance.new("TextLabel", frame)
    valLbl.Font = Enum.Font.Cartoon; valLbl.TextColor3 = C.accent; valLbl.TextSize = 13
    valLbl.Position = UDim2.new(0.7,0,0,4); valLbl.Size = UDim2.new(0.3,-12,0,20)
    valLbl.BackgroundTransparency = 1; valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("TextButton", frame)
    track.Text = ""; track.Size = UDim2.new(1,-24,0,10); track.Position = UDim2.new(0,12,0,32)
    track.BackgroundColor3 = Color3.fromRGB(45,45,50); track.BorderSizePixel = 0
    corner(track, 5); track.AutoButtonColor = false

    local initRatio = (value - minV) / (maxV - minV)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = C.accent; fill.BorderSizePixel = 0; corner(fill, 5)

    local handle = Instance.new("TextButton", track)
    handle.Text = ""; handle.Size = UDim2.new(0,20,0,20)
    handle.Position = UDim2.new(initRatio, -10, 0.5, -10)
    handle.BackgroundColor3 = Color3.new(1,1,1); handle.BorderSizePixel = 0
    corner(handle, 10); stroke(handle, C.accent, 1.5); handle.AutoButtonColor = false

    local function formatVal(v)
        if v == math.floor(v) then return tostring(math.floor(v)) .. suffix end
        local str = string.format("%.2f", v):gsub("0+$",""):gsub("%.$","")
        return str .. suffix
    end
    valLbl.Text = formatVal(value)

    local function setVal(relX, width)
        if width <= 0 then return end
        local p = math.clamp(relX / width, 0, 1)
        local raw = minV + p * (maxV - minV)
        local val = math.floor(raw / step + 0.5) * step
        val = math.clamp(val, minV, maxV)
        value = val
        fill.Size = UDim2.new(p, 0, 1, 0)
        handle.Position = UDim2.new(p, -10, 0.5, -10)
        valLbl.Text = formatVal(value)
        if opts.callback then pcall(opts.callback, value) end
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            local sf = self._container:FindFirstAncestorWhichIsA("ScrollingFrame")
            if sf then sf.ScrollingEnabled = false end
            self._window._sliderDragState = {track = track, setValue = setVal, scrollFrame = sf}
            setVal(inp.Position.X - track.AbsolutePosition.X, track.AbsoluteSize.X)
        end
    end)
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            local sf = self._container:FindFirstAncestorWhichIsA("ScrollingFrame")
            if sf then sf.ScrollingEnabled = false end
            self._window._sliderDragState = {track = track, setValue = setVal, scrollFrame = sf}
            setVal(inp.Position.X - track.AbsolutePosition.X, track.AbsoluteSize.X)
        end
    end)

    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v)
            v = math.clamp(tonumber(v) or value, minV, maxV)
            value = v
            local p = (v - minV) / (maxV - minV)
            fill.Size = UDim2.new(p, 0, 1, 0)
            handle.Position = UDim2.new(p, -10, 0.5, -10)
            valLbl.Text = formatVal(v)
            if opts.callback then pcall(opts.callback, v) end
        end, value)
    end
    return track
end

function SubTab:AddDropdown(opts)
    opts = opts or {}
    local C = self._C
    local tw = self._tw
    local corner = self._corner
    local stroke = self._stroke
    local flag = opts.flag
    local options = opts.options or opts.items or {}
    local value = opts.default or options[1]
    local getValue = opts.getValue
    local setValue = opts.setValue

    local frame = Instance.new("Frame", self._container)
    frame.Size = UDim2.new(1,0,0,32)
    frame.BackgroundColor3 = C.card
    frame.BorderSizePixel = 0; frame.ClipsDescendants = true
    corner(frame, 8); stroke(frame, C.border, 1)
    frame.LayoutOrder = self._LO()

    local lbl = Instance.new("TextLabel", frame)
    lbl.Text = tostring(opts.name or flag or "Dropdown")
    lbl.Font = Enum.Font.Cartoon; lbl.TextSize = 13; lbl.TextColor3 = C.text
    lbl.Size = UDim2.new(0.4,-12,0,32); lbl.Position = UDim2.new(0,10,0,0)
    lbl.BackgroundTransparency = 1; lbl.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", frame)
    btn.Text = "▼ " .. tostring(value); btn.Font = Enum.Font.Cartoon; btn.TextSize = 12
    btn.TextColor3 = Color3.new(1,1,1); btn.Size = UDim2.new(0.6,-16,0,28)
    btn.Position = UDim2.new(0.4,6,0,2); btn.BackgroundColor3 = Color3.fromRGB(35,35,40)
    btn.BorderSizePixel = 0; corner(btn, 6); btn.AutoButtonColor = false

    local holder, expanded = nil, false
    local win = self._window

    local function collapse()
        if win._currentExpanded == collapse then win._currentExpanded = nil end
        if holder then holder:Destroy(); holder = nil end
        expanded = false
        tw(frame, 0.2, {Size = UDim2.new(1,0,0,32)})
        task.delay(0.2, function() if frame and not expanded then frame.ClipsDescendants = true end end)
    end

    local function expand()
        if win._currentExpanded then win._currentExpanded(); win._currentExpanded = nil end
        win._currentExpanded = collapse
        if expanded then return end
        expanded = true; frame.ClipsDescendants = false
        local itemH = 26; local pad = 2
        local vis = math.min(#options, 6)
        local totalH = vis*(itemH+pad) + pad + 4
        holder = Instance.new("Frame", frame)
        holder.Size = UDim2.new(1,-8,0,totalH); holder.Position = UDim2.new(0,4,0,34)
        holder.BackgroundTransparency = 1; holder.ZIndex = 10
        local scroll = Instance.new("ScrollingFrame", holder)
        scroll.Size = UDim2.new(1,0,1,0); scroll.BackgroundTransparency = 1
        scroll.ScrollBarThickness = 3; scroll.ScrollBarImageColor3 = C.accent
        scroll.CanvasSize = UDim2.new(0,0,0,#options*(itemH+pad)); scroll.ZIndex = 10
        local lay = Instance.new("UIListLayout", scroll); lay.Padding = UDim.new(0,pad)
        for _, opt in ipairs(options) do
            local ob = Instance.new("TextButton", scroll)
            ob.Text = tostring(opt); ob.Font = Enum.Font.Cartoon; ob.TextSize = 12
            ob.TextColor3 = Color3.new(1,1,1); ob.Size = UDim2.new(1,-4,0,itemH)
            ob.BackgroundColor3 = Color3.fromRGB(35,35,40); ob.BorderSizePixel = 0
            corner(ob, 4); ob.ZIndex = 10; ob.AutoButtonColor = false
            ob.MouseEnter:Connect(function() tw(ob, 0.1, {BackgroundColor3 = C.accent}) end)
            ob.MouseLeave:Connect(function() tw(ob, 0.1, {BackgroundColor3 = Color3.fromRGB(35,35,40)}) end)
            ob.MouseButton1Click:Connect(function()
                value = opt
                btn.Text = "▼ " .. tostring(opt)
                if setValue then pcall(setValue, opt) end
                if opts.callback then pcall(opts.callback, opt) end
                if flag then Library:SetFlag(flag, opt) end
                collapse()
            end)
        end
        tw(frame, 0.25, {Size = UDim2.new(1,0,0,32+totalH+8)})
    end
    btn.MouseButton1Click:Connect(function() if expanded then collapse() else expand() end end)

    local api = {}
    api.SetOptions = function(_, newOptions, newCurrent)
        options = newOptions or {}
        if newCurrent then value = newCurrent end
        btn.Text = "▼ " .. tostring(value)
    end
    api.Get = function() return value end
    api.Set = function(_, v) value = v; btn.Text = "▼ " .. tostring(v); if opts.callback then pcall(opts.callback, v) end end

    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v) api.Set(nil, v) end, value)
    end
    return api
end

