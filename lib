-- Активна тема (змінне дзеркало; усі компоненти читають звідси)
local Theme = {}
local currentThemeName = "Ice"
local BLACK = Color3.new(0, 0, 0)
local accentOv = nil   -- v4: користувацький акцент поверх теми
local function applyThemeToMirror(name)
    local t = getTheme(name)
    for k in pairs(Theme) do Theme[k] = nil end
    for k, v in pairs(t) do Theme[k] = v end
    -- світла чи темна тема: від цього залежить напрям підсвічування (hover) і натискання
    local b = t.bg
    Theme.light = t.light ~= nil and t.light or ((0.299 * b.R + 0.587 * b.G + 0.114 * b.B) > 0.55)
    Theme.tint  = Theme.light and BLACK or WHITE
    -- похідні кольори (можна не вказувати у власних темах)
    Theme.cardHover = t.cardHover or t.card:Lerp(Theme.tint, Theme.light and 0.04 or 0.05)
    Theme.card2     = t.card2     or t.card:Lerp(Theme.tint, Theme.light and 0.03 or 0.045)
    Theme.track     = t.track     or t.bg:Lerp(Theme.tint, Theme.light and 0.10 or 0.16)
    Theme.amber     = t.amber     or Color3.fromRGB(255, 185, 70)
    local a = t.accent
    local lum = 0.299 * a.R + 0.587 * a.G + 0.114 * a.B
    Theme.onAccent  = t.onAccent  or (lum > 0.6 and Color3.fromRGB(16, 16, 22) or WHITE)
    if accentOv then
        Theme.accent, Theme.accent2 = accentOv[1], accentOv[2]
        local ac = accentOv[1]
        local l2 = 0.299 * ac.R + 0.587 * ac.G + 0.114 * ac.B
        Theme.onAccent = l2 > 0.6 and Color3.fromRGB(16, 16, 22) or WHITE
    end
    currentThemeName = THEMES[name] and name or "Ice"
end
applyThemeToMirror("Ice")

