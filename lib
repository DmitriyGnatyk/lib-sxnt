local warnedAt = {}
local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        local key = tostring(err)
        local now = os.clock()
        if not warnedAt[key] or now - warnedAt[key] > 5 then
            warnedAt[key] = now
            warn("[SXNT] помилка в колбеку: " .. key)
        end
    end
    return ok
end
