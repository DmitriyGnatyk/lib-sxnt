    local step = tonumber(opts.step) or 1
    local suffix = tostring(opts.suffix or "")
    local value = math.clamp(tonumber(opts.default) or minV, minV, maxV)

    local mini = Instance.new("Frame", parent)
    mini.Size = UDim2.new(1, 0, 0, 44)
    mini.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
    mini.BorderSizePixel = 0; corner(mini, 8)

    local lbl = Instance.new("TextLabel", mini)
    lbl.Font = Enum.Font.Cartoon; lbl.TextColor3 = C.text; lbl.TextSize = 11
    lbl.Position = UDim2.new(0, 10, 0, 4); lbl.Size = UDim2.new(0.6, 0, 0, 16)
    lbl.BackgroundTransparency = 1; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = tostring(opts.name or flag or "Slider") .. ": "

    local valLbl = Instance.new("TextLabel", mini)
    valLbl.Font = Enum.Font.Cartoon; valLbl.TextColor3 = C.accent; valLbl.TextSize = 11
    valLbl.Position = UDim2.new(0.7, 0, 0, 4); valLbl.Size = UDim2.new(0.3, -10, 0, 16)
    valLbl.BackgroundTransparency = 1; valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("TextButton", mini)
    track.Text = ""; track.Size = UDim2.new(1,-20,0,8); track.Position = UDim2.new(0,10,0,26)
    track.BackgroundColor3 = Color3.fromRGB(45,45,50); track.BorderSizePixel = 0
    corner(track, 4); track.AutoButtonColor = false

    local initRatio = (value - minV) / (maxV - minV)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = C.accent; fill.BorderSizePixel = 0; corner(fill, 4)

    local handle = Instance.new("TextButton", track)
    handle.Text = ""; handle.Size = UDim2.new(0,16,0,16)
    handle.Position = UDim2.new(initRatio, -8, 0.5, -8)
    handle.BackgroundColor3 = Color3.new(1,1,1); handle.BorderSizePixel = 0
    corner(handle, 8); stroke(handle, C.accent, 1.5); handle.AutoButtonColor = false

    local function fmt(v)
        if v == math.floor(v) then return tostring(math.floor(v)) .. suffix end
        return string.format("%.2f", v):gsub("0+$",""):gsub("%.$","") .. suffix
    end
    valLbl.Text = fmt(value)

    local function setVal(relX, width)
        if width <= 0 then return end
        local p = math.clamp(relX / width, 0, 1)
        local raw = minV + p * (maxV - minV)
        value = math.clamp(math.floor(raw / step + 0.5) * step, minV, maxV)
        fill.Size = UDim2.new(p, 0, 1, 0)
        handle.Position = UDim2.new(p, -8, 0.5, -8)
        valLbl.Text = fmt(value)
        if opts.callback then pcall(opts.callback, value) end
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            local sf = mini:FindFirstAncestorWhichIsA("ScrollingFrame")
            local win = parent:FindFirstAncestorWhichIsA("ScreenGui")
            -- fallback: try to attach through window state, but keep it simple
            setVal(inp.Position.X - track.AbsolutePosition.X, track.AbsoluteSize.X)
        end
    end)
    handle.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            setVal(inp.Position.X - track.AbsolutePosition.X, track.AbsoluteSize.X)
        end
    end)

    if flag then
        Library:RegisterFlag(flag, function() return value end, function(v)
            v = math.clamp(tonumber(v) or value, minV, maxV)
            value = v
            local p = (v - minV) / (maxV - minV)
            fill.Size = UDim2.new(p, 0, 1, 0)
            handle.Position = UDim2.new(p, -8, 0.5, -8)
            valLbl.Text = fmt(v)
            if opts.callback then pcall(opts.callback, v) end
        end, value)
    end
    return mini
end

