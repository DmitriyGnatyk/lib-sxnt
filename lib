function Window:AddTab(opts)
    if type(opts) == "string" then opts = { name = opts } end
    opts = opts or {}
    return self._createTab(opts.icon or "◉", opts.key or opts.name or "tab", opts.name)
end

function Window:SelectTab(index)
    if self._switchTab then self._switchTab(index, true) end
end

function Window:Notify(opts)
    if type(opts) == "string" then opts = { content = opts } end
    opts = opts or {}
    local ui = self.ScreenGui
    if not ui or not ui.Parent then return end

    local holder = ui:FindFirstChild("NotifHolder")
    if not holder then
        holder = new("Frame", {
            Name = "NotifHolder", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16),
            Size = UDim2.new(0, 300, 1, -32), BackgroundTransparency = 1, ZIndex = 500,
        }, ui)
        new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }, holder)
    end

    local kind = string.lower(tostring(opts.type or "info"))
    local colors = { info = Theme.accent, success = Theme.green, warning = Theme.amber, error = Theme.red }
    local glyphs = { info = "i", success = "✓", warning = "!", error = "×" }
    local col = colors[kind] or colors.info
    local glyph = glyphs[kind] or glyphs.info
    local title = tostring(opts.title or (kind:sub(1, 1):upper() .. kind:sub(2)))
    local content = tostring(opts.content or opts.description or "Notification")
    local dur = tonumber(opts.duration) or 4

    local bodyW = 300 - 54 - 30
    local okSz, sz = pcall(function() return TextService:GetTextSize(content, 12, FONT, Vector2.new(bodyW, 1000)) end)
    local bodyH = okSz and sz.Y or 28
    local cardH = math.max(62, 36 + bodyH + 14)

    self._notifN += 1
    local slot = new("Frame", {
        Size = UDim2.new(1, 0, 0, cardH), BackgroundTransparency = 1, LayoutOrder = self._notifN,
    }, holder)
    local card = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), Position = UDim2.new(1.15, 0, 0, 0), BackgroundColor3 = Theme.card,
        BorderSizePixel = 0, GroupTransparency = 1,
    }, slot)
    corner(card, 12)
    stroke(card, col, 1, 0.55)

    local iconBg = new("Frame", {
        Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(14, 12), BackgroundColor3 = col,
        BackgroundTransparency = 0.82, BorderSizePixel = 0,
    }, card)
    corner(iconBg, 999)
    label(iconBg, glyph, 15, col, { Font = FONT_BOLD, Size = UDim2.fromScale(1, 1), TextXAlignment = CENTER })
    label(card, title, 13, col, {
        Font = FONT_BOLD, Position = UDim2.fromOffset(54, 10), Size = UDim2.new(1, -86, 0, 18),
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    label(card, content, 12, Theme.text, {
        Position = UDim2.fromOffset(54, 30), Size = UDim2.new(1, -70, 0, bodyH),
        TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
    })
    local bar = new("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = col, BorderSizePixel = 0,
    }, card)

    local closed = false
    local function dismiss()
        if closed then return end
        closed = true
        local idx = table.find(self._notifs, slot); if idx then table.remove(self._notifs, idx) end
        tw(card, 0.3, { Position = UDim2.new(1.15, 0, 0, 0), GroupTransparency = 1 }, ES.Quint, ED.In)
        task.delay(0.22, function()
            if not slot.Parent then return end
            tw(slot, 0.25, { Size = UDim2.new(1, 0, 0, 0) }, ES.Quint)
            task.delay(0.3, function() if slot.Parent then slot:Destroy() end end)
        end)
    end

    local closeBtn = new("TextButton", {
        Text = "×", Font = FONT_BOLD, TextSize = 16, TextColor3 = Theme.muted, AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, AutoButtonColor = false,
    }, card)
    local cst = { hover = false, down = false }
    interact(closeBtn, cst, function() tw(closeBtn, 0.15, { TextColor3 = cst.hover and Theme.text or Theme.muted }) end)
    closeBtn.MouseButton1Click:Connect(dismiss)

    table.insert(self._notifs, slot)
    while #self._notifs > 5 do
        local oldest = table.remove(self._notifs, 1)
        if oldest and oldest.Parent then oldest:Destroy() end
    end

    tw(card, 0.5, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, ES.Quint)
    if dur > 0 then
        tw(bar, dur, { Size = UDim2.new(0, 0, 0, 3) }, ES.Linear, ED.In)
        task.delay(dur, dismiss)
    else
        bar.Visible = false
    end
    return card
end

