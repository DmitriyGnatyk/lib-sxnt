-- InfoRow: «назва … значення», клік копіює (copyValue або value)
function SubTab:AddInfoRow(opts)
    opts = opts or {}
    local win = self._window
    local value = tostring(opts.value or "")
    local copyable = opts.copy ~= false
    local host, hostStroke = makeHost(self._container, 40, false, self._LO(), true)
    local lbl = label(host, opts.name or (opts.key and T(opts.key)) or "Info", 12, Theme.muted, {
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.4, -14, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    regText(win, lbl, opts.key)
    local valLbl = label(host, value, 13, opts.color or Theme.text, {
        _font = "b", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0),
        Size = UDim2.new(0.6, -14, 1, 0), TextXAlignment = RIGHT, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local dot = new("Frame", {
        Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = opts.dot or Theme.green,
        BorderSizePixel = 0, Visible = opts.dot ~= nil,
    }, host)
    corner(dot, 999)
    local dotPulse
    local function syncPulse()
        if dot.Visible and not dotPulse then
            dotPulse = loopTween(dot, 1.1, { BackgroundTransparency = 0.55 })
            if win._addDecor then win._addDecor(dotPulse) end
        end
    end
    syncPulse()
    local customColor = opts.color
    local function placeDot()
        dot.Position = UDim2.new(1, -(14 + valLbl.TextBounds.X + 10), 0.5, 0)
    end
    valLbl:GetPropertyChangedSignal("TextBounds"):Connect(placeDot)
    placeDot()

    local state = { hover = false, down = false }
    interact(host, state, function(a) if copyable then styleHost(host, hostStroke, false, state, a) end end)
    host.InputBegan:Connect(function(i)
        if copyable and isPress(i) then ripple(host, inputScreenPos(i), Theme.accent, win._scale(), 10) end
    end)
    host.MouseButton1Click:Connect(function()
        if not copyable then return end
        local cv = opts.copyValue
        if type(cv) == "function" then local ok, r = pcall(cv); cv = ok and r or nil end
        cv = tostring(cv or value)
        if copyText(cv) then
            win:Notify({ title = T("copied"), content = cv:sub(1, 48), type = "success", duration = 2 })
        else
            win:Notify({ title = T("no_clipboard"), type = "warning", duration = 2.5 })
        end
    end)
    win._onTheme(function()
        lbl.TextColor3 = Theme.muted
        valLbl.TextColor3 = customColor or Theme.text
    end)

    local api = {}
    function api.Get() return value end
    function api.Set(_, v, color)
        value = tostring(v or ""); valLbl.Text = value
        if color then customColor = color; valLbl.TextColor3 = color end
    end
    function api.SetColor(_, c) customColor = c; valLbl.TextColor3 = c or Theme.text end
    function api.SetDot(_, c)
        if c then dot.BackgroundColor3 = c; dot.Visible = true else dot.Visible = false end
        syncPulse(); placeDot()
    end
    registerSearch(self, host, function() return lbl.Text .. " " .. value end)
    return host, api
end

