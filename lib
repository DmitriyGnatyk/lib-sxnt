    local function switchTab(index, animate)
        if index == W._activeTab or not W._tabWraps[index] then return end
        local prev = W._activeTab
        W._activeTab = index
        if W._currentExpanded then pcall(W._currentExpanded) end
        for i, wrap in ipairs(W._tabWraps) do
            if i ~= index then wrap.Visible = false; W._tabFrames[i].Visible = false end
        end
        local wrap = W._tabWraps[index]
        wrap.Visible = true; W._tabFrames[index].Visible = true
        if animate ~= false and prev ~= 0 then
            local dir = (index > prev) and 1 or -1
            wrap.GroupTransparency = 1
            wrap.Position = UDim2.fromOffset(0, 16 * dir)
            tw(wrap, 0.35, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, ES.Quint)
        else
            wrap.GroupTransparency = 0; wrap.Position = UDim2.fromOffset(0, 0)
        end
        moveIndicator(index, prev ~= 0 and animate ~= false)
        renderAllTabs()
    end
