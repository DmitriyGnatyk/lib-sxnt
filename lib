        end
    end

    WindowObj._createTab = createTab
    WindowObj._menuKeyGetter = function() return WindowObj._menuKey end
    WindowObj._menuKeySetter = function(k) WindowObj._menuKey = k end

    table.insert(Library._windows, WindowObj)
    return WindowObj
end

